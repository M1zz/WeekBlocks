            "state" : "translated",
            "value" : "Si finisce in cinque minuti?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina em até cinco minutos?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заканчивается за пять минут?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je to hotové do pěti minut?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliver den færdig inden for fem minutter?"
          }
        },
        "el" : {
          "stringUnit" : {
