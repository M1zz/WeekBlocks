            "value" : "没有能在 5 分钟空档里做的步骤"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有能在 5 分鐘空檔裡做的步驟"
          }
        },
        "de" : {
          "stringUnit" : {
