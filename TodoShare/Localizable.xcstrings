    "끊기면 다시 올라와야 합니다. 방해 없는 시간에 두세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you're interrupted you have to climb back in. Put it in undisturbed time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦被打断，就得重新找回状态。请排在不受打扰的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦被打斷，就得重新爬回狀態。請排在不受打擾的時間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirst du unterbrochen, musst du dich wieder hineinarbeiten. Plane es in ungestörte Zeit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断されると、また集中し直す必要があります。邪魔の入らない時間に置きましょう。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te interrumpen, tienes que volver a coger el ritmo. Ponlo en un tiempo sin interrupciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous êtes interrompu, il faut s’y remettre. Placez-le dans un temps sans dérangement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vieni interrotto devi riprendere il filo. Mettila in un momento senza disturbi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se for interrompido, você terá que subir tudo de novo. Coloque num horário sem interrupções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если прервут, придётся заново входить в работу. Поставьте в спокойное время."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když vás někdo vyruší, musíte se do toho znovu dostávat. Zařaďte to do nerušeného času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliver du afbrudt, skal du kæmpe dig ind i det igen. Læg det i uforstyrret tid."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν σε διακόψουν, πρέπει να ξαναμπείς στο κλίμα. Βάλ’ το σε χρόνο χωρίς ενοχλήσεις."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos sinut keskeytetään, joudut palaamaan alkuun. Sijoita tämä häiriöttömään aikaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau terganggu, Anda harus memanaskan diri lagi. Taruh di waktu yang tidak terganggu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir du avbrutt, må du jobbe deg inn i det igjen. Legg det i uforstyrret tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word je onderbroken, dan moet je er weer helemaal in komen. Zet het in ongestoorde tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli ktoś przerwie, trzeba będzie znowu się wdrożyć. Umieść to w niezakłóconym czasie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir du avbruten måste du ta dig in i det igen. Lägg det i ostörd tid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าถูกขัดจังหวะ ต้องเริ่มปีนกลับใหม่ วางไว้ในเวลาที่ไม่มีใครรบกวน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölünürseniz yeniden içine girmeniz gerekir. Rahatsız edilmeyeceğiniz bir zamana koyun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bị ngắt quãng, bạn phải lấy lại nhịp từ đầu. Hãy đặt vào khoảng thời gian không bị làm phiền."
          }
        }
      }
    },
    "끝나지 않은 일은 잔여물이 되어 그다음 덩어리 시간까지 갉아먹습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unfinished work leaves residue that eats into the next chunk of time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没做完的事会留下残余，连下一段大块时间也被吞掉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒做完的事會留下殘餘，連下一段大塊時間也被吃掉。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unerledigte Arbeit hinterlässt Reste, die auch noch die nächste Fokuszeit auffressen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終わっていない作業は残りかすとなって、次のまとまった時間まで削っていきます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que queda a medias deja un residuo que se come el siguiente tramo de tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un travail inachevé laisse des restes qui grignotent la plage de concentration suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro lasciato a metà lascia residui che si mangiano il tempo di concentrazione successivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalho inacabado deixa resíduos que consomem o próximo período contínuo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незаконченное дело оставляет хвост, который съедает следующий цельный отрезок."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedokončená práce zanechává zbytky, které ukusují i z dalšího souvislého času."
          }
        },
        "da" : {
