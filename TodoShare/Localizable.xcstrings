    "%@짜리입니다. 한 자리에서도 안 닫힙니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's %@ long. It won't close even in one sitting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时长 %@，一次坐下来也做不完。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時長 %@，一次坐下來也做不完。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es dauert %@. Selbst an einem Stück wird es nicht fertig."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@かかります。ひと続きでも閉じられません。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dura %@. No se cierra ni en una sola sentada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela dure %@. Même d’une seule traite, ce ne sera pas bouclé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dura %@. Non si chiude nemmeno in una sola seduta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dura %@. Não se fecha nem numa sentada só."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длится %@. Не закроется даже за один подход."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvá %@. Nedokončí se ani na jeden zátah."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tager %@. Den lukker ikke engang i ét stræk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαρκεί %@. Δεν κλείνει ούτε με ένα κάθισμα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesto %@. Se ei valmistu edes yhdellä istumalla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durasinya %@. Sekali duduk pun tidak akan tuntas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tar %@. Den blir ikke ferdig selv i én økt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het duurt %@. Zelfs in één zit is het niet af te ronden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwa %@. Nie zamknie się nawet za jednym posiedzeniem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tar %@. Den blir inte klar ens i ett enda pass."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เวลา %@ แม้นั่งทำรวดเดียวก็ไม่จบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süre %@. Tek oturuşta bile kapanmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dài %@. Ngồi một mạch cũng không khép lại được."
          }
        }
      }
    },
    "%lld개 단계가 2시간을 넘습니다. 끝이 닫히는 크기로 더 쪼개세요. 하다 만 단계는 다음 시간까지 주의를 끌고 갑니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld steps run over two hours. Split them down to a size that closes. A step left half-done drags your attention into the next hour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 个步骤超过两小时。请拆分到能收尾的大小。做到一半的步骤，会把注意力拖进下一个小时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 個步驟超過兩小時。請拆分到能收尾的大小。做到一半的步驟，會把注意力拖進下一個小時。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Schritte dauern länger als zwei Stunden. Teile sie in Größen auf, die sich abschließen lassen. Ein halb erledigter Schritt zieht deine Aufmerksamkeit in die nächste Stunde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld個のステップが2時間を超えています。締めくくれる大きさまで分けましょう。やりかけのステップは、次の時間まで注意を引きずります。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld pasos duran más de dos horas. Divídelos hasta un tamaño que se pueda cerrar. Un paso a medias arrastra tu atención a la hora siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld étapes dépassent deux heures. Découpez-les jusqu’à une taille qui se boucle. Une étape laissée à moitié entraîne votre attention dans l’heure suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld fasi superano le due ore. Suddividile finché non hanno una dimensione che si chiude. Una fase lasciata a metà si trascina la tua attenzione nell’ora successiva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld etapas passam de duas horas. Divida-as até um tamanho que se feche. Uma etapa deixada pela metade arrasta sua atenção para a hora seguinte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шагов длиннее двух часов: %lld. Дробите их до размера, который закрывается. Недоделанный шаг тянет внимание и в следующий час."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroky delší než dvě hodiny: %lld. Rozdělte je na velikost, kterou jde dokončit. Napůl hotový krok vám odvádí pozornost i do další hodiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld trin varer over to timer. Del dem op, til de kan lukkes. Et halvfærdigt trin trækker din opmærksomhed med ind i den næste time."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld βήματα ξεπερνούν τις δύο ώρες. Χώρισέ τα σε μέγεθος που κλείνει. Ένα βήμα που μένει στη μέση τραβάει την προσοχή σου και στην επόμενη ώρα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld vaihetta kestää yli kaksi tuntia. Pilko ne niin pieniksi, että ne valmistuvat. Kesken jäänyt vaihe vetää huomiosi mukanaan seuraavaan tuntiin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld langkah lebih dari dua jam. Pecah sampai ukurannya bisa tuntas. Langkah yang setengah jadi menyeret perhatian Anda ke jam berikutnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld trinn varer over to timer. Del dem opp til en størrelse som kan avsluttes. Et halvferdig trinn drar oppmerksomheten din med inn i neste time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld stappen duren langer dan twee uur. Splits ze op tot een omvang die je kunt afronden. Een half afgemaakte stap trekt je aandacht mee naar het volgende uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroki dłuższe niż dwie godziny: %lld. Podziel je do rozmiaru, który się domyka. Krok zostawiony w połowie ciągnie uwagę do następnej godziny."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld steg tar mer än två timmar. Dela upp dem tills de går att avsluta. Ett halvfärdigt steg drar med sig din uppmärksamhet in i nästa timme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มี %lld ขั้นตอนที่ยาวเกินสองชั่วโมง แบ่งให้เล็กลงจนจบได้ ขั้นตอนที่ทำค้างไว้จะดึงความสนใจของคุณไปจนถึงชั่วโมงถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld adım iki saati aşıyor. Kapanabilecek bir boyuta inene kadar bölün. Yarım kalan bir adım dikkatinizi bir sonraki saate de taşır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có %lld bước dài hơn hai tiếng. Hãy chia nhỏ đến mức khép lại được. Một bước làm dở sẽ kéo sự chú ý của bạn sang giờ tiếp theo."
          }
        }
      }
    },
