    "안 정한 것이 먼저 막고 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something undecided is blocking it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有尚未决定的事挡在前面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有尚未決定的事擋在前面。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas Unentschiedenes blockiert es."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決まっていないことが先に妨げています。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo sin decidir lo está bloqueando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose d’indécis bloque le chemin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa di non deciso la blocca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo indefinido está bloqueando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мешает что-то нерешённое."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokuje to něco nerozhodnutého."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noget uafklaret blokerer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτι που δεν έχει αποφασιστεί το μπλοκάρει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokin päättämätön asia estää sen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada yang belum diputuskan dan menghalanginya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe uavklart blokkerer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is nog iets onbeslist dat het blokkeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokuje to coś nierozstrzygniętego."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något obestämt blockerar den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีเรื่องที่ยังไม่ได้ตัดสินใจขวางอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kararlaştırılmamış bir şey önünü tıkıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có điều chưa quyết định đang chặn việc này."
          }
        }
      }
    },
    "안 정해진 게 남아 있으면 아래 단계가 전부 안 열립니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While anything is undecided, none of the steps below will open."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要还有未决定的事，下方的步骤都不会开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要還有未決定的事，下方的步驟都不會開啟。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange etwas unentschieden ist, öffnet sich keiner der Schritte unten."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決まっていないことが残っていると、下のステップはすべて開きません。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras quede algo sin decidir, no se abrirá ninguno de los pasos de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant qu’il reste quelque chose d’indécis, aucune des étapes ci-dessous ne s’ouvrira."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finché resta qualcosa da decidere, nessuna delle fasi sotto si apre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto algo estiver indefinido, nenhuma das etapas abaixo será liberada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока что-то не решено, ни один шаг ниже не откроется."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokud je něco nerozhodnuté, žádný z kroků níže se neotevře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så længe noget er uafklaret, åbner ingen af trinnene nedenfor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο κάτι μένει αναποφάσιστο, κανένα από τα παρακάτω βήματα δεν ανοίγει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niin kauan kuin jokin on päättämättä, mikään alla olevista vaiheista ei aukea."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selama ada yang belum diputuskan, langkah-langkah di bawah tidak akan terbuka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så lenge noe er uavklart, åpner ingen av trinnene nedenfor seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zolang er iets onbeslist is, gaat geen van de stappen hieronder open."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopóki coś jest nierozstrzygnięte, żaden krok poniżej się nie otworzy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så länge något är obestämt öppnas inget av stegen nedan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตราบใดที่ยังมีเรื่องที่ไม่ได้ตัดสินใจ ขั้นตอนด้านล่างจะยังไม่เปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kararlaştırılmamış bir şey kaldıkça aşağıdaki adımların hiçbiri açılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi còn điều chưa quyết định, các bước bên dưới sẽ không mở được."
          }
        }
      }
    },
    "앞에서 막고 있는 것이 안 보입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing seems to be blocking it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看不到挡在前面的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看不到擋在前面的事。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es scheint nichts im Weg zu stehen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前で妨げているものは見当たりません。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No parece que nada lo esté bloqueando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne semble bloquer le chemin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sembra esserci niente che la blocchi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada parece estar bloqueando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, ничто не мешает."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá se, že tomu nic nebrání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet ser ud til at blokere."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τίποτα δεν φαίνεται να το μπλοκάρει."
