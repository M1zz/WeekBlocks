    "끝이 닫히는 크기로 더 쪼개세요. 하다 만 단계는 다음 시간까지 주의를 끌고 갑니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Split it down to a size that closes. A step left half-done drags your attention into the next hour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再拆分到能收尾的大小。做到一半的步骤，会把注意力一路拖到下一段时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再拆分到能收尾的大小。做到一半的步驟，會把注意力一路拖到下一段時間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile es in Größen auf, die sich abschließen lassen. Ein halb erledigter Schritt zieht deine Aufmerksamkeit in die nächste Stunde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "締めくくれる大きさまで分けましょう。やりかけのステップは、次の時間まで注意を引きずります。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divídelo hasta un tamaño que se pueda cerrar. Un paso a medias arrastra tu atención a la hora siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découpez-la jusqu’à une taille qui se boucle. Une étape laissée à moitié entraîne votre attention dans l’heure suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suddividila finché non ha una dimensione che si chiude. Una fase lasciata a metà si trascina la tua attenzione nell’ora successiva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divida até um tamanho que se feche. Uma etapa deixada pela metade arrasta sua atenção para a hora seguinte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дробите до размера, который закрывается. Недоделанный шаг тянет внимание и в следующий час."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdělte to na velikost, kterou jde dokončit. Napůl hotový krok vám odvádí pozornost i do další hodiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del det op, til det kan lukkes. Et halvfærdigt trin trækker din opmærksomhed med ind i den næste time."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χώρισέ το σε μέγεθος που κλείνει. Ένα βήμα που μένει στη μέση τραβάει την προσοχή σου και στην επόμενη ώρα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilko se niin pieneksi, että se valmistuu. Kesken jäänyt vaihe vetää huomiosi mukanaan seuraavaan tuntiin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pecah sampai ukurannya bisa tuntas. Langkah yang setengah jadi menyeret perhatian Anda ke jam berikutnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del det opp til en størrelse som kan avsluttes. Et halvferdig trinn drar oppmerksomheten din med inn i neste time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Splits het op tot een omvang die je kunt afronden. Een half afgemaakte stap trekt je aandacht mee naar het volgende uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podziel do rozmiaru, który się domyka. Krok zostawiony w połowie ciągnie uwagę do następnej godziny."
