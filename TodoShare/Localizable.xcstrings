    "한 번에 못 끝내는 크기입니다. 끝이 닫히도록 더 쪼개지 않으면 '하다 만 상태'가 다음 시간까지 따라옵니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is too big to finish in one go. Unless you split it down to something that closes, the half-done state follows you into the next hour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个大小无法一次完成。如果不拆分到能收尾的程度，“做到一半”的状态会一直跟到下一个时段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個大小無法一次完成。若不拆分到能收尾的程度，「做到一半」的狀態會一路跟到下一個時段。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist zu groß, um es in einem Rutsch zu erledigen. Wenn du es nicht in abschließbare Teile zerlegst, verfolgt dich der halbfertige Zustand bis in die nächste Stunde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度では終わらない大きさです。締めくくれるまで分けないと、「やりかけの状態」が次の時間までついてきます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es demasiado grande para terminarlo de una vez. Si no lo divides hasta algo que se pueda cerrar, lo que quede a medias te seguirá a la hora siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est trop gros pour être terminé d’une traite. Si vous ne le découpez pas en morceaux qui se bouclent, l’état « à moitié fait » vous suivra dans l’heure suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È troppo grande per finirla in una volta. Se non la suddividi in qualcosa che si chiude, lo stato di lavoro a metà ti segue nell’ora successiva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é grande demais para terminar de uma vez. Se você não dividir até algo que se feche, o estado de meio feito vai junto para a hora seguinte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это слишком много, чтобы закончить за раз. Если не разбить до размера, который закрывается, недоделанное потянется за вами в следующий час."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle je příliš velké na to, abyste to dokončili najednou. Pokud to nerozdělíte na části, které jde uzavřít, napůl hotový stav vás bude pronásledovat i do další hodiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er for stor til at blive færdig i ét hug. Medmindre du deler den op i noget, der kan lukkes, følger den halvfærdige tilstand dig ind i den næste time."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό είναι πολύ μεγάλο για να τελειώσει με μία φορά. Αν δεν το χωρίσεις σε κάτι που κλείνει, η μισοτελειωμένη κατάσταση σε ακολουθεί και στην επόμενη ώρα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on liian suuri valmistumaan yhdellä kertaa. Ellet pilko sitä valmistuvaksi kokonaisuudeksi, keskeneräisyys seuraa sinua seuraavaan tuntiin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini terlalu besar untuk selesai sekali jalan. Kecuali dipecah sampai bisa tuntas, keadaan setengah jadi akan mengikuti Anda ke jam berikutnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne er for stor til å bli ferdig i én omgang. Med mindre du deler den opp i noe som kan avsluttes, følger den halvferdige tilstanden deg inn i neste time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is te groot om in één keer af te ronden. Splits je het niet op tot iets wat je kunt afronden, dan neem je de half-af-toestand mee naar het volgende uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To za dużo, by skończyć za jednym razem. Jeśli nie podzielisz tego do rozmiaru, który się domyka, stan „zrobione w połowie” pójdzie za Tobą do następnej godziny."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här är för stort för att bli klart i ett svep. Om du inte delar upp det i något som går att avsluta följer det halvfärdiga med dig in i nästa timme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานนี้ใหญ่เกินกว่าจะจบในครั้งเดียว ถ้าไม่แบ่งให้เล็กจนจบได้ สภาพทำค้างจะตามคุณไปถึงชั่วโมงถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, tek seferde bitmeyecek kadar büyük. Kapanabilen parçalara bölmezseniz yarım kalmışlık hissi sizi bir sonraki saate kadar izler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc này quá lớn để làm xong trong một lần. Nếu không chia nhỏ đến mức khép lại được, trạng thái làm dở sẽ theo bạn sang giờ tiếp theo."
          }
        }
      }
    },
    "할 것이 정해져 있어 바로 손이 갑니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What to do is settled, so your hands go straight to it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要做什么已经确定，马上就能动手。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要做什麼已經確定，馬上就能動手。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was zu tun ist, steht fest – du kannst direkt loslegen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やることが決まっているので、すぐ手が動きます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que hay que hacer está decidido, así que te pones directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qu’il faut faire est arrêté, vous pouvez vous y mettre directement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa fare è già deciso, quindi ti ci metti subito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que fazer já está definido, então você põe a mão na massa direto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что делать — уже решено, так что руки сами берутся за дело."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co dělat, je jasné, takže se do toho můžete rovnou pustit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er afklaret, hvad der skal gøres, så du går lige i gang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τι θα κάνεις είναι ξεκάθαρο, οπότε τα χέρια σου πάνε κατευθείαν σε αυτό."
