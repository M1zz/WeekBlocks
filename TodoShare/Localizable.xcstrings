          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouvez-vous commencer sans temps de démarrage ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesci a iniziare senza tempo di avvio?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dá para começar sem aquecer?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно начать без раскачки?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokážete začít bez rozjezdu?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan du gå i gang uden opvarmning?"
          }
        },
        "el" : {
          "stringUnit" : {
