    "뭘 할지 고르는 동안 조각이 끝납니다. 결정은 덩어리에서 하고, 정해진 것만 조각 단계로 보내세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fragment ends while you're still choosing. Decide in a chunk, and send only the settled work to fragment steps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还在挑要做什么，碎片时间就结束了。在大块时间里做决定，只把已确定的事交给碎片步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還在挑要做什麼，碎片時間就結束了。在大塊時間裡做決定，只把已確定的事送到碎片步驟。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Splitter ist vorbei, während du noch überlegst. Entscheide in Fokuszeit und gib nur festgelegte Arbeit an Splitter-Schritte weiter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何をするか選んでいるうちに、かけらが終わってしまいます。決めるのはまとまった時間で行い、決まったものだけをかけらのステップに回しましょう。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fragmento se acaba mientras aún estás eligiendo. Decide en un tramo y manda a los pasos de fragmento solo el trabajo ya decidido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fragment se termine pendant que vous choisissez encore. Décidez pendant une plage de concentration, et ne confiez aux étapes en fragment que le travail déjà arrêté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il frammento finisce mentre stai ancora scegliendo. Decidi nel tempo di concentrazione e manda alle fasi da frammento solo il lavoro già deciso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fragmento acaba enquanto você ainda escolhe. Decida num período contínuo e mande para as etapas de fragmento só o trabalho já definido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кусочек закончится, пока вы выбираете. Решайте в цельном отрезке, а в шаги-кусочки отправляйте только то, что уже решено."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Střípek skončí, zatímco ještě vybíráte. Rozhodujte v souvislém čase a do střípků posílejte jen ujasněnou práci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidslommen slutter, mens du stadig vælger. Beslut i en fokusblok, og send kun det afklarede arbejde videre til tidslommetrin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κομμάτι τελειώνει ενώ ακόμη διαλέγεις. Αποφάσισε σε ένα συνεχές διάστημα και στείλε στα βήματα-κομμάτια μόνο τη δουλειά που έχει ξεκαθαρίσει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pätkä loppuu, kun vielä valitset. Päätä jaksossa ja lähetä pätkävaiheisiin vain valmiiksi päätetty työ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kepingannya habis selagi Anda masih memilih. Putuskan di sesi fokus, dan kirim hanya pekerjaan yang sudah pasti ke langkah kepingan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidslommen er over mens du fortsatt velger. Bestem deg i en fokusblokk, og send bare det avklarte arbeidet videre til tidslommetrinn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het fragment is voorbij terwijl je nog aan het kiezen bent. Beslis in een brok en stuur alleen het vastgelegde werk naar fragmentstappen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okruch się kończy, zanim wybierzesz. Decyduj w ciągłym odcinku, a do kroków-okruchów wysyłaj tylko to, co już ustalone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ministeget tar slut medan du fortfarande väljer. Bestäm under fokustid och skicka bara det färdigbestämda arbetet till ministeg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชิ้นย่อยหมดไปขณะที่คุณยังเลือกอยู่ ตัดสินใจในช่วงเวลายาว แล้วส่งเฉพาะงานที่ลงตัวแล้วไปเป็นขั้นตอนชิ้นย่อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz daha seçerken parça biter. Kararı bir odak süresinde verin, parça adımlarına yalnızca netleşmiş işleri gönderin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mảnh thời gian hết trong lúc bạn còn đang chọn. Hãy quyết định trong một quãng, và chỉ chuyển phần việc đã rõ sang các bước mảnh."
          }
        }
      }
    },
