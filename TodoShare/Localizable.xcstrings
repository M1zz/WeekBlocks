        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekeminen on päätetty, joten kädet tarttuvat siihen suoraan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang dikerjakan sudah jelas, jadi tangan Anda langsung bergerak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er avklart hva som skal gjøres, så du går rett i gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je moet doen, staat vast, dus je kunt meteen aan de slag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomo, co robić, więc ręce same się do tego biorą."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är bestämt vad som ska göras, så du sätter igång direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้แล้วว่าต้องทำอะไร จึงลงมือได้ทันที"
