    "시간을 안 잡은 줄이라 조각에 들어갑니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No time is set on this line, so it fits in a fragment."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这一行没有设定时间，所以可以放进碎片时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這一行沒有設定時間，所以可以放進碎片時間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Zeile ist keine Zeit festgelegt, also passt sie in einen Splitter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間を決めていない行なので、かけらに収まります。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta línea no tiene tiempo fijado, así que cabe en un fragmento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune durée n’est fixée sur cette ligne, elle tient donc dans un fragment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa riga non ha una durata, quindi sta in un frammento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta linha não tem tempo definido, então cabe num fragmento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этой строке время не задано, поэтому она поместится в кусочек."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U tohoto řádku není nastavený čas, takže se vejde do střípku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke sat tid på denne linje, så den passer i en tidslomme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η γραμμή δεν έχει ορισμένο χρόνο, οπότε χωράει σε ένα κομμάτι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä rivillä ei ole aikaa, joten se mahtuu pätkään."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris ini tidak punya jam, jadi muat dalam kepingan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er ikke satt noen tid på denne linjen, så den passer i en tidslomme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op deze regel staat geen tijd, dus het past in een fragment."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta linijka nie ma ustalonego czasu, więc zmieści się w okruchu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raden har ingen tid angiven, så den ryms i ett ministeg."
          }
        },
