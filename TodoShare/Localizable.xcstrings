      }
    },
    "안 정한 것이 먼저 막고 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something undecided is blocking it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有尚未决定的事挡在前面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有尚未決定的事擋在前面。"
          }
        }
      }
    },
    "안 정해진 게 남아 있으면 아래 단계가 전부 안 열립니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While anything is undecided, none of the steps below will open."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要还有未决定的事，下方的步骤都不会开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要還有未決定的事，下方的步驟都不會開啟。"
          }
        }
      }
    },
    "앞에서 막고 있는 것이 안 보입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing seems to be blocking it."
          }
