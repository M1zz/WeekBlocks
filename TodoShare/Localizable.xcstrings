            "value" : "Τελειώνει μέσα σε πέντε λεπτά;"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valmistuuko se viidessä minuutissa?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selesai dalam lima menit?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir den ferdig innen fem minutter?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is het binnen vijf minuten klaar?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kończy się w pięć minut?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir det klart inom fem minuter?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำจนจบได้ภายในห้านาทีไหม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beş dakika içinde biter mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có xong trong năm phút không?"
          }
        }
      }
    },
    "5분이 생겼을 때 집을 단계가 없습니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
