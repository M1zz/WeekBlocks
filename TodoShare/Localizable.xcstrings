    "덩어리입니다. 지켜 둔 시간에 두세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a chunk. Put it in time you've protected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是大块。请排在你留出来的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是大塊。請排在你保留下來的時間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das braucht Fokuszeit. Plane es in Zeit, die du dir freigehalten hast."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まとまった時間向けです。確保した時間に置きましょう。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es un tramo. Ponlo en un tiempo que tengas protegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela demande une plage de concentration. Placez-le dans un temps protégé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo richiede tempo di concentrazione. Mettilo in un orario protetto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é um período contínuo. Coloque-o num horário protegido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это работа для цельного отрезка. Поставьте её в защищённое время."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle potřebuje souvislý čas. Zařaďte to do času, který máte chráněný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er en fokusblok. Læg den i tid, du har beskyttet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θέλει συνεχές διάστημα. Βάλ’ το σε χρόνο που έχεις προστατέψει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on jakso. Sijoita se aikaan, jonka olet suojannut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini sesi fokus. Taruh di waktu yang sudah Anda lindungi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er en fokusblokk. Legg den i tid du har skjermet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is een brok. Zet het in tijd die je hebt vrijgehouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zadanie na ciągły odcinek. Umieść je w chronionym czasie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här kräver fokustid. Lägg det i tid du har skyddat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานนี้ต้องใช้ช่วงเวลายาว วางไว้ในเวลาที่คุณกันไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bir odak süresi işi. Koruduğunuz bir zamana koyun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là một quãng. Hãy đặt vào khoảng thời gian bạn đã giữ riêng."
          }
        }
      }
    },
    "링크·자료를 펼쳐만 둡니다. 본 작업의 시동 비용을 여기서 미리 냅니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just open the links and files. You pay the real work's spin-up cost here, in advance."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要把链接和资料打开放着就好。先在这里付掉正式工作的热身成本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要把連結和資料打開放著就好。先在這裡付掉正式工作的暖機成本。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne nur die Links und Unterlagen. So zahlst du die Anlaufkosten der eigentlichen Arbeit schon vorab."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクや資料を開いておくだけ。本番の作業の準備コストを、ここで先に払っておきます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo abre los enlaces y archivos. Aquí pagas por adelantado el coste de arranque del trabajo de verdad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez seulement les liens et les documents. Vous payez ici, à l’avance, le coût de démarrage du vrai travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri solo link e file. Qui paghi in anticipo il costo di avvio del lavoro vero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só abra os links e arquivos. Você paga aqui, antecipadamente, o custo de aquecimento do trabalho de verdade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто откройте ссылки и файлы. Здесь вы заранее платите цену раскачки перед основной работой."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen otevřete odkazy a soubory. Náklady na rozjezd skutečné práce tak zaplatíte předem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn bare links og filer. Du betaler opstartsprisen for det rigtige arbejde her, på forhånd."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απλώς άνοιξε τους συνδέσμους και τα αρχεία. Έτσι πληρώνεις από πριν, εδώ, το κόστος εκκίνησης της κανονικής δουλειάς."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa vain linkit ja tiedostot. Maksat varsinaisen työn käynnistyskustannuksen tässä etukäteen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukup buka tautan dan berkasnya. Biaya pemanasan pekerjaan utama dibayar di sini, lebih awal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare åpne lenkene og filene. Du betaler oppstartskostnaden for det egentlige arbeidet her, på forhånd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open alleen de links en bestanden. Je betaalt hier alvast de opstartkosten van het echte werk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko otwórz linki i pliki. Tu z góry płacisz koszt rozruchu właściwej pracy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna bara länkarna och filerna. Här betalar du i förväg startkostnaden för det riktiga arbetet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แค่เปิดลิงก์และไฟล์ไว้ จ่ายต้นทุนการวอร์มเครื่องของงานจริงไว้ล่วงหน้าตรงนี้"
          }
        },
        "tr" : {
