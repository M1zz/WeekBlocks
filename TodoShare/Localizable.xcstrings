    "시동 없이 바로 시작되나요?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can you start without spinning up?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用预热就能直接开始吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用暖機就能直接開始嗎？"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannst du ohne Anlaufen loslegen?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備運動なしですぐ始められますか？"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Puedes empezar sin calentar motores?"
          }
        },
