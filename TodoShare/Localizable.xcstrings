    "짧은 덩어리입니다. 앉아야 하지만 한 자리에서 끝납니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a short chunk. You have to sit down, but it finishes in one sitting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是短时大块。需要坐下来做，但一次就能完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是短時大塊。需要坐下來做，但一次就能完成。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist kurze Fokuszeit. Du musst dich hinsetzen, aber es ist an einem Stück erledigt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短いまとまりです。腰を据える必要はありますが、ひと続きで終わります。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es un tramo corto. Tienes que sentarte, pero se termina de una sentada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est une courte plage de concentration. Il faut s’asseoir, mais cela se termine d’une traite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede poco tempo di concentrazione. Devi sederti, ma si chiude in una sola seduta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é um período contínuo curto. Você precisa se sentar, mas termina numa sentada só."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это короткий отрезок. Нужно сесть за дело, но закончится за один подход."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle je krátký souvislý čas. Musíte se k tomu posadit, ale dokončíte to na jeden zátah."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er en kort fokusblok. Du skal sætte dig ned til den, men den bliver færdig i ét stræk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό είναι σύντομο συνεχές διάστημα. Πρέπει να καθίσεις, αλλά τελειώνει με ένα κάθισμα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on lyhyt jakso. Sinun on istuttava alas, mutta se valmistuu yhdellä istumalla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini sesi fokus singkat. Anda harus duduk khusus, tapi selesai sekali duduk."
