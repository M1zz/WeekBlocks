    "'보내기·발행하기·제출하기'처럼 끝을 닫는 단계를 마지막에 두세요. 90% 끝난 일의 마지막 10%는 조각의 가장 좋은 용도이고, 닫아두면 그 뒤의 덩어리 시간까지 깨끗해집니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End with a step that closes it — send, publish, submit. The last 10% of a job that's 90% done is the best possible use of a fragment, and closing it leaves the chunks that follow clean."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后放一个收尾的步骤，比如发送、发布、提交。完成 90% 的工作所剩的最后 10%，是碎片时间最好的用途；收好尾，之后的大块时间也会更干净。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後放一個收尾的步驟，例如寄出、發布、提交。完成 90% 的工作所剩的最後 10%，是碎片時間最好的用途；收好尾，之後的大塊時間也會更乾淨。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende es mit einem Schritt, der den Abschluss bildet – senden, veröffentlichen, einreichen. Die letzten 10 % einer Arbeit, die zu 90 % erledigt ist, sind die beste Verwendung für einen Splitter, und wer abschließt, hält die folgende Fokuszeit frei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「送信・公開・提出」のように、締めくくるステップを最後に置きましょう。9割終わった仕事の残り1割は、かけらの最高の使い道です。閉じておけば、その後のまとまった時間もすっきりします。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina con un paso que lo cierre: enviar, publicar, entregar. El último 10% de un trabajo hecho al 90% es el mejor uso posible de un fragmento, y cerrarlo deja limpios los tramos que vienen después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez par une étape qui clôt le travail : envoyer, publier, soumettre. Les derniers 10 % d’un travail fini à 90 % sont le meilleur usage d’un fragment, et le boucler libère les plages de concentration qui suivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concludi con una fase che chiude il lavoro: inviare, pubblicare, consegnare. L’ultimo 10% di un lavoro fatto al 90% è l’uso migliore di un frammento, e chiuderlo lascia pulito il tempo di concentrazione che segue."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine com uma etapa que feche o trabalho — enviar, publicar, entregar. Os últimos 10% de algo 90% pronto são o melhor uso possível de um fragmento, e fechá-lo deixa limpos os períodos contínuos seguintes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закончите шагом, который закрывает дело: отправить, опубликовать, сдать. Последние 10% почти готовой работы — лучшее, на что можно потратить кусочек, а закрытое дело освобождает следующие отрезки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakončete to krokem, který věc uzavře – odeslat, zveřejnit, podat. Posledních 10 % práce, která je z 90 % hotová, je nejlepší možné využití střípku, a když ji uzavřete, zůstane následující souvislý čas čistý."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slut med et trin, der lukker opgaven – send, udgiv, indsend. De sidste 10 % af en opgave, der er 90 % færdig, er den bedst tænkelige brug af en tidslomme, og når den er lukket, er de næste fokusblokke rene."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε στο τέλος ένα βήμα που το κλείνει: αποστολή, δημοσίευση, υποβολή. Το τελευταίο 10% μιας δουλειάς που έχει γίνει κατά 90% είναι η καλύτερη χρήση ενός κομματιού, και όταν την κλείνεις, τα συνεχή διαστήματα που ακολουθούν μένουν καθαρά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päätä vaiheeseen, joka saa asian valmiiksi: lähetä, julkaise, palauta. Työn viimeinen 10 %, kun 90 % on tehty, on paras mahdollinen käyttö pätkälle, ja kun asia on valmis, seuraavat jaksot pysyvät puhtaina."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akhiri dengan langkah yang menuntaskannya — kirim, terbitkan, serahkan. 10% terakhir dari pekerjaan yang sudah 90% adalah pemakaian kepingan terbaik, dan menuntaskannya membuat sesi fokus berikutnya tetap bersih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt med et trinn som lukker oppgaven – send, publiser, lever. De siste 10 % av en jobb som er 90 % ferdig, er den beste bruken av en tidslomme du kan få, og når den er lukket, er fokusblokkene etterpå ryddige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit af met een stap die het werk afrondt — versturen, publiceren, indienen. De laatste 10% van een klus die voor 90% af is, is de beste besteding van een fragment, en wie het afrondt, houdt de brokken daarna schoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ krokiem, który domyka sprawę: wyślij, opublikuj, złóż. Ostatnie 10% pracy zrobionej w 90% to najlepsze, na co można wydać okruch, a domknięta sprawa zostawia czyste kolejne odcinki."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta med ett steg som stänger arbetet – skicka, publicera, lämna in. De sista 10 % av ett jobb som är klart till 90 % är det bästa sättet att använda ett ministeg, och när det är avslutat blir fokustiden efteråt ren."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดท้ายด้วยขั้นตอนที่ทำให้งานจบ เช่น ส่ง เผยแพร่ ยื่น งาน 10% สุดท้ายของงานที่เสร็จไปแล้ว 90% คือการใช้ชิ้นย่อยที่คุ้มที่สุด และเมื่อปิดงานได้ ช่วงเวลายาวถัดไปก็จะโล่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son adım işi kapatan bir adım olsun: göndermek, yayımlamak, teslim etmek. Yüzde 90’ı bitmiş bir işin son yüzde 10’u, bir parçayı kullanmanın en iyi yoludur; işi kapatmak sonraki odak sürelerini de temiz bırakır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kết thúc bằng một bước khép việc lại: gửi, đăng, nộp. 10% cuối của một việc đã xong 90% là cách dùng mảnh thời gian tốt nhất, và khép nó lại giúp các quãng phía sau được gọn gàng."
          }
        }
      }
    },
    "5분 안에 끝까지 가나요?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does it finish within five minutes?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 分钟内能做完吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 分鐘內能做完嗎？"
          }
        },
