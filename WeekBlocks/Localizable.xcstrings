          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm sao để ngăn điều đó, hoặc phục hồi nhanh?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
