    "공휴일·생일·휴가처럼 그날이 어떤 날인지 알려 주는 배경입니다. 무지개 칸을 차지하지 않고, 했는지 묻지 않습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozadí, které říká, jaký je to den – svátek, narozeniny nebo dovolená. Nezabírá místo v duze a neodškrtává se."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baggrund, der fortæller, hvad det er for en dag – en helligdag, fødselsdag eller ferie. Den optager ikke en plads i regnbuen og skal ikke krydses af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrund, der zeigt, was für ein Tag es ist – Feiertag, Geburtstag oder Urlaub. Belegt keinen Regenbogenplatz und wird nicht abgehakt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φόντο που λέει τι μέρα είναι — αργία, γενέθλια ή διακοπές. Δεν πιάνει θέση στο ουράνιο τόξο και δεν τσεκάρεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background that says what kind of day it is — a holiday, birthday or vacation. It doesn't take a rainbow slot and isn't checked off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondo que indica qué tipo de día es: un festivo, un cumpleaños o unas vacaciones. No ocupa una franja del arcoíris ni se marca como hecho."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausta, joka kertoo, millainen päivä on – pyhäpäivä, syntymäpäivä tai loma. Se ei vie sateenkaaren paikkaa eikä sitä merkitä tehdyksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fond qui indique quel genre de jour c’est : férié, anniversaire ou vacances. Il n’occupe pas de case de l’arc-en-ciel et ne se coche pas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latar yang menandai hari itu hari apa — libur, ulang tahun, atau cuti. Tidak memakai slot pelangi dan tidak dicentang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfondo che dice che tipo di giorno è: una festività, un compleanno, una vacanza. Non occupa uno spazio dell’arcobaleno e non va spuntato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "祝日・誕生日・休暇のように、その日がどんな日かを示す背景です。虹のマスを使わず、完了したかどうかも尋ねません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrunn som forteller hva slags dag det er – en helligdag, bursdag eller ferie. Den tar ikke en plass i regnbuen og skal ikke hukes av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtergrond die zegt wat voor dag het is — een feestdag, verjaardag of vakantie. Neemt geen plek in de regenboog in en hoeft niet afgevinkt te worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tło mówiące, jaki to dzień — święto, urodziny czy urlop. Nie zajmuje miejsca w tęczy i nie trzeba go odhaczać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundo que diz que tipo de dia é — feriado, aniversário ou férias. Não ocupa espaço no arco-íris e não precisa ser marcado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фон, который говорит, что это за день: праздник, день рождения, отпуск. Не занимает место в радуге и не требует отметки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrund som visar vad det är för slags dag – en helgdag, en födelsedag eller semester. Den tar ingen plats i regnbågen och ska inte bockas av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นหลังที่บอกว่าวันนั้นเป็นวันอะไร เช่น วันหยุด วันเกิด หรือวันลาพักร้อน ไม่ใช้ช่องสีรุ้งและไม่ต้องติ๊กว่าทำแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günün nasıl bir gün olduğunu söyleyen arka plan: tatil, doğum günü ya da izin. Gökkuşağında yer kaplamaz ve işaretlenmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nền cho biết hôm đó là ngày gì — ngày lễ, sinh nhật hay kỳ nghỉ. Không chiếm ô cầu vồng và không cần đánh dấu xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标示这天是什么日子的背景，例如节假日、生日或休假。不占彩虹格，也不会问你做了没。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標示這天是什麼日子的背景，例如國定假日、生日或休假。不占彩虹格，也不會問你做了沒。"
          }
        }
      }
    },
    "구독은 기간이 끝나기 24시간 전까지 해지하지 않으면 같은 요금으로 자동 갱신되며, Apple 계정으로 결제됩니다. 무료 체험 중에 해지하면 요금이 나가지 않습니다. 해지와 관리는 App Store의 계정 설정에서 합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předplatné se automaticky obnovuje za stejnou cenu, pokud ho nezrušíte nejméně 24 hodin před koncem období, a účtuje se na váš Apple účet. Zrušíte-li ho během bezplatné zkušební doby, nic se vám neúčtuje. Spravovat nebo zrušit ho můžete v nastavení účtu v App Storu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementer fornyes automatisk til samme pris, medmindre de opsiges mindst 24 timer før periodens udløb, og opkræves via din Apple-konto. Opsiger du i den gratis prøveperiode, bliver du ikke opkrævet. Administrer eller opsig i indstillingerne for din App Store-konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos verlängern sich automatisch zum gleichen Preis, sofern sie nicht mindestens 24 Stunden vor Ende des Zeitraums gekündigt werden, und werden über deinen Apple Account abgerechnet. Kündigst du während der Gratis-Testphase, wird nichts berechnet. Verwalten oder kündigen kannst du in den Accounteinstellungen des App Store."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συνδρομές ανανεώνονται αυτόματα με την ίδια τιμή, εκτός αν ακυρωθούν τουλάχιστον 24 ώρες πριν από τη λήξη της περιόδου, και χρεώνονται στον Λογαριασμό Apple σας. Αν ακυρώσετε κατά τη δωρεάν δοκιμή, δεν θα χρεωθείτε. Η διαχείριση και η ακύρωση γίνονται από τις ρυθμίσεις του λογαριασμού σας στο App Store."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions renew automatically at the same price unless canceled at least 24 hours before the period ends, and are charged to your Apple Account. Cancel during the free trial and you won’t be charged. Manage or cancel in your App Store account settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente al mismo precio salvo que se cancelen al menos 24 horas antes de que termine el periodo, y se cobran a tu cuenta de Apple. Si cancelas durante la prueba gratuita, no se te cobrará nada. Gestiona o cancela la suscripción en los ajustes de tu cuenta del App Store."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilaukset uusiutuvat automaattisesti samaan hintaan, ellei niitä peruta vähintään 24 tuntia ennen jakson päättymistä, ja ne veloitetaan Apple-tililtäsi. Jos perut ilmaisen kokeilujakson aikana, sinua ei veloiteta. Hallitse tai peru tilaus App Store -tilisi asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement au même prix, sauf résiliation au moins 24 heures avant la fin de la période, et sont facturés sur votre compte Apple. Si vous résiliez pendant l’essai gratuit, rien ne vous est facturé. Gérez ou résiliez dans les réglages de votre compte App Store."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langganan diperpanjang otomatis dengan harga yang sama kecuali dibatalkan setidaknya 24 jam sebelum periode berakhir, dan ditagihkan ke Akun Apple Anda. Batalkan selama uji coba gratis dan Anda tidak akan ditagih. Kelola atau batalkan di pengaturan akun App Store Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti si rinnovano automaticamente allo stesso prezzo, salvo disdetta almeno 24 ore prima della fine del periodo, e vengono addebitati sul tuo Apple Account. Se disdici durante la prova gratuita non ti viene addebitato nulla. Gestisci o disdici nelle impostazioni dell’account App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは、期間終了の24時間前までに解約しない限り同じ料金で自動更新され、Apple Accountに請求されます。無料トライアル中に解約すれば料金はかかりません。管理と解約はApp Storeのアカウント設定で行えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementer fornyes automatisk til samme pris med mindre de sies opp minst 24 timer før perioden utløper, og belastes Apple-kontoen din. Sier du opp i gratisperioden, blir du ikke belastet. Administrer eller si opp i innstillingene for App Store-kontoen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementen worden automatisch verlengd tegen dezelfde prijs, tenzij je ze minstens 24 uur voor het einde van de periode opzegt, en worden in rekening gebracht via je Apple Account. Zeg je op tijdens de gratis proefperiode, dan betaal je niets. Beheer of zeg op in de accountinstellingen van de App Store."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcja odnawia się automatycznie w tej samej cenie, chyba że anulujesz ją co najmniej 24 godziny przed końcem okresu; opłata pobierana jest z Apple Account. Jeśli anulujesz w okresie próbnym, nic nie zapłacisz. Zarządzaj subskrypcją lub ją anuluj w ustawieniach konta App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas renovam automaticamente pelo mesmo preço, a menos que sejam canceladas pelo menos 24 horas antes do fim do período, e são cobradas na sua Conta Apple. Cancele durante o teste grátis e você não será cobrado. Gerencie ou cancele nos ajustes da sua conta da App Store."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписка продлевается автоматически по той же цене, если не отменить её хотя бы за 24 часа до конца периода, и оплачивается через Apple Account. Если отменить во время пробного периода, оплата не спишется. Управлять подпиской и отменить её можно в настройках учётной записи App Store."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenumerationer förnyas automatiskt till samma pris om de inte sägs upp senast 24 timmar innan perioden slutar, och debiteras ditt Apple-konto. Säger du upp under provperioden debiteras du inte. Hantera eller säg upp i kontoinställningarna för App Store."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสมัครสมาชิกจะต่ออายุอัตโนมัติในราคาเดิม เว้นแต่จะยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบ และจะเรียกเก็บเงินจากบัญชี Apple ของคุณ หากยกเลิกระหว่างทดลองใช้ฟรี จะไม่มีการเรียกเก็บเงิน จัดการหรือยกเลิกได้ในการตั้งค่าบัญชี App Store"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelikler, dönem bitmeden en az 24 saat önce iptal edilmediği sürece aynı fiyattan otomatik olarak yenilenir ve Apple Hesabınızdan ücretlendirilir. Ücretsiz deneme sırasında iptal ederseniz ücret alınmaz. App Store hesap ayarlarınızdan yönetin ya da iptal edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói đăng ký tự động gia hạn với cùng mức giá trừ khi được hủy ít nhất 24 giờ trước khi kỳ hạn kết thúc, và được tính vào Tài khoản Apple của bạn. Nếu hủy trong thời gian dùng thử miễn phí, bạn sẽ không bị tính phí. Quản lý hoặc hủy trong phần cài đặt tài khoản App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在订阅期结束前至少 24 小时取消，否则订阅将以相同价格自动续订，费用从你的 Apple 账户扣除。在免费试用期间取消则不会扣费。可在 App Store 的账户设置中管理或取消订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱會在期間結束前 24 小時內未取消時，以相同價格自動續訂，並向你的 Apple 帳號收費。在免費試用期間取消則不會收費。可在 App Store 的帳號設定中管理或取消訂閱。"
          }
        }
      }
    },
