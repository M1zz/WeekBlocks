    "아직 무지개 일정이 없습니다. 아이폰에서 만든 일정도 여기에 보입니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím tu nejsou žádné duhové plány. Zobrazí se tu i plány vytvořené na iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ingen regnbueplaner endnu. Planer, du opretter på iPhone, vises også her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Regenbogen-Pläne. Auch auf dem iPhone erstellte Pläne erscheinen hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν ακόμη προγράμματα ουράνιου τόξου. Εδώ εμφανίζονται και όσα δημιουργείτε στο iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No rainbow schedules yet. Schedules you make on iPhone show up here too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay planes arcoíris. Los que crees en el iPhone también aparecerán aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sateenkaarisuunnitelmia ei vielä ole. Myös iPhonella tehdyt suunnitelmat näkyvät täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun plan arc-en-ciel pour l’instant. Ceux créés sur iPhone s’affichent aussi ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada jadwal pelangi. Jadwal yang dibuat di iPhone juga muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun piano arcobaleno per ora. Qui compaiono anche quelli creati su iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虹の予定はまだありません。iPhoneで作った予定もここに表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen regnbueplaner ennå. Planer du lager på iPhone, vises også her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen regenboogplanningen. Planningen die je op je iPhone maakt, verschijnen hier ook."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma jeszcze planów tęczowych. Pojawią się tu też plany utworzone na iPhonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há planos arco-íris. Os planos criados no iPhone também aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Радужных планов пока нет. Здесь появятся и планы, созданные на iPhone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga regnbågsplaner än. Planer som du skapar på iPhone visas också här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีตารางสายรุ้ง ตารางที่สร้างบน iPhone ก็จะแสดงที่นี่ด้วย"
