    "활동을 좀 더 구체적으로 적어 주세요. (\"공부\"보다 \"Combine 학습\"처럼)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write the activity more concretely — “Learn Combine” rather than “study”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请把活动写得更具体一点（例如写“学习 Combine”而不是“读书”）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請把活動寫得更具體一點（例如寫「學習 Combine」而不是「讀書」）。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreib die Aktivität konkreter – „Combine lernen“ statt „lernen“."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活動をもう少し具体的に書いてください（「勉強」より「Combineを学ぶ」のように）。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe la actividad de forma más concreta: “Aprender Combine” en lugar de “estudiar”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez l’activité plus précisément : « Apprendre Combine » plutôt que « étudier »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi l’attività svolta in modo più concreto: “Studiare Combine” invece di “studiare”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva a atividade de forma mais concreta — “Aprender Combine” em vez de “estudar”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опишите занятие конкретнее — «изучить Combine», а не «учиться»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popište činnost konkrétněji – „Naučit se Combine“ místo „učit se“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv aktiviteten mere konkret — “Lær Combine” frem for “læs”."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψε τη δραστηριότητα πιο συγκεκριμένα — «Εκμάθηση Combine» αντί για «διάβασμα»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita toiminta konkreettisemmin – ”Opettele Combine” eikä ”opiskele”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis aktivitasnya lebih konkret — “Belajar Combine”, bukan “belajar”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv aktiviteten mer konkret – «Lær Combine» heller enn «studer»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschrijf de activiteit concreter — ‘Combine leren’ in plaats van ‘studeren’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opisz aktywność konkretniej — „Nauka Combine” zamiast „nauka”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv aktiviteten mer konkret – ”Lär dig Combine” i stället för ”plugga”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียนกิจกรรมให้ชัดเจนขึ้น — “เรียน Combine” แทน “อ่านหนังสือ”"
          }
        },
