        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это рутина — отмечать не нужно"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rutin – den frågar inte om du gjort den"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กิจวัตร — ไม่ถามว่าทำแล้วหรือยัง"
