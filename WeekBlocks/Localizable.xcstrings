          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai có liên kết đều xem được tuần của bạn ở chế độ chỉ xem. Liên kết tự cập nhật khi lịch của bạn thay đổi."
          }
        }
      }
    },
    "마감·제출처럼 시각은 없지만 그날 해야 하는 일입니다. 무지개 칸을 차지하고, 날이 지나면 했는지 묻습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something due that day with no set time, like a deadline. It takes a rainbow slot and asks whether it's done once the day passes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像截止、提交这类没有指定时间、但当天必须做的事。会占一个彩虹格，过了当天会问你做了没。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像截止、繳交這類沒有指定時間、但當天必須做的事。會占一個彩虹格，過了當天會問你做了沒。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas, das an diesem Tag fällig ist, ohne feste Uhrzeit, etwa eine Frist. Belegt einen Regenbogenplatz und fragt nach, ob es erledigt ist, wenn der Tag vorbei ist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "締め切り・提出のように、時刻はないけれどその日にやること。虹のマスを使い、その日が過ぎると完了したかを尋ねます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que vence ese día sin hora fija, como una fecha de entrega. Ocupa una franja del arcoíris y pregunta si está hecho cuando pasa el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose à rendre ce jour-là sans heure précise, comme une échéance. Occupe une case de l’arc-en-ciel et demande si c’est fait une fois le jour passé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa da fare quel giorno senza un orario preciso, come una scadenza. Occupa uno spazio dell’arcobaleno e, passato il giorno, ti chiede se è stata fatta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo para aquele dia sem horário definido, como um prazo. Ocupa um espaço no arco-íris e pergunta se foi feito quando o dia passa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что нужно сделать в этот день без конкретного времени, например дедлайн. Занимает место в радуге, а когда день пройдёт, приложение спросит, сделано ли."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco, co je ten den splatné bez pevného času, třeba termín odevzdání. Zabírá místo v duze a po skončení dne se zeptá, zda je to hotové."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noget, der skal være klaret den dag uden fast tidspunkt, f.eks. en deadline. Det optager en plads i regnbuen og spørger, om det er klaret, når dagen er gået."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτι που λήγει εκείνη την ημέρα χωρίς συγκεκριμένη ώρα, όπως μια προθεσμία. Πιάνει θέση στο ουράνιο τόξο και ρωτά αν έγινε μόλις περάσει η ημέρα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivälle kuuluva asia ilman kellonaikaa, kuten määräpäivä. Se vie sateenkaaren paikan, ja päivän mentyä siitä kysytään, onko se tehty."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuatu yang jatuh tempo hari itu tanpa jam tertentu, seperti tenggat. Memakai slot pelangi dan ditanya sudah selesai atau belum setelah harinya lewat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe som skal være gjort den dagen uten fast tidspunkt, for eksempel en frist. Det tar en plass i regnbuen og spør om det er gjort når dagen er over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets wat die dag af moet zonder vaste tijd, zoals een deadline. Neemt een plek in de regenboog in en vraagt na afloop van de dag of het gedaan is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś do zrobienia tego dnia bez konkretnej godziny, np. termin. Zajmuje miejsce w tęczy, a gdy dzień minie, aplikacja zapyta, czy zrobione."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något som ska vara klart den dagen utan fast tid, som en deadline. Det tar en plats i regnbågen och frågar om det är gjort när dagen har passerat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่ต้องทำให้เสร็จในวันนั้นโดยไม่กำหนดเวลา เช่น กำหนดส่ง ใช้ช่องสีรุ้งหนึ่งช่อง และจะถามว่าเสร็จหรือยังเมื่อวันนั้นผ่านไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gün yapılması gereken ama saati olmayan bir şey, örneğin bir son tarih. Gökkuşağında bir yer kaplar ve gün geçince yapılıp yapılmadığını sorar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc đến hạn trong ngày mà không có giờ cụ thể, như một hạn chót. Chiếm một ô cầu vồng và sẽ hỏi đã xong chưa khi ngày đó qua đi."
          }
        }
      }
    },
