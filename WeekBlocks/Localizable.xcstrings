    "저녁에 내일을 닫고, 아침에 첫 걸음 하나를 봅니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close tomorrow in the evening, see one first step in the morning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚上把明天安排好，早上只看第一步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚上把明天安排好，早上只看第一步。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließ den nächsten Tag am Abend ab und sieh morgens einen ersten Schritt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜に明日を決めて、朝は最初の一歩をひとつ見るだけ。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra el día de mañana por la noche y, por la mañana, mira un solo primer paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouclez demain dès le soir, et le matin ne voyez qu’un premier pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sera chiudi il domani, la mattina vedi un solo primo passo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feche o amanhã à noite e veja um primeiro passo de manhã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечером закройте завтрашний день, утром увидите один первый шаг."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Večer uzavřete zítřek, ráno uvidíte jeden první krok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luk morgendagen om aftenen, se ét første trin om morgenen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλείσε το αύριο από το βράδυ, δες ένα πρώτο βήμα το πρωί."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitse huominen illalla, näe aamulla yksi ensimmäinen vaihe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup hari esok di malam hari, lihat satu langkah pertama di pagi hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt morgendagen om kvelden, se ett første trinn om morgenen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit morgen ’s avonds af, zie ’s ochtends één eerste stap."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wieczorem zamknij jutro, rano zobacz jeden pierwszy krok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng morgondagen på kvällen, se ett enda första steg på morgonen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดเรื่องพรุ่งนี้ตั้งแต่ตอนเย็น แล้วตอนเช้าดูแค่ก้าวแรกก้าวเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yarını akşamdan kapatın, sabah yalnızca ilk adımı görün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chốt ngày mai từ buổi tối, sáng ra chỉ nhìn một bước đầu tiên."
          }
        }
      }
    },
