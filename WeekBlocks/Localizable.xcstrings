    "%@에 고른 주의 계획을 같은 요일·같은 시각으로 깝니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přenese plán vybraného týdne do %@ – na stejné dny a ve stejných časech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lægger den valgte uges plan ind i %@ på de samme dage og tidspunkter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überträgt den Plan der gewählten Woche auf %@ – an denselben Tagen und zu denselben Zeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τοποθετεί το πλάνο της επιλεγμένης εβδομάδας στην εβδομάδα %@, τις ίδιες ημέρες και τις ίδιες ώρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lays the chosen week’s plan onto %@, on the same days and at the same times."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca el plan de la semana elegida en %@, en los mismos días y a las mismas horas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asettaa valitun viikon suunnitelman kohteeseen %@ samoille päiville ja samoihin aikoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reporte le planning de la semaine choisie sur %@, aux mêmes jours et aux mêmes heures."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menempatkan rencana minggu yang dipilih ke %@, pada hari dan jam yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riporta il piano della settimana scelta su %@, negli stessi giorni e agli stessi orari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ週の予定を、同じ曜日・同じ時刻で%@に並べます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger den valgte ukens plan inn i %@, på de samme dagene og tidspunktene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet het plan van de gekozen week op %@, op dezelfde dagen en tijden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi plan wybranego tygodnia na %@ — w te same dni i o tych samych godzinach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca o plano da semana escolhida em %@, nos mesmos dias e horários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносит план выбранной недели на %@ — в те же дни и в то же время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger den valda veckans plan på %@, samma dagar och samma tider."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางแผนของสัปดาห์ที่เลือกลงใน %@ ในวันและเวลาเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen haftanın planını aynı günlere ve aynı saatlere yerleştirir. Hedef: %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt kế hoạch của tuần đã chọn vào %@, cùng ngày và cùng giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所选那周的计划，按相同星期、相同时间套用到 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將所選那週的計畫，以相同星期、相同時間套用到 %@。"
          }
        }
      }
    },
