    "상품을 아직 못 불러왔습니다. 잠시 뒤 다시 시도해 주세요." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produkt se ještě nenačetl. Zkuste to za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produktet er ikke indlæst endnu. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Produkt ist noch nicht geladen. Versuch es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το προϊόν δεν έχει φορτωθεί ακόμη. Δοκίμασε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The product hasn't loaded yet. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El producto aún no se ha cargado. Inténtalo de nuevo en un momento."
