        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä päivä ei ole vielä tullut. Katso taaksepäin, kun se on ohi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jour n’est pas encore arrivé. Faites le point une fois passé."
