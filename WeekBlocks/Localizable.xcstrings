        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@\n\n— %2$@"
          }
        }
      }
    },
    "%@\n눌러서 상세 · 같은 요일 안에서 끌어 시각 옮기기 · 우클릭으로 타이머 시작" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nClick for details · drag within the same day to change the time · right-click to start the timer"
          }
        }
      }
    },
    "%@ — %@와 %@시간" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@h with %@"
