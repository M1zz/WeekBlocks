    "이 할 일을 이루는 단계를 '되어야 하는 순서대로' 적어보세요.\n단계들은 전체 %@를 N분의 1로 나눠 갖습니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write the steps this to-do is made of, in the order they have to happen.\nThe steps split the full %@ evenly between them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按照“必须发生的顺序”写下构成这个待办事项的步骤。\n各步骤会平分全部的 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依照「必須發生的順序」寫下構成這個待辦事項的步驟。\n各步驟會平分全部的 %@。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib die Schritte, aus denen diese Aufgabe besteht, in der Reihenfolge, in der sie passieren müssen.\nDie Schritte teilen sich die gesamten %@ gleichmäßig."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このやることを構成するステップを「進めるべき順番どおりに」書いてみましょう。\nステップは全体の%@を均等に分け合います。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe los pasos de los que se compone esta tarea, en el orden en que tienen que ocurrir.\nLos pasos se reparten a partes iguales el total de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
