          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen toegang tot de agenda."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak dostępu do kalendarza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem acesso ao calendário."
          }
        },
        "ru" : {
          "stringUnit" : {
