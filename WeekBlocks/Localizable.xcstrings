        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ύπνος δεν αποκρύπτεται, επειδή η ρουτίνα ύπνου δεν αγγίζει τα μεσάνυχτα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unta ei piiloteta, koska unirutiini ei ulotu keskiyöhön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidur tidak disembunyikan karena rutinitas tidur tidak melewati tengah malam."
          }
        },
        "nb" : {
          "stringUnit" : {
