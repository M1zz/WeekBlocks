            "value" : "Jos niiden on mentävä päällekkäin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ils doivent se chevaucher"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika harus bertumpuk"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se devono sovrapporsi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どうしても重ねるなら"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis de må overlappe"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als ze moeten overlappen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli muszą się nakładać"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se precisarem se sobrepor"
          }
        },
        "ru" : {
