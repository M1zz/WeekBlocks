    "계획한 시간 중 해낸 시간, 일마다 계획보다 얼마나 더 걸리는지 봅니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See how much of your planned time you got done, and how much longer each task takes than planned."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看看計畫的時間完成了多少，以及每件事比計畫多花多久。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看看计划的时间完成了多少，以及每件事比计划多花多久。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画した時間のうちどれだけやり遂げたか、作業ごとに計画よりどれだけ長くかかるかを見られます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wie viel deiner geplanten Zeit du geschafft hast und wie viel länger jede Aufgabe dauert als geplant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira cuánto del tiempo planificado completaste y cuánto más de lo previsto lleva cada tarea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez quelle part du temps prévu vous avez accomplie et combien de temps en plus prend chaque tâche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri quanta parte del tempo pianificato hai completato e quanto in più richiede ogni attività."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja quanto do tempo planejado você cumpriu e quanto a mais cada tarefa leva do que o previsto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько запланированного времени выполнено и насколько дольше плана занимает каждая задача."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvidíte, kolik plánovaného času jste splnili a o kolik déle než v plánu trvá každý úkol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, hvor meget af den planlagte tid du nåede, og hvor meget længere hver opgave tager end planlagt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες πόσο από τον προγραμματισμένο χρόνο ολοκλήρωσες και πόσο περισσότερο από το πλάνο παίρνει κάθε εργασία."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näe, kuinka paljon suunnitellusta ajasta sait tehtyä ja kuinka paljon suunniteltua kauemmin kukin tehtävä kestää."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat berapa banyak waktu rencana yang terselesaikan dan berapa lama lebih tiap tugas dari rencana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hvor mye av den planlagte tiden du fikk gjort, og hvor mye lenger hver oppgave tar enn planlagt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie hoeveel van je geplande tijd je hebt gedaan en hoeveel langer elke taak duurt dan gepland."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz, ile zaplanowanego czasu udało się zrobić i o ile dłużej niż w planie trwa każde zadanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hur mycket av den planerade tiden du fick gjort och hur mycket längre varje uppgift tar än planerat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูว่าทำได้เท่าไรจากเวลาที่วางแผนไว้ และแต่ละงานใช้เวลานานกว่าแผนเท่าไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planladığın sürenin ne kadarını yaptığını ve her işin plandan ne kadar uzun sürdüğünü gör."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem bạn làm được bao nhiêu trong thời gian đã lên kế hoạch, và mỗi việc mất lâu hơn kế hoạch bao nhiêu."
          }
        }
      }
    },
