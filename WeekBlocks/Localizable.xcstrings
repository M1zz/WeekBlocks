          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε οριζόντια για να επιλέξετε περίοδο ή κάντε διπλό κλικ για προσθήκη μακροπρόθεσμου πλάνου από αυτή την ημέρα"
          }
        },
        "en" : {
          "stringUnit" : {
