        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de fin définie, donc cela ne se boucle jamais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada ujung yang jelas, jadi tidak pernah tuntas."
