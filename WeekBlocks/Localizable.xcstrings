        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä ovat oletukset jokaiselle päivälle. Aikajanalla yksittäisenä päivänä siirtämäsi kohteet pysyvät sellaisinaan sinä päivänä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini jam bawaan untuk setiap hari. Yang Anda pindahkan di linimasa untuk satu hari tetap seperti itu pada hari tersebut."
