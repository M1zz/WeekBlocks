    "밖에 있을 때 다음 일정이 몇 시인지, 오늘 남은 시간이 얼마인지 아이폰을 꺼내 바로 봅니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you're out, take out your iPhone to see when your next plan starts and how much of today is left."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出时拿出 iPhone，就能看到下一个日程几点开始、今天还剩多少时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出時拿出 iPhone，就能看到下一個行程幾點開始、今天還剩多少時間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterwegs zeigt dir dein iPhone, wann dein nächster Plan beginnt und wie viel vom Tag noch übrig ist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出先でも、次の予定が何時か、今日の残り時間がどれくらいかを、iPhoneを取り出してすぐ確認できます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando estés fuera, saca el iPhone para ver cuándo empieza tu próximo plan y cuánto queda de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dehors, sortez votre iPhone pour voir quand commence votre prochain plan et combien de temps il reste aujourd’hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando sei fuori, prendi l’iPhone per vedere quando inizia il prossimo impegno e quanto resta della giornata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora de casa, pegue o iPhone para ver quando começa o próximo plano e quanto resta do dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вне дома достаньте iPhone и сразу увидите, когда следующий план и сколько осталось от сегодняшнего дня."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když jste venku, vytáhněte iPhone a uvidíte, kdy začíná váš další plán a kolik ze dneška zbývá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du er ude, kan du tage din iPhone frem og se, hvornår din næste plan starter, og hvor meget der er tilbage af i dag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είσαι έξω, βγάλε το iPhone σου για να δεις πότε ξεκινά το επόμενο πλάνο και πόσο απομένει από τη σημερινή μέρα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun olet liikkeellä, katso iPhonesta, milloin seuraava suunnitelma alkaa ja paljonko päivästä on jäljellä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat bepergian, keluarkan iPhone untuk melihat kapan rencana berikutnya dimulai dan berapa sisa hari ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du er ute, kan du ta frem iPhonen og se når neste plan starter og hvor mye som er igjen av dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderweg pak je je iPhone om te zien wanneer je volgende plan begint en hoeveel er van vandaag over is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poza domem wyjmij iPhone’a i od razu zobacz, kiedy zaczyna się następny plan i ile zostało z dzisiejszego dnia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du är ute tar du fram iPhone och ser när nästa plan börjar och hur mycket som är kvar av dagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่ออยู่นอกบ้าน หยิบ iPhone ขึ้นมาดูได้เลยว่าแผนถัดไปเริ่มกี่โมง และวันนี้เหลือเวลาเท่าไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışarıdayken iPhone’unuzu çıkarın; bir sonraki planınızın ne zaman başladığını ve bugünden ne kadar kaldığını görün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi ra ngoài, rút iPhone ra là thấy ngay kế hoạch tiếp theo bắt đầu lúc mấy giờ và hôm nay còn bao nhiêu thời gian."
          }
