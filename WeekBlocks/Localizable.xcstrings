        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To jsou příklady. Každý má týden jiný – a právě ten rozdíl vám tahle aplikace ukazuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er bare eksempler. Alles uge er forskellig, og at vise dig den forskel er netop, hvad denne app gør."
