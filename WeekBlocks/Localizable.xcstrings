    "%lld개를 되살렸습니다. 되살리기 전 모습도 백업으로 남겨 두었습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovené položky: %lld. Stav před obnovením je také uložen jako záloha."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementer er hentet tilbage. Tilstanden fra før er også gemt som backup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Einträge zurückgeholt. Der Stand davor wurde ebenfalls als Sicherung abgelegt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρθηκαν %lld στοιχεία. Η προηγούμενη κατάσταση κρατήθηκε επίσης ως αντίγραφο ασφαλείας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brought back %lld items. The way things were before was also saved as a backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se recuperaron %lld elementos. El estado anterior también se guardó como copia de seguridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautettiin %lld kohdetta. Aiempi tila tallennettiin myös varmuuskopioksi."
