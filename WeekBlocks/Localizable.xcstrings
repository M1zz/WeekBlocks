    },
    "링크·자료를 펼쳐만 둡니다. 본 작업의 시동 비용을 여기서 미리 냅니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen otevřete odkazy a soubory. Náklady na rozjezd skutečné práce tak zaplatíte předem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn bare links og filer. Du betaler opstartsprisen for det rigtige arbejde her, på forhånd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne nur die Links und Unterlagen. So zahlst du die Anlaufkosten der eigentlichen Arbeit schon vorab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απλώς άνοιξε τους συνδέσμους και τα αρχεία. Έτσι πληρώνεις από πριν, εδώ, το κόστος εκκίνησης της κανονικής δουλειάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just open the links and files. You pay the real work's spin-up cost here, in advance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo abre los enlaces y archivos. Aquí pagas por adelantado el coste de arranque del trabajo de verdad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa vain linkit ja tiedostot. Maksat varsinaisen työn käynnistyskustannuksen tässä etukäteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez seulement les liens et les documents. Vous payez ici, à l’avance, le coût de démarrage du vrai travail."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukup buka tautan dan berkasnya. Biaya pemanasan pekerjaan utama dibayar di sini, lebih awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri solo link e file. Qui paghi in anticipo il costo di avvio del lavoro vero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクや資料を開いておくだけ。本番の作業の準備コストを、ここで先に払っておきます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare åpne lenkene og filene. Du betaler oppstartskostnaden for det egentlige arbeidet her, på forhånd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open alleen de links en bestanden. Je betaalt hier alvast de opstartkosten van het echte werk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko otwórz linki i pliki. Tu z góry płacisz koszt rozruchu właściwej pracy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só abra os links e arquivos. Você paga aqui, antecipadamente, o custo de aquecimento do trabalho de verdade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто откройте ссылки и файлы. Здесь вы заранее платите цену раскачки перед основной работой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna bara länkarna och filerna. Här betalar du i förväg startkostnaden för det riktiga arbetet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แค่เปิดลิงก์และไฟล์ไว้ จ่ายต้นทุนการวอร์มเครื่องของงานจริงไว้ล่วงหน้าตรงนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bağlantıları ve dosyaları açın. Asıl işin ısınma bedelini burada, önceden ödersiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ mở sẵn các liên kết và tài liệu. Bạn trả trước chi phí khởi động của phần việc chính ngay tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要把链接和资料打开放着就好。先在这里付掉正式工作的热身成本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要把連結和資料打開放著就好。先在這裡付掉正式工作的暖機成本。"
          }
        }
      }
    },
    "링크를 받은 사람은 내 주간 일정을 '보기 전용'으로만 봅니다. 일정이 바뀌면 자동으로 갱신됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo má odkaz, vidí váš týden jen ke čtení. Aktualizuje se sám, když se váš rozvrh změní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle med linket kan se din uge, men ikke ændre den. Den opdateres af sig selv, når din plan ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer den Link hat, sieht deine Woche nur zum Ansehen. Er aktualisiert sich von selbst, wenn sich dein Zeitplan ändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος έχει τον σύνδεσμο βλέπει την εβδομάδα σου μόνο για προβολή. Ενημερώνεται μόνος του όταν αλλάζει το πρόγραμμά σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with the link sees your week view-only. It updates on its own when your schedule changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga el enlace ve tu semana en modo de solo lectura. Se actualiza sola cuando cambia tu agenda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuka tahansa linkin saanut näkee viikkosi vain luku -tilassa. Se päivittyy itsestään, kun aikataulusi muuttuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant du lien voit votre semaine en lecture seule. Le lien se met à jour tout seul quand votre planning change."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang punya tautannya bisa melihat minggu Anda (hanya lihat). Tautan diperbarui sendiri saat jadwal Anda berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ha il link vede la tua settimana in sola lettura. Si aggiorna da sola quando il programma cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを受け取った人は、あなたの週間スケジュールを閲覧のみで見られます。スケジュールが変わると自動で更新されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle med lenken kan se uken din, men ikke endre den. Den oppdateres av seg selv når planen din endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie de link heeft, ziet je week alleen-lezen. Hij werkt zichzelf bij als je planning verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto ma link, widzi Twój tydzień tylko do odczytu. Aktualizuje się sam, gdy zmienisz plan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem tiver o link vê sua semana só para leitura. Ela se atualiza sozinha quando sua agenda muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получатель ссылки видит вашу неделю только для просмотра. При изменении расписания она обновляется сама."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla med länken ser din vecka med endast läsbehörighet. Den uppdateras av sig själv när ditt schema ändras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใครที่มีลิงก์จะเห็นสัปดาห์ของคุณแบบดูอย่างเดียว และจะอัปเดตเองเมื่อตารางของคุณเปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıya sahip olan herkes haftanızı yalnızca görüntüleyebilir. Programınız değiştiğinde kendiliğinden güncellenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai có liên kết đều xem được tuần của bạn ở chế độ chỉ xem. Liên kết tự cập nhật khi lịch của bạn thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拿到链接的人只能以“仅供查看”方式查看你的一周日程。日程变动时会自动更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
