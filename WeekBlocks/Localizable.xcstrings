    "캘린더에서 사라진 일정 %lld개가 아직 계획에 있습니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Události odebrané z kalendáře, které jsou stále ve vašem plánu: %lld"
