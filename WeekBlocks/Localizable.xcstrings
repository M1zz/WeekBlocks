    },
    "모든 단계를 마쳤습니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every step is finished"
          }
        }
      }
    },
    "모든 데이터 삭제" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
