          }
        }
      }
    },
    "끼니" : {
      "comment" : "기본 루틴 이름",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meals"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
