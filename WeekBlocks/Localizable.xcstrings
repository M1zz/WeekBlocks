    "고정 루틴을 먼저 추가하면 할 일을 계획할 수 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív přidejte pevnou rutinu, pak můžete začít plánovat úkoly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj først en fast rutine, så kan du begynde at planlægge opgaver."
          }
        },
        "de" : {
