            "state" : "translated",
            "value" : "ไม่มีสิทธิ์เข้าถึงปฏิทิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takvim erişimi yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có quyền truy cập lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
