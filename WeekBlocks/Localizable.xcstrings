    "남는 자리에 무엇을 넣을지 요일마다 정합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decide, day by day, what goes in the space that's left."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐日决定剩下的空间要放什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐日決定剩下的空間要放什麼。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg Tag für Tag fest, was in die verbleibende Zeit kommt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空いた時間に何を入れるか、曜日ごとに決めます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decide, día a día, qué va en el espacio que queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décidez, jour par jour, ce qui va dans le temps qui reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decidi, giorno per giorno, cosa mettere nello spazio che resta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decida, dia a dia, o que entra no espaço que sobra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Решайте по дням, чем заполнить оставшееся место."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den po dni rozhodněte, co přijde do zbývajícího času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beslut dag for dag, hvad der skal fylde den plads, der er tilbage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποφάσισε, μέρα με τη μέρα, τι μπαίνει στον χρόνο που απομένει."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päätä päivä kerrallaan, mitä jäljelle jäävään tilaan tulee."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putuskan, hari demi hari, apa yang mengisi ruang yang tersisa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestem dag for dag hva som skal fylle plassen som er igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaal per dag wat er in de overgebleven ruimte komt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdecyduj, dzień po dniu, co trafi w pozostałe miejsce."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestäm dag för dag vad som ska in i utrymmet som är kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัดสินใจทีละวันว่าจะใส่อะไรในเวลาที่เหลือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalan zamana ne gireceğine gün gün karar verin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyết định cho từng ngày xem phần còn trống sẽ dành cho việc gì."
          }
        }
      }
    },
