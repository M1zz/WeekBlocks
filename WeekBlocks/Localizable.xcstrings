    },
    "캘린더에서 사라진 일정 %lld개를 지울까요?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete %lld blocks whose calendar events are gone?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要删除 %lld 个日历日程已消失的时间块吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要刪除 %lld 個行事曆活動已消失的區塊嗎？"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Blöcke löschen, deren Kalendertermine verschwunden sind?"
          }
        },
        "ja" : {
          "stringUnit" : {
