    "아직 장기 플랜이 없습니다. 프로젝트 기간 · 마감 · 격주 수업처럼 오래 이어지는 일을 적으면 여기에 쌓입니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím žádné dlouhodobé plány. Zapište věci, které trvají delší dobu – projekty, termíny, kurzy jednou za dva týdny – a budou se skládat sem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen langsigtede planer endnu. Skriv ting, der varer længe – projektperioder, deadlines, undervisning hver anden uge – så samles de her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine langfristigen Pläne. Trage ein, was länger dauert – Projektzeiträume, Fristen, Kurse alle zwei Wochen – und es sammelt sich hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν ακόμη μακροπρόθεσμα πλάνα. Γράψτε ό,τι διαρκεί καιρό – διάρκεια έργων, προθεσμίες, μαθήματα ανά δύο εβδομάδες – και θα συγκεντρώνονται εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No long-term plans yet. Add things that run for a while — project periods, deadlines, classes every two weeks — and they stack up here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay planes a largo plazo. Añade lo que dura un tiempo —proyectos, plazos, clases cada dos semanas— y se irá acumulando aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä pitkän aikavälin suunnitelmia. Kirjaa pitkään kestävät asiat – projektit, määräajat, joka toinen viikko pidettävät kurssit – niin ne kertyvät tähän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun plan à long terme pour l’instant. Ajoutez ce qui dure — périodes de projet, échéances, cours toutes les deux semaines — et tout s’empilera ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada rencana jangka panjang. Tulis hal yang berlangsung lama — periode proyek, tenggat, kelas setiap 2 minggu — dan semuanya akan tertumpuk di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun piano a lungo termine. Aggiungi ciò che dura nel tempo — periodi di progetto, scadenze, corsi ogni due settimane — e si accumulerà qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長期プランはまだありません。プロジェクト期間・締め切り・隔週の授業など、長く続くことを書くとここに積み重なります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen langsiktige planer ennå. Skriv inn ting som varer lenge – prosjektperioder, frister, kurs annenhver uke – så samles de her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen langetermijnplannen. Voeg toe wat langer loopt — projectperiodes, deadlines, lessen om de week — en het stapelt zich hier op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak planów długoterminowych. Zapisz to, co trwa dłużej — okresy projektów, terminy, zajęcia co dwa tygodnie — a zbierze się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há planos de longo prazo. Adicione o que dura um tempo — períodos de projeto, prazos, aulas a cada duas semanas — e tudo se acumula aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Долгосрочных планов пока нет. Запишите то, что длится долго, — сроки проектов, дедлайны, занятия раз в две недели, — и всё будет складываться здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga långsiktiga planer än. Skriv in sådant som pågår länge – projektperioder, deadlines, kurser varannan vecka – så samlas de här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีแผนระยะยาว เพิ่มสิ่งที่ต่อเนื่องยาว เช่น ช่วงโปรเจกต์ กำหนดส่ง หรือคลาสทุก 2 สัปดาห์ แล้วจะซ้อนขึ้นที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz uzun vadeli plan yok. Uzun süren şeyleri — proje dönemleri, son tarihler, iki haftada bir dersler — ekleyin, burada birikir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có kế hoạch dài hạn. Hãy thêm những việc kéo dài — thời gian dự án, hạn chót, lớp học hai tuần một lần — chúng sẽ xếp chồng ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有长期计划。写下持续一段时间的事——项目周期、截止日期、隔周的课程——它们会在这里叠起来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有長期計畫。寫下持續一段時間的事——專案期間、截止日期、隔週的課程——它們會在這裡疊起來。"
          }
        }
      }
    },
