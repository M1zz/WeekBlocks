          "stringUnit" : {
            "state" : "translated",
            "value" : "En enhed er ikke opdateret. Hvis du slettede dem med vilje på den enhed, kan du lade det være."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Gerät ist nicht aktualisiert. Wenn du das auf diesem Gerät absichtlich gelöscht hast, lass es so."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχει συσκευή που δεν έχει ενημερωθεί. Αν τα διαγράψατε σκόπιμα σε εκείνη τη συσκευή, αφήστε τα έτσι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One of your devices isn’t up to date. If you deleted these on purpose on that device, leave things as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un dispositivo sin actualizar. Si lo borraste a propósito en ese dispositivo, déjalo así."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokin laite on päivittämättä. Jos poistit ne siinä laitteessa tarkoituksella, jätä asia näin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un appareil n’est pas à jour. Si vous les avez supprimés volontairement sur cet appareil, laissez-les ainsi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada perangkat yang belum diperbarui. Jika Anda sengaja menghapusnya di perangkat itu, biarkan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’è un dispositivo non aggiornato. Se li hai eliminati di proposito su quel dispositivo, lascia così."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートしていないデバイスがあります。そのデバイスで意図して削除したものなら、そのままにしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enhet er ikke oppdatert. Hvis du slettet dem med vilje på den enheten, kan du la det være."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een apparaat niet bijgewerkt. Als je ze op dat apparaat bewust hebt verwijderd, laat het dan zo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno z urządzeń nie jest zaktualizowane. Jeśli celowo usunięto je na tamtym urządzeniu, zostaw to tak."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há um dispositivo desatualizado. Se você apagou isso de propósito naquele dispositivo, deixe como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть необновлённое устройство. Если вы намеренно удалили это на том устройстве, оставьте как есть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enhet är inte uppdaterad. Om du raderade dem med flit på den enheten kan du låta det vara."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีอุปกรณ์ที่ยังไม่ได้อัปเดต หากคุณตั้งใจลบจากอุปกรณ์นั้น ก็ปล่อยไว้ได้"
