          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — нажмите, чтобы изменить · тяните вбок, чтобы сдвинуть время (шаг 15 мин) · вверх или вниз — на другой день · правый клик — ещё"
          }
        },
        "sv" : {
          "stringUnit" : {
