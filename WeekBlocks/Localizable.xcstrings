          "stringUnit" : {
            "state" : "translated",
            "value" : "Samalla Apple-tilillä tehtävät näkyvät molemmissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le même compte Apple, les tâches apparaissent sur les deux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan Akun Apple yang sama, tugas muncul di keduanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con lo stesso Apple Account, le attività compaiono su entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じApple Accountなら、両方にやることが表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med samme Apple-konto vises oppgavene begge steder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met hetzelfde Apple Account verschijnen taken op beide."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
