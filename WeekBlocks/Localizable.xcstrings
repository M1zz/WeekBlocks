    "수면 루틴이 0시나 24시에 닿지 않아 접지 못했어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep isn't hidden because the sleep routine doesn't touch midnight."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠作息没有接触 0 点或 24 点，因此未能折叠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠作息沒有碰到 0 點或 24 點，因此未能收合。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlaf wird nicht ausgeblendet, weil die Schlafroutine Mitternacht nicht berührt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠ルーティンが0時または24時にかかっていないため、折りたためませんでした。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño no se oculta porque la rutina de sueño no llega a medianoche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil n’est pas masqué, car la routine de sommeil ne touche pas minuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno non viene nascosto perché la routine del sonno non tocca la mezzanotte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sono não foi ocultado porque a rotina de sono não toca a meia-noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
