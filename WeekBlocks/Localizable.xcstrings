          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠を折りたたむと残りが短くなりすぎるため、1日全体を表示しています。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra el día entero porque, ocultando el sueño, quedaría demasiado poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La journée entière est affichée, car masquer le sommeil laisserait trop peu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostro l’intera giornata perché nascondendo il sonno resterebbe troppo poco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando o dia inteiro porque ocultar o sono deixaria pouco demais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показан весь день: если скрыть сон, останется слишком мало."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje se celý den, protože po skrytí spánku by zbylo příliš málo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele dagen vises, fordi der ville være for lidt tilbage, hvis søvnen blev skjult."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζεται όλη η μέρα, επειδή αν κρυφτεί ο ύπνος θα έμενε πολύ λίγος χώρος."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytetään koko päivä, koska unen piilottaminen jättäisi liian vähän."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan sehari penuh karena menyembunyikan tidur akan menyisakan terlalu sedikit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele døgnet vises fordi det ville bli for lite igjen hvis søvnen ble skjult."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hele dag wordt getoond omdat er te weinig over zou blijven als de slaap verborgen werd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazano cały dzień, bo po ukryciu snu zostałoby za mało."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar hela dagen eftersom det blir för lite kvar om sömnen döljs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงทั้งวัน เพราะถ้าซ่อนเวลานอนจะเหลือพื้นที่น้อยเกินไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uykuyu gizlemek çok az alan bırakacağı için günün tamamı gösteriliyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện cả ngày vì nếu ẩn giờ ngủ thì phần còn lại quá ít."
          }
        }
      }
    },
