        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Går igenom hur du bygger en vecka från början igen: fasta rutiner → uppgifter → placera dem på dagar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พาดูขั้นตอนการวางแผนสัปดาห์ใหม่ตั้งแต่ต้น: กิจวัตรประจำ → สิ่งที่ต้องทำ → วางลงในวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir haftayı kurmayı baştan yeniden gösterir: sabit rutinler → görevler → günlere yerleştirme."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem lại từ đầu cách xây một tuần: thói quen cố định → việc cần làm → xếp vào các ngày."
          }
        }
      }
    },
    "한 주의 회고를 글로 복사해 노트나 보고서에 붙입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy a week’s review as text for your notes or a report."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将一周的复盘复制为文字，粘贴到笔记或报告中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將一週的回顧複製成文字，貼到筆記或報告中。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
