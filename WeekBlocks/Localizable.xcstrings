    "프로젝트들을 한눈에 보고, 고르면 그 안에 할 일을 적는다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny projekty na jednom místě – vyberte jeden a zapište jeho úkoly"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alle dine projekter på én gang, og vælg et for at skrive dets opgaver"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Projekte auf einen Blick – wähle eines, um seine Aufgaben zu notieren"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες όλα τα έργα σου με μια ματιά και επίλεξε ένα για να γράψεις τις εργασίες του"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See all your projects at a glance, and pick one to write its to-dos"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve todos tus proyectos de un vistazo y elige uno para escribir sus tareas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näe kaikki projektisi yhdellä silmäyksellä ja valitse yksi kirjoittaaksesi sen tehtävät"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez tous vos projets d’un coup d’œil, et choisissez-en un pour noter ses tâches"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat semua proyek sekilas, lalu pilih satu untuk menulis tugasnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi tutti i progetti a colpo d’occhio e scegline uno per scriverne le attività"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトをひと目で見渡し、選ぶとその中にやることを書けます"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alle prosjektene dine samlet, og velg ett for å skrive oppgavene i det"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk al je projecten in één oogopslag en kies er een om de taken op te schrijven"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie projekty w jednym widoku — wybierz jeden, by zapisać jego zadania"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja todos os seus projetos num relance e escolha um para escrever as tarefas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все проекты на одном экране: выберите проект, чтобы записать в него задачи"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alla dina projekt på ett ögonkast och välj ett för att skriva dess uppgifter"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูโปรเจกต์ทั้งหมดในพริบตา แล้วเลือกเพื่อเขียนสิ่งที่ต้องทำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm projelerinizi bir bakışta görün, görevlerini yazmak için birini seçin"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem mọi dự án trong nháy mắt, chọn một dự án để ghi việc cần làm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一览所有项目，选一个就能写下其中的待办事项"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一覽所有專案，選一個就能寫下其中的待辦事項"
          }
        }
      }
