    "그 실패를 어떻게 막거나 빠르게 회복할 수 있는가?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak byste tomu mohli předejít nebo se z toho rychle zotavit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan kan du forebygge det eller komme hurtigt på fode igen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie könntest du es verhindern oder dich schnell davon erholen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς θα μπορούσες να το αποτρέψεις ή να συνέλθεις γρήγορα;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How could you prevent it, or recover fast?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo podrías evitarlo o recuperarte rápido?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miten voisit estää sen tai toipua nopeasti?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment l’éviter, ou vous en remettre vite ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimana mencegahnya, atau cepat bangkit lagi?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come potresti evitarlo o rimediare in fretta?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その失敗をどう防ぐか、またはどう素早く立て直すか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan kan du forebygge det, eller komme deg raskt på beina igjen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe kun je het voorkomen, of snel herstellen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak temu zapobiec albo szybko się pozbierać?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como você poderia evitar isso ou se recuperar rápido?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как это предотвратить или быстро восстановиться?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur kan du förhindra det eller snabbt komma tillbaka?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะป้องกัน หรือฟื้นตัวให้เร็วได้อย่างไร"
          }
        },
        "tr" : {
          "stringUnit" : {
