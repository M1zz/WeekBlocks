    "끝나지 않은 일은 잔여물이 되어 그다음 덩어리 시간까지 갉아먹습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedokončená práce zanechává zbytky, které ukusují i z dalšího souvislého času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uafsluttet arbejde efterlader rester, der æder af den næste fokusblok."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unerledigte Arbeit hinterlässt Reste, die auch noch die nächste Fokuszeit auffressen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ημιτελής δουλειά αφήνει κατάλοιπα που τρώνε το επόμενο συνεχές διάστημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unfinished work leaves residue that eats into the next chunk of time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que queda a medias deja un residuo que se come el siguiente tramo de tiempo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskeneräinen työ jättää jäänteitä, jotka syövät seuraavaa jaksoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un travail inachevé laisse des restes qui grignotent la plage de concentration suivante."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekerjaan yang belum tuntas meninggalkan sisa yang menggerogoti sesi fokus berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro lasciato a metà lascia residui che si mangiano il tempo di concentrazione successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終わっていない作業は残りかすとなって、次のまとまった時間まで削っていきます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uavsluttet arbeid etterlater rester som spiser av den neste fokusblokken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onafgemaakt werk laat restanten achter die aan de volgende brok tijd vreten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedokończona praca zostawia ślad, który zjada następny ciągły odcinek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalho inacabado deixa resíduos que consomem o próximo período contínuo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незаконченное дело оставляет хвост, который съедает следующий цельный отрезок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofärdigt arbete lämnar rester som äter upp nästa fokustid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานที่ไม่จบจะทิ้งเศษค้าง ที่กินเข้าไปในช่วงเวลาถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitmemiş iş, sonraki odak süresini de kemiren bir kalıntı bırakır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc chưa xong để lại dư âm, ăn mòn cả quãng thời gian tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没做完的事会留下残余，连下一段大块时间也被吞掉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒做完的事會留下殘餘，連下一段大塊時間也被吃掉。"
          }
        }
      }
    },
    "끝날 때까지 진행 중으로 둡니다. 끝나면 동그라미를 눌러 주세요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zůstane rozpracované. Až skončíte, klepněte na kroužek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbliver i gang. Tryk på cirklen, når du er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt in Arbeit. Tippe auf den Kreis, wenn du fertig bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραμένει σε εξέλιξη. Πάτησε τον κύκλο όταν τελειώσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps it in progress. Tap the circle when you finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda en curso. Pulsa el círculo cuando termines."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitää sen käynnissä. Napauta ympyrää, kun olet valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste en cours jusqu’à la fin. Touchez le cercle une fois terminé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetap berjalan. Ketuk lingkarannya saat selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta in corso. Tocca il cerchio quando hai finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終わるまで進行中のままにします。終わったら丸をクリックしてください"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forblir i gang. Trykk på sirkelen når du er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijft bezig tot je klaar bent. Tik op het rondje als het af is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostaje w toku. Gdy skończysz, kliknij kółko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica em andamento até você terminar. Toque no círculo ao concluir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останется в работе до конца. Когда закончите, нажмите на кружок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förblir pågående. Tryck på cirkeln när du är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คงสถานะกำลังทำไว้ เมื่อเสร็จแล้วให้คลิกวงกลม"
