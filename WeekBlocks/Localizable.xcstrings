    "해당하는 것만 고르세요. 예시일 뿐이고, 안 골라도 됩니다.\n만든 뒤에 시각·요일·이름을 모두 고칠 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick only the ones that apply. They're just examples, and picking none is fine.\nYou can change the hours, days and names afterwards."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只选符合的就好。这些只是示例，不选也没关系。\n创建后，时间、星期和名称都可以修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只選符合的就好。這些只是範例，不選也沒關係。\n建立後，時間、星期和名稱都能修改。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle nur, was zutrifft. Es sind nur Beispiele, und es ist auch in Ordnung, keines zu wählen.\nUhrzeiten, Tage und Namen kannst du danach ändern."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当てはまるものだけを選んでください。あくまで例なので、選ばなくてもかまいません。\n作成後に時刻・曜日・名前をすべて変更できます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige solo las que te correspondan. Son solo ejemplos, y no elegir ninguna también vale.\nDespués puedes cambiar las horas, los días y los nombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne choisissez que ce qui vous concerne. Ce ne sont que des exemples, et vous pouvez n’en choisir aucun.\nVous pourrez modifier les heures, les jours et les noms ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli solo quelle che fanno al caso tuo. Sono solo esempi, e puoi anche non sceglierne nessuna.\nOrari, giorni e nomi si possono cambiare in seguito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha só as que se aplicam. São apenas exemplos, e não escolher nenhuma tudo bem.\nVocê pode mudar horários, dias e nomes depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите только то, что подходит. Это лишь примеры, можно ничего не выбирать.\nЧасы, дни и названия можно изменить потом."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte jen to, co platí. Jsou to jen příklady a klidně nemusíte vybrat nic.\nHodiny, dny a názvy můžete změnit později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg kun dem, der passer. Det er bare eksempler, og det er helt fint ikke at vælge nogen.\nDu kan ændre tider, dage og navne bagefter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίλεξε μόνο όσα ισχύουν. Είναι απλώς παραδείγματα, και μπορείς να μην επιλέξεις κανένα.\nΜπορείς να αλλάξεις ώρες, ημέρες και ονόματα αργότερα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse vain ne, jotka sopivat. Ne ovat vain esimerkkejä, eikä mitään tarvitse valita.\nVoit muuttaa tunteja, päiviä ja nimiä jälkikäteen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih hanya yang sesuai. Ini sekadar contoh, dan tidak memilih apa pun juga boleh.\nJam, hari, dan nama bisa diubah nanti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg bare dem som passer. Dette er bare eksempler, og det er helt greit å ikke velge noen.\nDu kan endre tider, dager og navn etterpå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies alleen wat van toepassing is. Het zijn maar voorbeelden, en niets kiezen mag ook.\nJe kunt de tijden, dagen en namen achteraf wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz tylko to, co pasuje. To tylko przykłady, możesz nic nie wybierać.\nGodziny, dni i nazwy zmienisz później."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj bara de som passar. De är bara exempel, och det går bra att inte välja någon.\nDu kan ändra tider, dagar och namn efteråt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกเฉพาะที่ตรงกับคุณ เป็นเพียงตัวอย่าง จะไม่เลือกเลยก็ได้\nเปลี่ยนเวลา วัน และชื่อได้ภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca size uyanları seçin. Bunlar yalnızca örnek; hiçbirini seçmemek de olur.\nSaatleri, günleri ve adları sonradan değiştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ chọn những mục phù hợp. Đây chỉ là ví dụ, không chọn mục nào cũng được.\nSau này bạn vẫn đổi được giờ, ngày và tên."
          }
        }
      }
    },
    "해마다 결제되고 언제든 해지합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billed yearly. Cancel anytime."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每年扣费，可随时取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每年扣款，可隨時取消。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jährliche Abrechnung. Jederzeit kündbar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎年請求され、いつでも解約できます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cobra anualmente. Cancela cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facturé chaque année. Résiliable à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addebito annuale. Disdici quando vuoi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cobrança anual. Cancele quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплата раз в год. Отменить можно в любой момент."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účtováno ročně. Zrušit můžete kdykoli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betales årligt. Opsig når som helst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ετήσια χρέωση. Ακύρωση οποτεδήποτε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskutetaan vuosittain. Peru milloin vain."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditagih tahunan. Batalkan kapan saja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faktureres årlig. Si opp når som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaarlijks gefactureerd. Altijd opzegbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatność co rok. Anuluj w każdej chwili."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debiteras varje år. Säg upp när du vill."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียกเก็บรายปี ยกเลิกได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yıllık ücretlendirilir. İstediğiniz zaman iptal edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanh toán hằng năm. Hủy bất cứ lúc nào."
          }
        }
      }
    },
    "해야 할 일 %lld개 · 남은 것 %lld개" : {
