    "아이폰에서도 사라집니다. 아이폰은 지우기 전에 백업을 남깁니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmizí i z iPhonu. iPhone si před smazáním uloží zálohu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den forsvinder også fra iPhone. iPhone gemmer en sikkerhedskopi, før den sletter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verschwindet auch vom iPhone. Das iPhone legt vor dem Löschen ein Backup an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα εξαφανιστεί και από το iPhone. Το iPhone κρατά αντίγραφο ασφαλείας πριν από τη διαγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will also disappear on iPhone. iPhone keeps a backup before deleting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También desaparecerá del iPhone. El iPhone guarda una copia de seguridad antes de eliminarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se katoaa myös iPhonesta. iPhone tekee varmuuskopion ennen poistamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disparaîtra aussi de l’iPhone. L’iPhone conserve une sauvegarde avant de le supprimer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini juga akan hilang dari iPhone. iPhone menyimpan cadangan sebelum menghapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparirà anche da iPhone. iPhone conserva un backup prima di eliminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneからも消えます。iPhoneは削除の前にバックアップを残します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den forsvinner også fra iPhone. iPhone tar en sikkerhetskopi før den sletter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij verdwijnt ook van je iPhone. Je iPhone bewaart een reservekopie voordat hij verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zniknie też z iPhone’a. iPhone zachowa kopię zapasową przed usunięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também vai sumir do iPhone. O iPhone guarda um backup antes de apagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он исчезнет и с iPhone. Перед удалением iPhone сохраняет резервную копию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den försvinner även från iPhone. iPhone sparar en säkerhetskopia innan den raderar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะหายไปจาก iPhone ด้วย iPhone จะเก็บข้อมูลสำรองไว้ก่อนลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’dan da kaybolur. iPhone silmeden önce yedek alır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch này cũng sẽ biến mất trên iPhone. iPhone lưu bản sao lưu trước khi xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它也会从 iPhone 上消失。iPhone 会在删除前保留备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它也會從 iPhone 上消失。iPhone 會在刪除前保留備份。"
          }
        }
      }
    },
