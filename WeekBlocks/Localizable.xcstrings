    "💡 세 가지를 다 통과한 블록만 또렷한 색으로 섭니다. 비워 두어도 저장되고, 그때는 시간표에서 주황색 '구체성 미검증'으로 남습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Plnou barvou se zobrazí jen bloky, které projdou všemi třemi kontrolami. Uložit můžete i bez nich – blok pak zůstane oranžový a označený jako nezkontrolovaný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Blokke, der består alle tre, står i fuld farve. Du kan gemme uden dem – blokken forbliver så orange og markeret som ikke tjekket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Nur Blöcke, die alle drei Prüfungen bestehen, erscheinen in voller Farbe. Du kannst auch ohne sie speichern – dann bleibt der Block orange und gilt als nicht geprüft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Τα μπλοκ που περνούν και τα τρία εμφανίζονται με πλήρες χρώμα. Μπορείς να αποθηκεύσεις και χωρίς αυτά — τότε το μπλοκ μένει πορτοκαλί, με σήμανση ότι δεν ελέγχθηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Blocks that pass all three stand in full colour. You can save without them — the block then stays orange, marked as not checked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Los bloques que superan las tres comprobaciones se muestran a todo color. Puedes guardar sin ellas: el bloque se queda en naranja, marcado como no comprobado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Kaikki kolme tarkistusta läpäisevät lohkot näkyvät täysvärisinä. Voit tallentaa ilmankin – lohko jää silloin oranssiksi ja merkitään tarkistamattomaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Seuls les blocs qui passent les trois critères s’affichent en couleur pleine. Vous pouvez enregistrer sans eux : le bloc reste alors orange, marqué comme non vérifié."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Blok yang lolos ketiganya tampil penuh warna. Anda tetap bisa menyimpan tanpanya — bloknya tetap oranye, ditandai belum dicek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 I blocchi che superano tutti e tre i controlli appaiono a colori pieni. Puoi salvare anche senza: il blocco resta arancione e segnato come non verificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 3つすべてを満たしたブロックだけがくっきりした色で表示されます。空欄のままでも保存でき、その場合はタイムテーブル上でオレンジ色の「具体性未チェック」として残ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Blokker som består alle tre, vises i full farge. Du kan lagre uten dem – blokken forblir da oransje og merket som ikke sjekket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Blokken die alle drie halen, krijgen hun volle kleur. Je kunt ook zonder bewaren — het blok blijft dan oranje, gemarkeerd als niet gecontroleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Bloki, które przejdą wszystkie trzy testy, mają pełny kolor. Możesz zapisać bez nich — blok zostanie wtedy pomarańczowy, oznaczony jako niesprawdzony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Blocos que passam nos três aparecem em cor plena. Dá para salvar sem eles — o bloco fica laranja, marcado como não verificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Блоки, прошедшие все три проверки, отображаются полным цветом. Можно сохранить и без них — тогда блок останется оранжевым с пометкой «не проверено»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Block som klarar alla tre visas i full färg. Du kan spara utan dem – då förblir blocket orange och markerat som ej kontrollerat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 บล็อกที่ผ่านครบทั้งสามข้อจะแสดงเป็นสีเต็ม จะบันทึกโดยไม่กรอกก็ได้ แต่บล็อกจะเป็นสีส้มและมีเครื่องหมายว่ายังไม่ได้ตรวจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Yalnızca üç kontrolü de geçen bloklar tam renkte görünür. Bunlar olmadan da kaydedebilirsiniz; o zaman blok turuncu kalır ve kontrol edilmemiş olarak işaretlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Khối nào vượt qua cả ba sẽ hiện đủ màu. Bạn vẫn lưu được khi bỏ trống — khi đó khối giữ màu cam, đánh dấu là chưa kiểm tra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 三项都通过的时间块才会以鲜明颜色显示。不填也能保存，但会在时间表上保持橙色，标为“具体性未检查”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 三項都通過的區塊才會以鮮明顏色顯示。不填也能儲存，但會在時間表上保持橘色，標示為「具體性未檢查」。"
          }
        }
      }
    },
