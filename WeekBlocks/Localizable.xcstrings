    "끄면 이 기기에서는 아무것도 나가지 않습니다. 이미 보낸 기록의 삭제를 원하시면 개발자에게 알려 주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je vypnuto, nic neopustí toto zařízení. Chcete-li smazat už odeslané záznamy, dejte vědět vývojáři."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår du det fra, forlader intet denne enhed. Skriv til udvikleren, hvis du vil have allerede sendte data slettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist es aus, verlässt nichts dieses Gerät. Wenn bereits gesendete Daten gelöscht werden sollen, gib dem Entwickler Bescheid."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το απενεργοποιήσεις, τίποτα δεν φεύγει από αυτή τη συσκευή. Για να διαγραφούν όσα έχουν ήδη σταλεί, ενημέρωσε τον προγραμματιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn it off and nothing leaves this device. To have already-sent records deleted, let the developer know."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo desactivas, nada sale de este dispositivo. Para que se borren los registros ya enviados, avisa al desarrollador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on pois päältä, mitään ei lähde tältä laitteelta. Jos haluat jo lähetetyt tiedot poistettaviksi, ilmoita kehittäjälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, rien ne quitte cet appareil. Pour faire supprimer les données déjà envoyées, prévenez le développeur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan, dan tidak ada yang keluar dari perangkat ini. Untuk menghapus catatan yang sudah terkirim, beri tahu pengembang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la disattivi, nulla lascia questo dispositivo. Per far eliminare i dati già inviati, scrivi allo sviluppatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、このデバイスからは何も送信されません。すでに送信された記録の削除をご希望の場合は、開発者にお知らせください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår du det av, forlater ingenting denne enheten. Gi utvikleren beskjed hvis du vil ha allerede sendte data slettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet het uit en er gaat niets meer van dit apparaat weg. Wil je al verstuurde gegevens laten verwijderen, laat het de ontwikkelaar weten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wyłączeniu nic nie opuszcza tego urządzenia. Jeśli chcesz usunąć już wysłane dane, daj znać deweloperowi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative e nada sai deste aparelho. Para apagar registros já enviados, avise o desenvolvedor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключить, с этого устройства ничего не отправляется. Чтобы удалить уже отправленные данные, напишите разработчику."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng av det så lämnar inget den här enheten. Om du vill att redan skickade uppgifter raderas, hör av dig till utvecklaren."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดแล้วจะไม่มีอะไรส่งออกจากอุปกรณ์นี้ หากต้องการให้ลบบันทึกที่ส่งไปแล้ว โปรดแจ้งนักพัฒนา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapatırsanız bu aygıttan hiçbir şey çıkmaz. Daha önce gönderilen kayıtların silinmesini istiyorsanız geliştiriciye bildirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt đi thì không có gì rời khỏi thiết bị này. Muốn xóa các bản ghi đã gửi, hãy báo cho nhà phát triển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，这台设备不会发送任何数据。如想删除已发送的记录，请告知开发者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後，這台裝置不會傳出任何資料。若想刪除已傳送的紀錄，請告知開發者。"
          }
        }
      }
    },
    "끊겼다가 돌아왔을 때 무엇부터 하면 되는지. 비워 두어도 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čím začnete, až se vrátíte. Může zůstat prázdné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad du skal gøre først, når du kommer tilbage. Du kan lade det stå tomt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Womit du anfängst, wenn du zurückkommst. Kann leer bleiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι να κάνεις πρώτα όταν επιστρέψεις. Μπορείς να το αφήσεις κενό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What to do first when you come back. You can leave it empty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué hacer primero al volver. Puedes dejarlo vacío."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä teet ensin, kun palaat. Voit jättää tyhjäksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par quoi reprendre en revenant. Vous pouvez laisser vide."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal pertama yang dilakukan saat Anda kembali. Boleh dikosongkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa fare per primo quando riprendi. Puoi lasciarlo vuoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断から戻ったとき、何から始めればいいか。空欄でもかまいません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva du skal gjøre først når du kommer tilbake. Du kan la det stå tomt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je als eerste doet als je terugkomt. Mag leeg blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od czego zacząć po powrocie. Możesz zostawić puste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que fazer primeiro quando você voltar. Pode deixar em branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С чего начать, когда вернётесь после перерыва. Можно оставить пустым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad du ska göra först när du kommer tillbaka. Du kan lämna det tomt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อกลับมาหลังถูกขัดจังหวะ ควรเริ่มจากอะไร เว้นว่างไว้ก็ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri döndüğünüzde ilk ne yapacağınız. Boş bırakabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc cần làm trước tiên khi quay lại. Có thể để trống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断后回来时，要先做什么。可以留空。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中斷後回來時，要先做什麼。可以留空。"
          }
        }
      }
    },
    "끊기면 다시 올라와야 합니다. 방해 없는 시간에 두세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když vás někdo vyruší, musíte se do toho znovu dostávat. Zařaďte to do nerušeného času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliver du afbrudt, skal du kæmpe dig ind i det igen. Læg det i uforstyrret tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirst du unterbrochen, musst du dich wieder hineinarbeiten. Plane es in ungestörte Zeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν σε διακόψουν, πρέπει να ξαναμπείς στο κλίμα. Βάλ’ το σε χρόνο χωρίς ενοχλήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you're interrupted you have to climb back in. Put it in undisturbed time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te interrumpen, tienes que volver a coger el ritmo. Ponlo en un tiempo sin interrupciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos sinut keskeytetään, joudut palaamaan alkuun. Sijoita tämä häiriöttömään aikaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous êtes interrompu, il faut s’y remettre. Placez-le dans un temps sans dérangement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau terganggu, Anda harus memanaskan diri lagi. Taruh di waktu yang tidak terganggu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vieni interrotto devi riprendere il filo. Mettila in un momento senza disturbi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断されると、また集中し直す必要があります。邪魔の入らない時間に置きましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir du avbrutt, må du jobbe deg inn i det igjen. Legg det i uforstyrret tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word je onderbroken, dan moet je er weer helemaal in komen. Zet het in ongestoorde tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli ktoś przerwie, trzeba będzie znowu się wdrożyć. Umieść to w niezakłóconym czasie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se for interrompido, você terá que subir tudo de novo. Coloque num horário sem interrupções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если прервут, придётся заново входить в работу. Поставьте в спокойное время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir du avbruten måste du ta dig in i det igen. Lägg det i ostörd tid."
