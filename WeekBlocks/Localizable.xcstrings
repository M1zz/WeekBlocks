          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ — %2$@와 %3$@시간"
          }
        }
      }
    },
    "%@ — 눌러서 보기·수정 · 드래그해서 시각 이동(15분 단위) · 우클릭으로 더 보기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — click to view and edit · drag to move the time (15-minute steps) · right-click for more"
          }
        }
      }
    },
    "%@ — 눌러서 수정 · 좌우로 끌어 시각 이동(15분 단위) · 위아래로 끌어 다른 요일로 · 우클릭으로 더 보기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — click to edit · drag sideways to move the time (15-minute steps) · drag up or down for another day · right-click for more"
