    "떠 둔 벌과 iCloud가 준 벌 중 **더 최근에 손댄 쪽**을 세웁니다. 겹친 할 일도 함께 정리합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechá verzi, která byla **upravena naposledy** – místní stav, nebo ten z iCloudu. Duplicitní úkoly se také sloučí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beholder den kopi, der er **ændret senest** – den lokale kopi eller den, iCloud har sendt. Dobbelte opgaver flettes også."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält die Version, die **zuletzt bearbeitet** wurde – den lokalen Stand oder den aus iCloud. Doppelte Aufgaben werden ebenfalls zusammengeführt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατά όποιο αντίγραφο **άλλαξε πιο πρόσφατα** — το τοπικό στιγμιότυπο ή αυτό που έστειλε το iCloud. Οι διπλές εργασίες συγχωνεύονται επίσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps whichever copy was **touched more recently** — the local snapshot or the one iCloud sent. Duplicate to-dos get merged too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la copia que se **modificó más recientemente**: la copia local o la que envió iCloud. Las tareas duplicadas también se combinan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilyttää sen kopion, jota on **muokattu viimeksi** – paikallisen tilannekuvan tai iCloudin lähettämän. Myös päällekkäiset tehtävät yhdistetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve la version **modifiée le plus récemment** : la copie locale ou celle envoyée par iCloud. Les tâches en double sont aussi fusionnées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mempertahankan salinan yang **terakhir diubah** — cadangan lokal atau yang dikirim iCloud. Tugas ganda juga digabungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la copia **modificata più di recente**, quella locale o quella inviata da iCloud. Anche le attività duplicate vengono unite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルの控えとiCloudから届いたものの中から、**最近編集した方**を残します。重複したやることもまとめて整理します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beholder den kopien som er **endret sist** – den lokale kopien eller den iCloud sendte. Dupliserte oppgaver slås også sammen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behoudt de kopie die **het laatst is aangepast** — de lokale momentopname of die van iCloud. Dubbele taken worden ook samengevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostawia kopię **zmienianą ostatnio** — lokalną migawkę albo tę z iCloud. Zduplikowane zadania też zostaną scalone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém a cópia que foi **alterada por último** — o instantâneo local ou a que veio do iCloud. Tarefas duplicadas também são unidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет копию, которую **меняли последней**, — локальный снимок или присланную iCloud. Повторяющиеся задачи тоже объединяются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåller den kopia som **ändrades senast** – den lokala ögonblicksbilden eller den som iCloud skickade. Dubbletter av uppgifter slås också ihop."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บฉบับที่**แก้ไขล่าสุด** ระหว่างสำเนาในเครื่องกับฉบับที่ iCloud ส่งมา สิ่งที่ต้องทำที่ซ้ำกันจะถูกรวมด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**En son düzenlenen** kopyayı tutar: yerel kopya ya da iCloud’dan gelen. Yinelenen görevler de birleştirilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ bản nào được **chỉnh sửa gần đây hơn** — bản lưu cục bộ hay bản iCloud gửi về. Việc cần làm trùng lặp cũng được gộp lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在本地快照与 iCloud 传来的版本中，保留**最近改动过的那一份**。重复的待办事项也会一并合并。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在本機快照與 iCloud 傳來的版本中，保留**最近更動過的那一份**。重複的待辦事項也會一併合併。"
          }
        }
      }
    },
