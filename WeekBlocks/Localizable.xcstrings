            "state" : "translated",
            "value" : "Pega líneas de fecha (2026-10-06 19:00~21:00) y líneas de sesión (Sesión 1 · 2H · nota). Se emparejan en orden. La hora es opcional."
          }
        },
        "fi" : {
          "stringUnit" : {
