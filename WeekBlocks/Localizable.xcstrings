    "점심 먹는 동안은 회사 시간이 아닙니다. 겹친 만큼 회사에서 뺍니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když jste na obědě, nejste v práci. Překryv se odečte od pracovní doby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens du holder frokost, er du ikke på arbejde. Overlappet trækkes fra arbejdstiden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Mittagessen bist du nicht bei der Arbeit. Die Überschneidung wird von der Arbeitszeit abgezogen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο τρως μεσημεριανό, δεν δουλεύεις. Η επικάλυψη αφαιρείται από τον χρόνο της δουλειάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While you're at lunch, you're not at work. The overlap is taken out of work time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras comes, no estás trabajando. El tiempo solapado se descuenta del trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lounaalla et ole töissä. Päällekkäinen aika vähennetään työajasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant le déjeuner, vous n’êtes pas au travail. Le chevauchement est retiré du temps de travail."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat makan siang, Anda tidak sedang bekerja. Waktu yang bertumpuk dikurangkan dari jam kerja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre pranzi non sei al lavoro. La sovrapposizione viene tolta dalle ore di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昼食の間は会社の時間ではありません。重なった分を会社から差し引きます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens du spiser lunsj, er du ikke på jobb. Overlappet trekkes fra arbeidstiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens de lunch ben je niet aan het werk. De overlap gaat van de werktijd af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy jesz obiad, nie pracujesz. Nakładający się czas jest odejmowany od pracy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto você almoça, não está trabalhando. A sobreposição é descontada do tempo de trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока вы обедаете, вы не работаете. Пересечение вычитается из рабочего времени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medan du äter lunch är du inte på jobbet. Överlappningen dras av från arbetstiden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระหว่างพักกินมื้อกลางวัน คุณไม่ได้ทำงาน เวลาที่ทับกันจะถูกหักออกจากเวลางาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle yemeğindeyken işte değilsiniz. Çakışan süre iş süresinden düşülür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong lúc ăn trưa, bạn không làm việc. Phần chồng nhau được trừ khỏi giờ làm việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吃午饭时不算上班时间。重叠的部分会从工作时间中扣除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吃午餐時不算上班時間。重疊的部分會從工作時間扣除。"
          }
        }
      }
    },
