    },
    "짜 둔 이 한 주가 아이폰 앱 ‘욕망의 무지개’에 그대로 나타납니다. 다음 일정이 몇 시인지 주머니에서 바로 봅니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The week you’ve planned shows up as is in the iPhone app “Rainbow of Desire”. See when your next plan starts right from your pocket."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你排好的这一周会原样出现在 iPhone App“欲望彩虹”中。下一个安排几点开始，从口袋里就能马上看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你排好的這一週會原封不動地出現在 iPhone App「欲望彩虹」中。下一個安排幾點開始，從口袋裡就能馬上看到。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geplante Woche erscheint unverändert in der iPhone-App „Rainbow of Desire“. So siehst du direkt aus der Tasche, wann dein nächster Plan beginnt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組んでおいたこの1週間が、iPhoneアプリ「Rainbow of Desire」にそのまま表示されます。次の予定が何時か、ポケットからすぐ確認できます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La semana que has planificado aparece tal cual en la app de iPhone “Rainbow of Desire”. Mira cuándo empieza tu próximo plan sin sacar más que el móvil del bolsillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La semaine planifiée apparaît telle quelle dans l’app iPhone « Rainbow of Desire ». Voyez quand commence votre prochain plan, directement depuis votre poche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La settimana che hai pianificato compare così com’è nell’app per iPhone “Rainbow of Desire”. Vedi quando inizia il prossimo impegno direttamente dalla tasca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A semana que você planejou aparece do jeito que está no app de iPhone “Rainbow of Desire”. Veja quando começa o próximo plano direto do bolso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спланированная неделя появляется как есть в приложении «Rainbow of Desire» для iPhone. Когда следующий план — видно прямо из кармана."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naplánovaný týden se beze změny zobrazí v aplikaci pro iPhone „Rainbow of Desire“. Kdy začíná váš další plán, uvidíte přímo z kapsy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den uge, du har planlagt, vises præcis som den er i iPhone-appen “Rainbow of Desire”. Se, hvornår din næste plan starter, direkte fra lommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εβδομάδα που προγραμμάτισες εμφανίζεται όπως είναι στην εφαρμογή iPhone «Rainbow of Desire». Δες πότε ξεκινά το επόμενο πλάνο σου κατευθείαν από την τσέπη σου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suunnittelemasi viikko näkyy sellaisenaan iPhone-apissa ”Rainbow of Desire”. Näet suoraan taskustasi, milloin seuraava suunnitelma alkaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minggu yang Anda rencanakan muncul apa adanya di app iPhone “Rainbow of Desire”. Lihat kapan rencana berikutnya dimulai langsung dari saku Anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uken du har planlagt, vises akkurat som den er i iPhone-appen «Rainbow of Desire». Se når neste plan starter, rett fra lomma."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De week die je hebt gepland, verschijnt precies zo in de iPhone-app ‘Rainbow of Desire’. Zie meteen uit je broekzak wanneer je volgende plan begint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplanowany tydzień pojawia się bez zmian w aplikacji „Rainbow of Desire” na iPhonie. Kiedy zaczyna się następny plan, sprawdzisz prosto z kieszeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veckan du har planerat syns precis som den är i iPhone-appen ”Rainbow of Desire”. Se när nästa plan börjar direkt ur fickan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัปดาห์ที่คุณวางแผนไว้จะแสดงตามเดิมในแอป iPhone “Rainbow of Desire” ดูได้ทันทีจากในกระเป๋าว่าแผนถัดไปเริ่มเมื่อไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planladığınız hafta, iPhone uygulaması “Rainbow of Desire”da olduğu gibi görünür. Bir sonraki planınızın ne zaman başladığını doğrudan cebinizden görün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuần bạn đã lên kế hoạch hiện y nguyên trong ứng dụng iPhone “Rainbow of Desire”. Rút điện thoại ra là biết ngay kế hoạch tiếp theo bắt đầu lúc mấy giờ."
          }
        }
      }
    },
