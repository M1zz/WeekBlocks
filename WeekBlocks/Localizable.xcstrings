        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una riga alla volta in Attività, in fondo alla schermata. Non serve ancora decidere quando."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma por linha em Tarefas, na parte de baixo da tela. Ainda não precisa decidir quando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По строке в «Задачи» внизу экрана. Когда делать, решать пока не нужно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po řádcích do Úkolů dole na obrazovce. Kdy, zatím rozhodovat nemusíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én linje ad gangen i Opgaver nederst på skærmen. Du behøver ikke beslutte hvornår endnu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία γραμμή τη φορά στις Εργασίες, στο κάτω μέρος της οθόνης. Δεν χρειάζεται να αποφασίσεις ακόμη πότε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivi kerrallaan Tehtäviin näytön alareunassa. Aikaa ei tarvitse vielä päättää."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu per baris di Tugas, di bagian bawah layar. Belum perlu menentukan kapan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én linje om gangen i Oppgaver nederst på skjermen. Du trenger ikke bestemme når ennå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regel voor regel in Taken, onder in het scherm. Wanneer, hoef je nog niet te bepalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po jednej linijce w „Zadaniach” na dole ekranu. Kiedy, nie musisz jeszcze decydować."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rad i taget i Uppgifter längst ned på skärmen. Du behöver inte bestämma när än."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทีละบรรทัดในสิ่งที่ต้องทำที่ด้านล่างของหน้าจอ ยังไม่ต้องตัดสินใจว่าจะทำเมื่อไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranın altındaki Görevler’e satır satır. Ne zaman yapacağınıza henüz karar vermeniz gerekmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từng dòng một vào Việc cần làm ở cuối màn hình. Chưa cần quyết định khi nào làm."
          }
        }
      }
    },
