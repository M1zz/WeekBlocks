    "ISO 8601 기준으로 주를 계산합니다. 지역 설정이 바뀌어도 월요일 시작이 유지됩니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weeks follow ISO 8601. They keep starting on Monday even if your region settings change."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 ISO 8601 计算周。即使地区设置更改，每周仍从星期一开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依 ISO 8601 計算週次。即使地區設定改變，每週仍從星期一開始。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wochen folgen ISO 8601. Sie beginnen immer am Montag, auch wenn sich deine Regionseinstellungen ändern."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週はISO 8601に基づいて計算します。地域の設定が変わっても月曜始まりのままです。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las semanas siguen la norma ISO 8601. Siempre empiezan en lunes, aunque cambie tu configuración regional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les semaines suivent la norme ISO 8601. Elles commencent toujours le lundi, même si vos réglages régionaux changent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le settimane seguono lo standard ISO 8601 e iniziano sempre di lunedì, anche se cambi le impostazioni della zona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As semanas seguem a ISO 8601. Continuam começando na segunda-feira mesmo que os ajustes de região mudem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недели считаются по ISO 8601 и всегда начинаются с понедельника, даже если изменятся региональные настройки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týdny se řídí normou ISO 8601. Vždy začínají pondělím, i když změníte nastavení oblasti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uger følger ISO 8601. De starter altid mandag, også hvis dine områdeindstillinger ændres."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εβδομάδες ακολουθούν το ISO 8601. Ξεκινούν πάντα Δευτέρα, ακόμη κι αν αλλάξουν οι ρυθμίσεις περιοχής."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viikot noudattavat ISO 8601 -standardia. Ne alkavat aina maanantaista, vaikka alueasetukset muuttuisivat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minggu mengikuti ISO 8601. Minggu tetap dimulai hari Senin meski pengaturan wilayah Anda berubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uker følger ISO 8601. De starter alltid på mandag, også hvis regioninnstillingene dine endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weken volgen ISO 8601. Ze beginnen op maandag, ook als je regio-instellingen veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tygodnie liczone są według ISO 8601. Zawsze zaczynają się w poniedziałek, nawet jeśli zmienisz ustawienia regionu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veckor följer ISO 8601. De börjar alltid på måndag även om dina regioninställningar ändras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัปดาห์นับตามมาตรฐาน ISO 8601 และเริ่มวันจันทร์เสมอ แม้จะเปลี่ยนการตั้งค่าภูมิภาค"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haftalar ISO 8601’e göre hesaplanır. Bölge ayarlarınız değişse bile hep pazartesi başlar."
          }
        },
        "vi" : {
