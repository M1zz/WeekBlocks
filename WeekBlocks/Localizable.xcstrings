          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — คลิกเพื่อแก้ไข · ลากซ้ายขวาเพื่อย้ายเวลา (ทีละ 15 นาที) · ลากขึ้นลงเพื่อย้ายไปวันอื่น · คลิกขวาเพื่อดูเพิ่มเติม"
          }
        },
        "tr" : {
