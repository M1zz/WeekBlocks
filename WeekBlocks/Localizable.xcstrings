    "정확한 요일·시간 없이 주 단위로만 추적합니다. 자유 시간 계산에는 그대로 반영됩니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracked by the week, with no fixed day or hour. It still counts fully against your free time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只按周追踪，不指定具体的星期和时间。仍会完整计入空闲时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只按週追蹤，不指定確切的星期與時間。仍會完整計入自由時間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird pro Woche erfasst, ohne festen Tag oder feste Uhrzeit. Es zählt trotzdem voll gegen deine freie Zeit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決まった曜日・時刻なしで、週単位でだけ追跡します。空き時間の計算にはそのまま反映されます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se controla por semanas, sin día ni hora fijos. Aun así, cuenta por completo en tu tiempo libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivi à la semaine, sans jour ni heure fixes. Le temps est tout de même entièrement déduit de votre temps libre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tiene il conto per settimana, senza giorno né ora fissi. Viene comunque sottratta per intero dal tempo libero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhada por semana, sem dia ou hora fixos. Ainda conta integralmente no seu tempo livre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитывается по неделям, без точного дня и часа. Из свободного времени вычитается полностью."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduje se po týdnech, bez pevného dne či hodiny. Z volného času se přesto odečítá celé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følges pr. uge uden fast dag eller time. Den tæller stadig fuldt ud i din ledige tid."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολουθείται ανά εβδομάδα, χωρίς σταθερή ημέρα ή ώρα. Αφαιρείται κανονικά από τον ελεύθερο χρόνο σου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seurataan viikoittain ilman kiinteää päivää tai tuntia. Se vähennetään silti kokonaan vapaasta ajasta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dilacak per minggu, tanpa hari atau jam tetap. Tetap dihitung penuh terhadap waktu luang Anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følges per uke uten fast dag eller klokkeslett. Den teller likevel fullt ut mot den ledige tiden din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijgehouden per week, zonder vaste dag of uur. Telt nog steeds volledig mee in je vrije tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczone tygodniowo, bez stałego dnia i godziny. Nadal w całości odejmowane od wolnego czasu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följs upp per vecka, utan fast dag eller timme. Den dras ändå fullt ut från din fria tid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตามเป็นรายสัปดาห์ โดยไม่กำหนดวันหรือชั่วโมง แต่ยังหักออกจากเวลาว่างเต็มจำนวน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belirli bir gün ya da saat olmadan haftalık olarak izlenir. Yine de boş zamanınızdan tamamen düşülür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi theo tuần, không cố định ngày hay giờ. Vẫn được tính đầy đủ vào thời gian trống."
          }
        }
      }
    },
