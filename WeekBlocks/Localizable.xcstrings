    "기념일·마감일처럼 그날의 일이지만 시간을 차지하지 않습니다. 남은 시간에서 빠지지 않고, 그날 맨 위에 따로 섭니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For things like birthdays or deadlines that belong to the day but don't take up time. They don't count against your free time and sit at the top of the day."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像纪念日、截止日这类属于当天、但不占时间的事。不会从剩余时间中扣除，会单独显示在当天最上方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像紀念日、截止日這類屬於當天、但不占時間的事。不會從剩餘時間中扣除，會單獨顯示在當天最上方。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Dinge wie Geburtstage oder Fristen, die zum Tag gehören, aber keine Zeit belegen. Sie gehen nicht von deiner freien Zeit ab und stehen oben im Tag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記念日や締め切りのように、その日のことだけど時間は取らないもの。空き時間から引かれず、その日のいちばん上に表示されます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cosas como cumpleaños o fechas de entrega que pertenecen al día pero no ocupan tiempo. No restan de tu tiempo libre y se colocan arriba del todo en el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les anniversaires ou les échéances qui appartiennent au jour sans occuper de temps. Ils ne sont pas déduits de votre temps libre et s’affichent en haut de la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per compleanni o scadenze che appartengono al giorno ma non occupano tempo. Non si sottraggono al tempo libero e restano in cima al giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para coisas como aniversários ou prazos que pertencem ao dia mas não ocupam tempo. Não descontam do seu tempo livre e ficam no topo do dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для дней рождения, дедлайнов и всего, что относится к дню, но не занимает времени. Не вычитается из свободного времени и стоит отдельно вверху дня."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro věci jako narozeniny nebo termíny, které ke dni patří, ale nezabírají čas. Neubírají z volného času a zobrazují se nahoře ve dni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til ting som fødselsdage eller deadlines, der hører til dagen, men ikke tager tid. De trækkes ikke fra din ledige tid og står øverst på dagen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για πράγματα όπως γενέθλια ή προθεσμίες που ανήκουν στην ημέρα αλλά δεν πιάνουν χρόνο. Δεν αφαιρούνται από τον ελεύθερο χρόνο σου και εμφανίζονται στην κορυφή της ημέρας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esimerkiksi syntymäpäiville tai määräpäiville, jotka kuuluvat päivään mutta eivät vie aikaa. Ne eivät vähennä vapaata aikaa ja näkyvät päivän ylimpänä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk hal seperti ulang tahun atau tenggat yang melekat pada hari itu tapi tidak memakai waktu. Tidak mengurangi waktu luang dan berada di atas hari itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For ting som bursdager eller frister som hører til dagen, men ikke tar tid. De trekkes ikke fra den ledige tiden din og står øverst på dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor dingen als verjaardagen of deadlines die bij de dag horen maar geen tijd innemen. Ze gaan niet af van je vrije tijd en staan bovenaan de dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na urodziny czy terminy, które należą do dnia, ale nie zajmują czasu. Nie odejmują wolnego czasu i stoją osobno na górze dnia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För saker som födelsedagar eller deadlines som hör till dagen men inte tar tid. De dras inte från din fria tid och ligger överst på dagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับวันเกิดหรือกำหนดส่งที่เป็นของวันนั้นแต่ไม่ใช้เวลา ไม่หักออกจากเวลาว่าง และอยู่ด้านบนสุดของวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğum günleri ya da son tarihler gibi o güne ait ama zaman kaplamayan şeyler için. Boş zamanınızdan düşülmez ve günün en üstünde durur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dành cho những thứ như sinh nhật hay hạn chót thuộc về ngày đó nhưng không chiếm thời gian. Không trừ vào thời gian trống và nằm riêng ở đầu ngày."
          }
        }
      }
    },
