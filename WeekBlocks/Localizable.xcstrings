        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med kort tid satt av blir den ikke ferdig her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook kort ingepland is het hier niet af."
          }
        },
        "pl" : {
