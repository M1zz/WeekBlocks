    "개수 제한 없이 적고 배치합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write and place as many as you like."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不限数量，随意写、随意排。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
