            "state" : "translated",
            "value" : "A que horas, todo dia"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во сколько каждый день"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V kolik každý den"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilket tidspunkt hver dag"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι ώρα κάθε μέρα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mihin aikaan joka päivä"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jam berapa setiap hari"
