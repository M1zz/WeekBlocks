    "몸으로 하는 일은 나눠 해도 쌓입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Physical work adds up even when you split it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体力活分开做也会累积。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "體力活分開做也會累積。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körperliche Arbeit summiert sich, auch wenn du sie aufteilst."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体を動かす作業は、分けてやっても積み上がります。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo físico se acumula aunque lo dividas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail physique s’accumule même quand vous le fractionnez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lavoro fisico si accumula anche se lo dividi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalho físico se acumula mesmo quando você divide."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Физическая работа накапливается, даже если её разбить."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyzická práce se sčítá, i když ji rozdělíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fysisk arbejde hober sig op, selv når du deler det op."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σωματική δουλειά αθροίζεται ακόμη κι αν τη μοιράσεις."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyysinen työ kasautuu, vaikka sen pilkkoisi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja fisik tetap menumpuk meski dipecah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fysisk arbeid hoper seg opp selv når du deler det opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lichamelijk werk telt op, ook als je het opsplitst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praca fizyczna sumuje się, nawet gdy ją podzielisz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fysiskt arbete tär även om du delar upp det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานที่ใช้แรงกายสะสมขึ้นแม้จะแบ่งทำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedensel işler bölseniz de birikir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc chân tay vẫn cộng dồn dù có chia nhỏ."
          }
        }
      }
    },
    "몸으로 하는 일이라 시동이 없습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's physical, so there's no spin-up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是体力活，不需要预热。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是體力活，不需要暖機。"
