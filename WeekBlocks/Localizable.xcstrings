    "한 번 결제로 계속 씁니다. 구독이 아닙니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplaťte jednou a máte navždy. Žádné předplatné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang, og behold det. Ikke et abonnement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal zahlen, für immer behalten. Kein Abo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πληρώνεις μία φορά, το κρατάς. Δεν είναι συνδρομή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay once, keep it. Not a subscription."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga una vez y es tuyo. No es una suscripción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksa kerran, pidä aina. Ei tilaus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payez une fois, gardez-le. Pas d’abonnement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayar sekali, milik Anda selamanya. Bukan langganan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paghi una volta e resta tuo. Non è un abbonamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回の支払いでずっと使えます。サブスクリプションではありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang, behold det. Ikke et abonnement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén keer betalen, voor altijd van jou. Geen abonnement."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płacisz raz i masz na zawsze. To nie subskrypcja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague uma vez e é seu. Não é assinatura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платите один раз — пользуйтесь всегда. Это не подписка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betala en gång, behåll den. Ingen prenumeration."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จ่ายครั้งเดียว ใช้ได้ตลอด ไม่ใช่การสมัครสมาชิก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kez ödeyin, sizin olsun. Abonelik değildir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả một lần, dùng mãi. Không phải gói đăng ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次付费，永久使用。不是订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次付費，永久使用。不是訂閱。"
          }
        }
      }
    },
    "한 번 사면 끝입니다. 구독이 아니고, 같은 Apple 계정의 다른 맥에서도 열립니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden nákup a hotovo. Není to předplatné a odemkne se na každém dalším Macu se stejným Apple účtem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ét køb, så er det klaret. Det er ikke et abonnement, og det låser op på alle dine andre Mac-computere med samme Apple-konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal kaufen, fertig. Kein Abo – und auf jedem anderen Mac mit demselben Apple Account freigeschaltet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία αγορά και τελείωσες. Δεν είναι συνδρομή, και ξεκλειδώνεται σε κάθε άλλο Mac με τον ίδιο Λογαριασμό Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One purchase, done. It isn't a subscription, and it unlocks on any other Mac on the same Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sola compra y listo. No es una suscripción, y se desbloquea en cualquier otro Mac con la misma cuenta de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi osto ja valmista. Se ei ole tilaus, ja se avautuu kaikilla muilla Maceilla samalla Apple-tilillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul achat, et c’est tout. Ce n’est pas un abonnement, et il se déverrouille sur vos autres Mac associés au même compte Apple."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekali beli, beres. Bukan langganan, dan terbuka juga di Mac lain dengan Akun Apple yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo acquisto e basta. Non è un abbonamento e si sblocca su qualsiasi altro Mac con lo stesso Apple Account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度買えば終わりです。サブスクリプションではなく、同じApple Accountの他のMacでも利用できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett kjøp, så er det gjort. Det er ikke et abonnement, og det låses opp på alle andre Mac-maskiner med samme Apple-konto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén aankoop en klaar. Het is geen abonnement, en het ontgrendelt op elke andere Mac met hetzelfde Apple Account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden zakup i gotowe. To nie subskrypcja, a funkcja odblokuje się na innych Macach z tym samym Apple Account."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma compra e pronto. Não é assinatura, e desbloqueia em qualquer outro Mac com a mesma Conta Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна покупка — и всё. Это не подписка, и функция откроется на других Mac с тем же Apple Account."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett köp, sedan är det klart. Det är ingen prenumeration, och det låses upp på alla andra Mac-datorer med samma Apple-konto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซื้อครั้งเดียวจบ ไม่ใช่การสมัครสมาชิก และปลดล็อกบน Mac เครื่องอื่นที่ใช้บัญชี Apple เดียวกันด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek satın alma, o kadar. Abonelik değildir; aynı Apple Hesabı’ndaki diğer Mac’lerde de kilidi açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mua một lần là xong. Không phải gói đăng ký, và được mở khóa trên mọi máy Mac khác dùng cùng Tài khoản Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "买一次就好。不是订阅，同一 Apple 账户的其他 Mac 也能解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "買一次就好。不是訂閱，同一個 Apple 帳號的其他 Mac 也能解鎖。"
          }
        }
      }
    },
    "한 번에 못 끝내는 크기입니다. 끝이 닫히도록 더 쪼개지 않으면 '하다 만 상태'가 다음 시간까지 따라옵니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle je příliš velké na to, abyste to dokončili najednou. Pokud to nerozdělíte na části, které jde uzavřít, napůl hotový stav vás bude pronásledovat i do další hodiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er for stor til at blive færdig i ét hug. Medmindre du deler den op i noget, der kan lukkes, følger den halvfærdige tilstand dig ind i den næste time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist zu groß, um es in einem Rutsch zu erledigen. Wenn du es nicht in abschließbare Teile zerlegst, verfolgt dich der halbfertige Zustand bis in die nächste Stunde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό είναι πολύ μεγάλο για να τελειώσει με μία φορά. Αν δεν το χωρίσεις σε κάτι που κλείνει, η μισοτελειωμένη κατάσταση σε ακολουθεί και στην επόμενη ώρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is too big to finish in one go. Unless you split it down to something that closes, the half-done state follows you into the next hour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es demasiado grande para terminarlo de una vez. Si no lo divides hasta algo que se pueda cerrar, lo que quede a medias te seguirá a la hora siguiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on liian suuri valmistumaan yhdellä kertaa. Ellet pilko sitä valmistuvaksi kokonaisuudeksi, keskeneräisyys seuraa sinua seuraavaan tuntiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est trop gros pour être terminé d’une traite. Si vous ne le découpez pas en morceaux qui se bouclent, l’état « à moitié fait » vous suivra dans l’heure suivante."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini terlalu besar untuk selesai sekali jalan. Kecuali dipecah sampai bisa tuntas, keadaan setengah jadi akan mengikuti Anda ke jam berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È troppo grande per finirla in una volta. Se non la suddividi in qualcosa che si chiude, lo stato di lavoro a metà ti segue nell’ora successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度では終わらない大きさです。締めくくれるまで分けないと、「やりかけの状態」が次の時間までついてきます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne er for stor til å bli ferdig i én omgang. Med mindre du deler den opp i noe som kan avsluttes, følger den halvferdige tilstanden deg inn i neste time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is te groot om in één keer af te ronden. Splits je het niet op tot iets wat je kunt afronden, dan neem je de half-af-toestand mee naar het volgende uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To za dużo, by skończyć za jednym razem. Jeśli nie podzielisz tego do rozmiaru, który się domyka, stan „zrobione w połowie” pójdzie za Tobą do następnej godziny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é grande demais para terminar de uma vez. Se você não dividir até algo que se feche, o estado de meio feito vai junto para a hora seguinte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это слишком много, чтобы закончить за раз. Если не разбить до размера, который закрывается, недоделанное потянется за вами в следующий час."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här är för stort för att bli klart i ett svep. Om du inte delar upp det i något som går att avsluta följer det halvfärdiga med dig in i nästa timme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานนี้ใหญ่เกินกว่าจะจบในครั้งเดียว ถ้าไม่แบ่งให้เล็กจนจบได้ สภาพทำค้างจะตามคุณไปถึงชั่วโมงถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, tek seferde bitmeyecek kadar büyük. Kapanabilen parçalara bölmezseniz yarım kalmışlık hissi sizi bir sonraki saate kadar izler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc này quá lớn để làm xong trong một lần. Nếu không chia nhỏ đến mức khép lại được, trạng thái làm dở sẽ theo bạn sang giờ tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个大小无法一次完成。如果不拆分到能收尾的程度，“做到一半”的状态会一直跟到下一个时段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個大小無法一次完成。若不拆分到能收尾的程度，「做到一半」的狀態會一路跟到下一個時段。"
          }
        }
      }
    },
    "한 시간에 셋 이상 나란히 서 있습니다 — 옮기거나 빼면 두 줄로 돌아옵니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento čas sdílejí tři nebo více plánů – jeden přesuňte nebo vynechte, abyste se vrátili na dva"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre eller flere planer deler dette tidsrum — flyt eller fjern én for at komme tilbage til to"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei oder mehr Pläne teilen sich diese Zeit – verschiebe oder entferne einen, um wieder auf zwei zu kommen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τρία ή περισσότερα πλάνα μοιράζονται αυτή την ώρα — μετακίνησε ή αφαίρεσε ένα για να γυρίσεις στα δύο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three or more plans share this time — move or drop one to get back to two"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres o más planes comparten este horario: mueve o quita uno para volver a dos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tähän aikaan on kolme tai useampi suunnitelma – siirrä tai jätä yksi pois, niin niitä on taas kaksi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois plans ou plus partagent ce créneau — déplacez-en ou retirez-en un pour revenir à deux"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga rencana atau lebih berbagi waktu ini — pindahkan atau lewati satu agar kembali jadi dua"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre o più piani condividono questo orario: spostane o togline uno per tornare a due"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ時間に3件以上並んでいます — 移動するか外すと2列に戻ります"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre eller flere planer deler dette tidsrommet – flytt eller fjern én for å komme tilbake til to"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drie of meer plannen delen deze tijd — verplaats of laat er een vallen om terug te gaan naar twee"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym czasie są trzy plany lub więcej — przenieś lub pomiń jeden, by zostały dwa"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três ou mais planos dividem este horário — mova ou tire um para voltar a dois"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На это время приходится три плана или больше — перенесите или уберите один, чтобы осталось два"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre eller fler planer delar den här tiden – flytta eller stryk en för att komma tillbaka till två"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีสามแผนขึ้นไปในเวลาเดียวกัน — ย้ายหรือตัดออกหนึ่งรายการเพื่อกลับเป็นสองคอลัมน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu zamanı üç ya da daha fazla plan paylaşıyor — ikiye dönmek için birini taşıyın ya da çıkarın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có từ ba kế hoạch trở lên trong cùng khoảng giờ — dời hoặc bỏ một mục để về lại hai"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一时段有三个以上并列 — 移走或删掉一个就会回到两栏"
