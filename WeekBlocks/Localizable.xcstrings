    "캘린더에서 사라진 일정 %lld개를 지울까요?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazat bloky, jejichž události v kalendáři zmizely (%lld)?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du slette %lld blokke, hvis begivenheder er væk fra kalenderen?"
          }
        },
        "de" : {
          "stringUnit" : {
