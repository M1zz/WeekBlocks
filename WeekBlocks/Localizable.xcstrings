    "달마다 결제되고 언제든 해지합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billed monthly. Cancel anytime."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按月计费，随时可取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按月計費，隨時可取消。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monatliche Abrechnung. Jederzeit kündbar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月請求され、いつでも解約できます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cobra mensualmente. Cancela cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facturé chaque mois. Résiliable à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addebito mensile. Disdici quando vuoi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cobrança mensal. Cancele quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплата раз в месяц. Отменить можно в любой момент."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účtováno měsíčně. Zrušit můžete kdykoli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betales månedligt. Opsig når som helst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μηνιαία χρέωση. Ακύρωση οποτεδήποτε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskutetaan kuukausittain. Peru milloin vain."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditagih bulanan. Batalkan kapan saja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faktureres månedlig. Si opp når som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maandelijks gefactureerd. Altijd opzegbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatność co miesiąc. Anuluj w każdej chwili."
          }
        },
        "sv" : {
