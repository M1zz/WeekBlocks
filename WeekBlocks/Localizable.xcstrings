    "되살리기는 없는 것만 더합니다. 지금 있는 것은 바꾸지 않습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovení jen doplní, co chybí. Nic z toho, co teď máte, nezmění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At hente tilbage tilføjer kun det, der mangler. Det, du har nu, bliver ikke ændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurückholen fügt nur hinzu, was fehlt. Was jetzt da ist, bleibt unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επαναφορά προσθέτει μόνο ό,τι λείπει. Δεν αλλάζει τίποτα από όσα έχετε τώρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringing back only adds what's missing. It doesn't change anything you have now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperar solo añade lo que falta. No cambia nada de lo que tienes ahora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautus lisää vain puuttuvat. Nykyisiin tietoihin se ei koske."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rétablissement ajoute seulement ce qui manque. Il ne modifie rien de ce que vous avez déjà."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemulihan hanya menambahkan yang hilang. Yang ada sekarang tidak diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ripristino aggiunge solo ciò che manca. Non modifica nulla di ciò che hai ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元に戻すのは、ないものを足すだけです。今あるものは変えません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å hente tilbake legger bare til det som mangler. Det du har nå, blir ikke endret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terugzetten voegt alleen toe wat ontbreekt. Wat je nu hebt, blijft ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywracanie tylko dodaje to, czego brakuje. Niczego, co masz teraz, nie zmienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar só adiciona o que falta. Nada do que você tem agora é alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возврат только добавляет недостающее. То, что есть сейчас, не меняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ta tillbaka lägger bara till det som saknas. Det du har nu ändras inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การนำกลับจะเพิ่มเฉพาะสิ่งที่หายไป ไม่เปลี่ยนสิ่งที่มีอยู่ตอนนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri getirme yalnızca eksik olanı ekler. Şu an olanları değiştirmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khôi phục chỉ thêm những gì còn thiếu. Không thay đổi những gì đang có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复只会补上缺少的内容，不会改动现有的内容。"
