    "회사 안에서 먹은 점심도 회사 시간으로 셉니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oběd snědený během práce se dál počítá jako pracovní doba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frokost spist i arbejdstiden tæller stadig som arbejdstid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittagessen während der Arbeit zählt weiterhin als Arbeitszeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μεσημεριανό μέσα στη δουλειά μετράει ως χρόνος δουλειάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunch eaten during work still counts as work time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comida durante el trabajo sigue contando como tiempo de trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työn aikana syöty lounas lasketaan silti työajaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déjeuner pris pendant le travail compte toujours comme temps de travail."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makan siang di jam kerja tetap dihitung sebagai waktu kerja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pranzo consumato durante il lavoro conta comunque come orario di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会社の中で食べた昼食も、会社の時間として数えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunsj spist i arbeidstiden regnes fortsatt som arbeidstid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunch tijdens het werk telt nog steeds als werktijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiad zjedzony w pracy nadal liczy się jako czas pracy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O almoço durante o trabalho ainda conta como tempo de trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обед во время работы всё равно считается рабочим временем."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunch som äts under arbetstid räknas fortfarande som arbetstid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มื้อกลางวันที่กินระหว่างงานยังนับเป็นเวลางาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İş sırasında yenen öğle yemeği yine iş süresi sayılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bữa trưa ăn trong giờ làm vẫn tính là thời gian làm việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上班期间吃的午餐也算工作时间。"
