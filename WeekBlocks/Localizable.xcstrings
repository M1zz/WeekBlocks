    "고정을 뺀 나머지가 이번 주에 쓸 수 있는 전부입니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co zbude po pevně daných hodinách, je všechno, co tento týden máte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, der er tilbage efter de faste tider, er alt, hvad du har i denne uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was nach den festen Zeiten übrig bleibt, ist alles, was du diese Woche hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ό,τι μένει μετά τις σταθερές ώρες είναι όλος ο χρόνος σου αυτή την εβδομάδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever is left after the fixed hours is all you have this week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que queda tras las horas fijas es todo lo que tienes esta semana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiinteiden tuntien jälkeen jäljelle jäävä aika on kaikki, mitä sinulla on tällä viikolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui reste après les horaires fixes, c’est tout ce dont vous disposez cette semaine."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisa setelah jam tetap adalah semua waktu yang Anda punya minggu ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello che resta dopo gli orari fissi è tutto ciò che hai questa settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定の時間を除いた残りが、今週使える時間のすべてです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som er igjen etter de faste timene, er alt du har denne uken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat er na de vaste uren overblijft, is alles wat je deze week hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co zostaje po stałych godzinach, to wszystko, czym dysponujesz w tym tygodniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que sobra depois dos horários fixos é tudo o que você tem nesta semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что остаётся после постоянного времени, — это всё, что у вас есть на этой неделе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som blir kvar efter de fasta tiderna är allt du har den här veckan."
