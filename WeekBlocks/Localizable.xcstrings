      }
    },
    "몸으로 하는 일이라 시동이 없습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je to fyzické, takže žádný rozjezd není potřeba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er fysisk, så der er ingen opstart."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist körperlich, also gibt es kein Anlaufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι σωματική δουλειά, οπότε δεν χρειάζεται ζέσταμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's physical, so there's no spin-up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es físico, así que no hay arranque."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on fyysistä, joten käynnistymistä ei tarvita."
          }
        },
        "fr" : {
