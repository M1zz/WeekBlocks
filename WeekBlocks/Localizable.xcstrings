    "꼭 함께여야 하면" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud se musí překrývat"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis de skal overlappe"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es sich überschneiden muss"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν πρέπει να επικαλύπτονται"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If they must overlap"
          }
        },
        "es" : {
          "stringUnit" : {
