          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεχωρίζετε τα μπλοκ του ουράνιου τόξου ακόμη και με αυξημένη αντίθεση ή αν δυσκολεύεστε με τα χρώματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
