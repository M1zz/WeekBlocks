    "직접 세는 것을 그만두고, 일정에 적힌 시각을 다시 따릅니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přestat počítat ručně a znovu se řídit časy v rozvrhu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop med at tælle manuelt, og følg tidspunkterne i din plan igen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht mehr von Hand zählen und wieder den Zeiten im Zeitplan folgen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σταμάτα τη χειροκίνητη μέτρηση και ακολούθησε ξανά τις ώρες του προγράμματος"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop counting by hand and follow the times in your schedule again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejar de contar a mano y volver a seguir las horas de tu agenda"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopeta käsin laskeminen ja seuraa taas aikataulusi aikoja"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter le décompte manuel et suivre à nouveau les heures du planning"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berhenti menghitung manual dan kembali mengikuti jam di jadwal Anda"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smetti di contare a mano e torna a seguire gli orari del programma"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動で数えるのをやめ、スケジュールに書かれた時刻にまた従います"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutt å telle manuelt og følg tidspunktene i planen din igjen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop met handmatig tellen en volg weer de tijden in je planning"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestań liczyć ręcznie i znów trzymaj się godzin z planu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parar de contar manualmente e voltar a seguir os horários da agenda"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перестать считать вручную и снова следовать времени из расписания"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluta räkna för hand och följ tiderna i schemat igen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลิกนับเอง แล้วกลับไปตามเวลาในตารางของคุณ"
