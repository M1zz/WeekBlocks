    "5분이면 끝나는 단계는 아이폰의 번개로 바로 끝냅니다. 한쪽에서 끝내면 양쪽에서 끝납니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroky na pět minut vyřídíte hned pomocí Blesku na iPhonu. Co dokončíte na jednom zařízení, je hotové na obou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trin på fem minutter klares med det samme med Lyn på iPhone. Afslut dem på den ene enhed, så er de klaret på begge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritte, die nur fünf Minuten dauern, erledigst du mit Blitz auf dem iPhone sofort. Auf einem Gerät abgehakt, ist es auf beiden erledigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα βήματα των πέντε λεπτών τελειώνουν αμέσως με την Αστραπή στο iPhone. Ό,τι ολοκληρώνεις στη μία συσκευή ολοκληρώνεται και στις δύο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steps that take five minutes get done right away with Lightning on the iPhone. Finish it on one device and it's done on both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pasos de cinco minutos se terminan al momento con Rayo en el iPhone. Termínalo en un dispositivo y quedará terminado en ambos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viiden minuutin vaiheet tehdään heti iPhonen Salamalla. Kun ne on tehty yhdellä laitteella, ne ovat valmiita molemmissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étapes de cinq minutes se règlent aussitôt avec Éclair sur l’iPhone. Terminée sur un appareil, elle l’est sur les deux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah lima menit langsung beres dengan Kilat di iPhone. Selesaikan di satu perangkat, dan selesai juga di perangkat lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fasi da cinque minuti si chiudono subito con Fulmine su iPhone. Completala su un dispositivo e risulta completata su entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5分で終わるステップは、iPhoneの稲妻ですぐに片づけられます。片方で終えれば両方で完了になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinn på fem minutter blir gjort med en gang med Lyn på iPhone. Fullfør på den ene enheten, så er det gjort på begge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stappen van vijf minuten doe je meteen af met Bliksem op de iPhone. Op het ene apparaat afgerond is op beide afgerond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroki na pięć minut załatwisz od razu Błyskawicą na iPhonie. Skończ na jednym urządzeniu, a będzie gotowe na obu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etapas de cinco minutos são feitas na hora com o Raio no iPhone. Concluiu num aparelho, está concluída nos dois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаги на пять минут сразу закрываются «Молнией» на iPhone. Завершите на одном устройстве — и шаг будет готов на обоих."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steg som tar fem minuter gör du direkt med Blixt på iPhone. Klarmarkera på en enhet så är det klart på båda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขั้นตอนที่ใช้เวลาห้านาทีทำเสร็จได้ทันทีด้วยสายฟ้าบน iPhone ทำเสร็จบนเครื่องหนึ่ง อีกเครื่องก็เสร็จด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beş dakikalık adımlar iPhone’daki Şimşek ile hemen hallolur. Bir aygıtta bitirdiğinizde ikisinde de biter."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bước năm phút được làm ngay bằng Tia chớp trên iPhone. Xong ở một thiết bị là xong ở cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 分钟就能完成的步骤，用 iPhone 上的闪电立即完成。在一边完成，两边都会完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 分鐘就能完成的步驟，用 iPhone 上的閃電立即完成。在一邊完成，兩邊都會完成。"
          }
        }
      }
    },
