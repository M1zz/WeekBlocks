        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conforme você mede tarefas com o timer, verá aqui quanto cada uma leva de verdade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда наберутся замеры таймером, здесь появится, сколько на самом деле занимает каждая задача."
