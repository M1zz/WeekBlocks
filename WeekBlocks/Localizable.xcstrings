    "%@\n눌러서 상세 · 같은 요일 안에서 끌어 시각 옮기기 · 우클릭으로 타이머 시작·삭제" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKliknutím zobrazíte podrobnosti · přetažením v rámci dne změníte čas · pravým kliknutím spustíte časovač nebo položku smažete"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKlik for detaljer · træk inden for samme dag for at ændre tidspunktet · højreklik for at starte timeren eller slette"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKlicken für Details · innerhalb desselben Tages ziehen, um die Uhrzeit zu ändern · Rechtsklick, um den Timer zu starten oder zu löschen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nΚλικ για λεπτομέρειες · σύρε μέσα στην ίδια ημέρα για να αλλάξεις την ώρα · δεξί κλικ για έναρξη χρονομέτρου ή διαγραφή"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nClick for details · drag within the same day to change the time · right-click to start the timer or delete it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nHaz clic para ver detalles · arrastra dentro del mismo día para cambiar la hora · clic derecho para iniciar el temporizador o eliminarlo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nNäytä tiedot klikkaamalla · vaihda aikaa vetämällä saman päivän sisällä · käynnistä ajastin tai poista oikealla klikkauksella"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nCliquez pour les détails · faites glisser dans la même journée pour changer l’heure · clic droit pour lancer le minuteur ou supprimer"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKlik untuk detail · seret di hari yang sama untuk mengubah waktu · klik kanan untuk memulai timer atau menghapusnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nFai clic per i dettagli · trascina nello stesso giorno per cambiare l’orario · clic destro per avviare il timer o eliminare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nクリックで詳細 · 同じ曜日の中でドラッグして時刻を変更 · 右クリックでタイマー開始・削除"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKlikk for detaljer · dra innenfor samme dag for å endre tidspunktet · høyreklikk for å starte tidtakeren eller slette"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKlik voor details · sleep binnen dezelfde dag om de tijd te wijzigen · klik met de rechtermuisknop om de timer te starten of te verwijderen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKliknij, by zobaczyć szczegóły · przeciągnij w obrębie dnia, by zmienić godzinę · kliknij prawym przyciskiem, by uruchomić timer lub usunąć"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nClique para ver detalhes · arraste no mesmo dia para mudar o horário · clique com o botão direito para iniciar o timer ou apagar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nНажмите, чтобы открыть · перетащите в пределах дня, чтобы сменить время · правый клик — запустить таймер или удалить"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nKlicka för detaljer · dra inom samma dag för att ändra tiden · högerklicka för att starta timern eller radera"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nคลิกเพื่อดูรายละเอียด · ลากภายในวันเดียวกันเพื่อเปลี่ยนเวลา · คลิกขวาเพื่อเริ่มจับเวลาหรือลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nAyrıntılar için tıklayın · saati değiştirmek için aynı gün içinde sürükleyin · zamanlayıcıyı başlatmak ya da silmek için sağ tıklayın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nBấm để xem chi tiết · kéo trong cùng ngày để đổi giờ · bấm chuột phải để bắt đầu hẹn giờ hoặc xóa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n点击查看详情 · 在同一天内拖动可调整时间 · 右键可启动计时器或删除"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n點按查看詳情 · 在同一天內拖移可調整時間 · 按右鍵可開始計時器或刪除"
          }
        }
      }
    },
