            "value" : "Importér automatisk, når kalenderen ændres"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch importieren, wenn sich der Kalender ändert"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτόματη εισαγωγή όταν αλλάζει το ημερολόγιο"
