    "보라 쪽까지 차오를수록 빽빽한 날입니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čím víc se duha plní až k fialové, tím nabitější den"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo længere op mod violet, jo travlere dag"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je weiter es bis ins Violett reicht, desto voller ist der Tag"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο πιο ψηλά φτάνει προς το μωβ, τόσο πιο γεμάτη είναι η μέρα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The closer it fills toward violet, the busier the day"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanto más se llena hacia el violeta, más cargado está el día"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä lähemmäs violettia täyttyy, sitä kiireisempi päivä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus ça monte vers le violet, plus la journée est chargée"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makin penuh hingga ke ungu, makin padat harinya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più si riempie verso il viola, più la giornata è piena"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紫まで積み上がるほど、予定が詰まった日です"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo nærmere fiolett det fylles, desto travlere er dagen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe verder het richting paars vol raakt, hoe drukker de dag"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im bliżej fioletu się zapełnia, tym bardziej napięty dzień"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto mais perto do violeta, mais cheio é o dia"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем ближе к фиолетовому, тем насыщеннее день"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ju närmare violett det fylls, desto fullare är dagen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยิ่งเต็มขึ้นไปถึงสีม่วง ยิ่งเป็นวันที่แน่น"
          }
        },
        "tr" : {
          "stringUnit" : {
