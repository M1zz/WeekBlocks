    "계획이 있는 모든 주의 일정을 링크로 공유합니다.\n링크를 받은 사람은 내 일정을 '보기 전용'으로 주를 넘겨가며 볼 수 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílejte každý naplánovaný týden jako odkaz.\nKdo má odkaz, může váš rozvrh procházet týden po týdnu – jen ke čtení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del alle de uger, du har planlagt, som et link.\nAlle med linket kan bladre gennem din plan, men kun se den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile jede geplante Woche als Link.\nWer den Link hat, kann deinen Zeitplan Woche für Woche durchblättern – nur ansehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μοιράσου κάθε εβδομάδα που έχεις προγραμματίσει με έναν σύνδεσμο.\nΌποιος έχει τον σύνδεσμο μπορεί να ξεφυλλίσει το πρόγραμμά σου, μόνο για προβολή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share every week you've planned as a link.\nAnyone with the link can page through your schedule, view-only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte con un enlace todas las semanas que hayas planificado.\nQuien tenga el enlace podrá recorrer tu agenda semana a semana, solo en modo lectura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa jokainen suunnittelemasi viikko linkkinä.\nKuka tahansa linkin saanut voi selata aikatauluasi, mutta ei muokata sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez chaque semaine planifiée via un lien.\nToute personne disposant du lien peut parcourir votre planning, en lecture seule."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan setiap minggu yang sudah Anda rencanakan sebagai tautan.\nSiapa pun yang punya tautannya bisa menelusuri jadwal Anda, hanya untuk dilihat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi con un link tutte le settimane che hai pianificato.\nChi ha il link può sfogliare il tuo programma, in sola lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定のあるすべての週のスケジュールをリンクで共有します。\nリンクを受け取った人は、週をめくりながら閲覧のみで見られます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del alle ukene du har planlagt, som en lenke.\nAlle med lenken kan bla gjennom planen din, men bare se den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel elke week die je hebt gepland via een link.\nWie de link heeft, kan door je planning bladeren, alleen lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnij linkiem każdy tydzień, w którym masz plan.\nKażdy, kto ma link, może przeglądać Twój plan tydzień po tygodniu, tylko do odczytu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe por link todas as semanas que você planejou.\nQuem tiver o link pode folhear sua agenda, só para ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поделитесь ссылкой на все недели, где есть план.\nПолучатель ссылки сможет листать ваше расписание только для просмотра."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela alla veckor du har planerat som en länk.\nAlla med länken kan bläddra i ditt schema, med endast läsbehörighet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชร์ทุกสัปดาห์ที่คุณวางแผนไว้เป็นลิงก์\nใครที่มีลิงก์ก็เปิดดูตารางของคุณทีละสัปดาห์ได้แบบดูอย่างเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planladığınız her haftayı bir bağlantıyla paylaşın.\nBağlantıya sahip olan herkes programınızda haftalar arasında gezinebilir, yalnızca görüntüleyerek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ mọi tuần đã lên kế hoạch bằng một đường liên kết.\nAi có liên kết đều có thể lật xem lịch của bạn theo từng tuần, chỉ xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以链接共享所有安排了计划的周。\n拿到链接的人可以用“仅查看”方式逐周翻看你的日程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以連結分享所有排了計畫的週。\n拿到連結的人可以用「僅檢視」方式逐週翻看你的行程。"
          }
        }
      }
    },
