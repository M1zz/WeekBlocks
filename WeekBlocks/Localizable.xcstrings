    "멈추고, 지금까지 걸린 시간을 이 일에 남깁니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops the timer and saves the time so far to this task"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止並把到目前為止的時間記在這件事上"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止并把到目前为止的用时记在这件事上"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "止めて、ここまでの時間をこの作業に記録します"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt und speichert die bisherige Zeit bei dieser Aufgabe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene y guarda en esta tarea el tiempo hasta ahora"
