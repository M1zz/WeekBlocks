          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiinteiden tuntien jälkeen jäljelle jäävä aika on kaikki, mitä sinulla on tällä viikolla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisa setelah jam tetap adalah semua waktu yang Anda punya minggu ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som er igjen etter de faste timene, er alt du har denne uken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat er na de vaste uren overblijft, is alles wat je deze week hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co zostaje po stałych godzinach, to wszystko, czym dysponujesz w tym tygodniu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som blir kvar efter de fasta tiderna är allt du har den här veckan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลาที่เหลือหลังหักช่วงเวลาประจำ คือทั้งหมดที่คุณมีในสัปดาห์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabit saatlerden geriye kalan, bu hafta elinizdeki her şeydir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần còn lại sau giờ cố định là tất cả những gì bạn có trong tuần này."
          }
        }
      }
    },
