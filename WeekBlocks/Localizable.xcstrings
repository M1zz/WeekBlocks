        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やることが決まっているので、すぐ手が動きます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er avklart hva som skal gjøres, så du går rett i gang."
