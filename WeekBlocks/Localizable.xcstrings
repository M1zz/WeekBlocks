    },
    "아이폰 앱 ‘욕망의 무지개’는 여기서 짠 한 주를 그대로 열어, 맥 앞이 아닐 때도 오늘 무엇이 남았는지 보여 줍니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iPhone app “Rainbow of Desire” opens the week you plan here, so you can see what's left today even when you're away from your Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone App“欲望彩虹”会直接打开你在这里排好的一周，不在 Mac 前也能看到今天还剩什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone App「欲望彩虹」會直接開啟你在這裡排好的一週，不在 Mac 前也能看到今天還剩什麼。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die iPhone-App „Rainbow of Desire“ öffnet die Woche, die du hier planst – so siehst du auch fern vom Mac, was heute noch ansteht."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneアプリ「Rainbow of Desire」は、ここで組んだ1週間をそのまま開き、Macの前にいないときも今日何が残っているかを見せてくれます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app de iPhone “Rainbow of Desire” abre la semana que planificas aquí, para que veas lo que te queda hoy aunque no estés delante del Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app iPhone « Rainbow of Desire » ouvre la semaine que vous planifiez ici : vous voyez ce qui reste aujourd’hui même loin de votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app per iPhone “Rainbow of Desire” apre la settimana che pianifichi qui, così vedi cosa resta oggi anche lontano dal Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app de iPhone “Rainbow of Desire” abre a semana que você planeja aqui, para você ver o que resta hoje mesmo longe do Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение для iPhone «Rainbow of Desire» открывает неделю, которую вы планируете здесь, так что видно, что осталось на сегодня, даже вдали от Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace pro iPhone „Rainbow of Desire“ otevře týden, který tu naplánujete, takže i daleko od Macu uvidíte, co vám dnes ještě zbývá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-appen “Rainbow of Desire” åbner den uge, du planlægger her, så du kan se, hvad der er tilbage i dag, også når du er væk fra din Mac."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή iPhone «Rainbow of Desire» ανοίγει την εβδομάδα που προγραμματίζεις εδώ, ώστε να βλέπεις τι απομένει σήμερα ακόμη κι όταν είσαι μακριά από το Mac."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-appi ”Rainbow of Desire” avaa täällä suunnittelemasi viikon, joten näet tämän päivän jäljellä olevat asiat, vaikka olisit poissa Macin äärestä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App iPhone “Rainbow of Desire” membuka minggu yang Anda rencanakan di sini, jadi Anda bisa melihat sisa hari ini meski jauh dari Mac."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-appen «Rainbow of Desire» åpner uken du planlegger her, så du kan se hva som er igjen i dag også når du er borte fra Macen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De iPhone-app ‘Rainbow of Desire’ opent de week die je hier plant, zodat je ook weg van je Mac ziet wat er vandaag nog over is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja na iPhone’a „Rainbow of Desire” otwiera tydzień zaplanowany tutaj, więc widzisz, co zostało na dziś, nawet z dala od Maca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-appen ”Rainbow of Desire” öppnar veckan du planerar här, så att du ser vad som är kvar i dag även när du inte sitter vid din Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอป iPhone “Rainbow of Desire” เปิดสัปดาห์ที่คุณวางแผนไว้ที่นี่ คุณจึงเห็นว่าวันนี้เหลืออะไรบ้างแม้อยู่ห่างจาก Mac"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone uygulaması “Rainbow of Desire”, burada planladığınız haftayı açar; Mac’inizden uzaktayken bile bugün neyin kaldığını görürsünüz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng iPhone “Rainbow of Desire” mở đúng tuần bạn lên kế hoạch ở đây, để bạn biết hôm nay còn gì ngay cả khi không ngồi trước Mac."
          }
        }
      }
    },
    "아이폰 카메라로 QR 코드를 비추거나, 링크를 아이폰으로 보내세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point your iPhone's camera at the QR code, or send the link to your iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 iPhone 相机扫描二维码，或把链接发送到 iPhone。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 iPhone 相機掃描 QR 碼，或把連結傳到 iPhone。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Kamera deines iPhone auf den QR-Code oder schick dir den Link aufs iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのカメラでQRコードを読み取るか、リンクをiPhoneに送ってください。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta la cámara del iPhone al código QR o envía el enlace a tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez l’appareil photo de votre iPhone vers le QR code, ou envoyez le lien sur votre iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra il codice QR con la fotocamera dell’iPhone o invia il link al tuo iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte a câmera do iPhone para o QR code ou envie o link para o iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите камеру iPhone на QR-код или отправьте ссылку на iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namiřte fotoaparát iPhonu na QR kód, nebo si pošlete odkaz do iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ret din iPhones kamera mod QR-koden, eller send linket til din iPhone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στρέψε την κάμερα του iPhone στον κωδικό QR ή στείλε τον σύνδεσμο στο iPhone σου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoita iPhonen kameralla QR-koodia tai lähetä linkki iPhoneesi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arahkan kamera iPhone ke kode QR, atau kirim tautannya ke iPhone Anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rett iPhone-kameraet mot QR-koden, eller send lenken til iPhonen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richt de camera van je iPhone op de QR-code, of stuur de link naar je iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skieruj aparat iPhone’a na kod QR albo wyślij link na iPhone’a."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rikta iPhones kamera mot QR-koden eller skicka länken till din iPhone."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่องกล้อง iPhone ไปที่คิวอาร์โค้ด หรือส่งลิงก์ไปยัง iPhone"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’unuzun kamerasını QR koduna tutun ya da bağlantıyı iPhone’unuza gönderin."
          }
