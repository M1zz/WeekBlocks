          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner tidspunktet og lægger den tilbage i sin del af dagen (bliver i dagens plan)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
