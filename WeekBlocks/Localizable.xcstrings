        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you were typing stays put, even if the app closes mid-way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que estabas escribiendo se conserva aunque la app se cierre a mitad."
