    "%@ 만든 일정과 모든 내용이 같습니다. 똑같은 일정은 기기 사이에서 하나로 합쳐지니, 제목이나 날짜를 바꿔 주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve všem se shoduje s plánem vytvořeným %@. Stejné plány se mezi zařízeními sloučí do jednoho, proto prosím změňte název nebo data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er helt magen til en plan, der er oprettet %@. Ens planer bliver lagt sammen til én på tværs af enheder, så skift titlen eller datoerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Plan, der %@ erstellt wurde, ist in allem gleich. Gleiche Pläne werden zwischen Geräten zu einem zusammengeführt – ändere bitte den Titel oder das Datum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι ίδιο σε όλα με ένα πρόγραμμα που δημιουργήθηκε %@. Τα ίδια προγράμματα συγχωνεύονται σε ένα ανάμεσα στις συσκευές, γι’ αυτό αλλάξτε τον τίτλο ή τις ημερομηνίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It matches a schedule made %@ in every detail. Identical schedules are merged into one across devices, so please change the title or dates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide en todo con un plan creado %@. Los planes idénticos se unen en uno solo entre dispositivos, así que cambia el título o las fechas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on kaikilta osin sama kuin %@ tehty suunnitelma. Samanlaiset suunnitelmat yhdistyvät laitteiden välillä yhdeksi, joten vaihda otsikko tai päivämäärät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est identique en tout point à un plan créé %@. Les plans identiques sont fusionnés en un seul d’un appareil à l’autre : changez le titre ou les dates."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua isinya sama dengan jadwal yang dibuat %@. Jadwal yang sama persis akan digabung menjadi satu di semua perangkat, jadi ubah judul atau tanggalnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È identico in tutto a un piano creato %@. I piani identici vengono uniti in uno solo tra i dispositivi, quindi cambia il titolo o le date."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@作成した予定と内容がすべて同じです。まったく同じ予定はデバイス間で1つにまとめられるため、タイトルか日付を変えてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er helt lik en plan som ble laget %@. Like planer slås sammen til én på tvers av enheter, så endre tittelen eller datoene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles is gelijk aan een planning die %@ is gemaakt. Identieke planningen worden tussen apparaten samengevoegd tot één, dus wijzig de titel of de datums."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko zgadza się z planem utworzonym %@. Identyczne plany łączą się między urządzeniami w jeden, więc zmień tytuł lub daty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É idêntico em tudo a um plano criado %@. Planos idênticos são unidos em um só entre os dispositivos, então mude o título ou as datas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он во всём совпадает с планом, созданным %@. Одинаковые планы объединяются в один на всех устройствах, поэтому измените название или даты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den är identisk med en plan som skapats %@. Likadana planer slås ihop till en mellan enheterna, så ändra titeln eller datumen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหมือนกับตารางที่สร้าง%@ทุกอย่าง ตารางที่เหมือนกันทุกประการจะถูกรวมเป็นหนึ่งเดียวระหว่างอุปกรณ์ โปรดเปลี่ยนชื่อเรื่องหรือวันที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ oluşturulan bir planla her şeyiyle aynı. Birebir aynı planlar cihazlar arasında tek plana birleştirilir; lütfen başlığı veya tarihleri değiştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi nội dung đều giống hệt một lịch đã tạo %@. Các lịch giống hệt nhau sẽ được gộp làm một giữa các thiết bị, vì vậy hãy đổi tiêu đề hoặc ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与%@创建的日程内容完全相同。完全相同的日程会在设备之间合并为一个，请修改标题或日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與%@建立的行程內容完全相同。完全相同的行程會在裝置之間合併為一個，請修改標題或日期。"
          }
        }
      }
    },
    "%@ 백업에 있던 것 중 %lld개가 지금 없습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze zálohy z %1$@ teď chybí položky: %2$lld."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld elementer fra backuppen %1$@ mangler nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld Einträge aus der Sicherung vom %1$@ fehlen jetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λείπουν τώρα %2$lld στοιχεία από το αντίγραφο ασφαλείας της %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld items from the %1$@ backup are missing now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltan %2$lld elementos de la copia de seguridad del %1$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopiosta %1$@ puuttuu nyt %2$lld kohdetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld éléments de la sauvegarde du %1$@ manquent maintenant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld item dari cadangan %1$@ sekarang tidak ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mancano %2$lld elementi del backup del %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@のバックアップにあったもののうち%2$lld件が今はありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
