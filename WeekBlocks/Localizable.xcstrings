            "value" : "Sen nie jest ukryty, bo rutyna snu nie dotyka północy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sono não foi ocultado porque a rotina de sono não toca a meia-noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон не скрыт, потому что рутина сна не касается полуночи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sömnen döljs inte eftersom sömnrutinen inte når midnatt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้ซ่อนเวลานอน เพราะกิจวัตรการนอนไม่ได้คร่อมเที่ยงคืน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku rutini gece yarısına değmediği için uyku gizlenmedi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ẩn giờ ngủ vì thói quen ngủ không chạm mốc nửa đêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠作息没有接触 0 点或 24 点，因此未能折叠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠作息沒有碰到 0 點或 24 點，因此未能收合。"
          }
        }
      }
    },
    "수면을 접으면 남는 시간이 너무 짧아 하루 전체를 보여 줘요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje se celý den, protože po skrytí spánku by zbylo příliš málo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele dagen vises, fordi der ville være for lidt tilbage, hvis søvnen blev skjult."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ganze Tag wird angezeigt, weil ohne Schlaf zu wenig übrig bliebe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζεται όλη η μέρα, επειδή αν κρυφτεί ο ύπνος θα έμενε πολύ λίγος χώρος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Showing the whole day because hiding sleep would leave too little."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra el día entero porque, ocultando el sueño, quedaría demasiado poco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytetään koko päivä, koska unen piilottaminen jättäisi liian vähän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La journée entière est affichée, car masquer le sommeil laisserait trop peu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan sehari penuh karena menyembunyikan tidur akan menyisakan terlalu sedikit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostro l’intera giornata perché nascondendo il sonno resterebbe troppo poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠を折りたたむと残りが短くなりすぎるため、1日全体を表示しています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele døgnet vises fordi det ville bli for lite igjen hvis søvnen ble skjult."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hele dag wordt getoond omdat er te weinig over zou blijven als de slaap verborgen werd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazano cały dzień, bo po ukryciu snu zostałoby za mało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando o dia inteiro porque ocultar o sono deixaria pouco demais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показан весь день: если скрыть сон, останется слишком мало."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar hela dagen eftersom det blir för lite kvar om sömnen döljs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงทั้งวัน เพราะถ้าซ่อนเวลานอนจะเหลือพื้นที่น้อยเกินไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uykuyu gizlemek çok az alan bırakacağı için günün tamamı gösteriliyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện cả ngày vì nếu ẩn giờ ngủ thì phần còn lại quá ít."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "折叠睡眠后剩下的时间太短，因此显示全天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收合睡眠後剩下的時間太短，因此顯示整天。"
          }
        }
      }
    },
