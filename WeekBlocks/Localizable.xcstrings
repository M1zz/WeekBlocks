    "점심 먹는 동안은 회사 시간이 아닙니다. 겹친 만큼 회사에서 뺍니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While you're at lunch, you're not at work. The overlap is taken out of work time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吃午饭时不算上班时间。重叠的部分会从工作时间中扣除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吃午餐時不算上班時間。重疊的部分會從工作時間扣除。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
