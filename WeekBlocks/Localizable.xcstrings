            "value" : "Mal pro Tag"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φορές την ημέρα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times a day"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veces al día"
          }
        },
