    "구체성 미검증 — 눌러서 다듬기 · 다른 요일로 끌어 옮기기 · 할 일 목록으로 끌어 내리면 날짜가 무름" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkrétnost nezkontrolována – kliknutím ji zpřesníte · přetažením na jiný den · přetažením dolů do seznamu úkolů zrušíte datum"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkrethed ikke tjekket — klik for at skærpe den · træk til en anden dag · træk den ned i opgavelisten for at fjerne datoen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkretheit nicht geprüft – klicken zum Schärfen · auf einen anderen Tag ziehen · nach unten in die Aufgabenliste ziehen, um das Datum zu entfernen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ελέγχθηκε αν είναι συγκεκριμένο — κλικ για να το βελτιώσεις · σύρε σε άλλη ημέρα · σύρε το κάτω στη λίστα εργασιών για να αφαιρέσεις την ημερομηνία"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concreteness not checked — click to sharpen it · drag to another day · drag it down into the to-do list to clear the date"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concreción sin comprobar — haz clic para afinarlo · arrástralo a otro día · arrástralo abajo a la lista de tareas para quitarle la fecha"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkreettisuutta ei tarkistettu – tarkenna klikkaamalla · vedä toiselle päivälle · poista päivämäärä vetämällä tehtävälistaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Précision non vérifiée — cliquez pour l’affiner · faites glisser vers un autre jour · faites glisser dans la liste des tâches pour retirer la date"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kejelasan belum dicek — klik untuk mempertajamnya · seret ke hari lain · seret ke daftar tugas di bawah untuk menghapus tanggalnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concretezza non verificata — fai clic per renderlo più preciso · trascina su un altro giorno · trascinalo giù nell’elenco attività per togliere la data"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "具体性未チェック — クリックで具体化 · 別の曜日へドラッグ · やることリストへドラッグすると日付を解除"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkrethet ikke sjekket – klikk for å skjerpe den · dra til en annen dag · dra den ned i oppgavelisten for å fjerne datoen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concreetheid niet gecontroleerd — klik om aan te scherpen · sleep naar een andere dag · sleep omlaag naar de takenlijst om de datum te wissen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
