    "네 걸음입니다. 지금 다 외우지 않아도 됩니다 — 화면이 그때그때 다음 걸음을 알려줍니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four steps. You don't have to memorize them — the app tells you the next one as you go."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一共四步。现在不用全部记住 — 界面会随时告诉你下一步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一共四步。現在不用全部記住 — 畫面會隨時告訴你下一步。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier Schritte. Du musst sie dir nicht merken – die App zeigt dir unterwegs jeweils den nächsten."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4つのステップです。今すべて覚えなくても大丈夫 — 画面がその都度次のステップを案内します。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuatro pasos. No hace falta memorizarlos: la app te indica el siguiente sobre la marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quatre étapes. Inutile de les retenir : l’app vous indique la suivante au fur et à mesure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quattro passi. Non serve memorizzarli: l’app ti indica il prossimo man mano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São quatro passos. Não precisa decorar — o app mostra o próximo conforme você avança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Четыре шага. Запоминать не нужно — приложение подскажет следующий по ходу дела."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čtyři kroky. Nemusíte si je pamatovat – aplikace vám vždy ukáže ten další."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fire trin. Du behøver ikke huske dem – appen fortæller dig det næste undervejs."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τέσσερα βήματα. Δεν χρειάζεται να τα απομνημονεύσεις — η εφαρμογή σού λέει το επόμενο στην πορεία."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neljä vaihetta. Niitä ei tarvitse opetella ulkoa – appi kertoo seuraavan matkan varrella."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empat langkah. Tidak perlu dihafal — app memberi tahu langkah berikutnya sambil jalan."
