    "짧게 잡아 두어도 여기서 끝나지는 않습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even booked short, it won't finish here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使排得很短，也不会在这里结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使排得很短，也不會在這裡結束。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst knapp eingeplant wird es hier nicht fertig."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短めに見積もっても、ここでは終わりません。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque le hayas dado poco tiempo, aquí no se termina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même prévu court, cela ne se terminera pas ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con poco tempo previsto, qui non si chiuderà."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo agendado curto, não termina aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже если отвести мало времени, здесь не закончится."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ani při krátkém naplánování se to tady nedokončí."
          }
        },
        "da" : {
          "stringUnit" : {
