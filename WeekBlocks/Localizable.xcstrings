    "승인을 기다리는 중입니다. 승인되면 앱이 알아서 열립니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for approval. The app unlocks on its own once it comes through."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待批准。批准后 App 会自动解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待核准。核准後 App 會自動解鎖。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte auf Freigabe. Die App wird automatisch freigeschaltet, sobald sie erteilt ist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認を待っています。承認されるとアプリが自動で利用可能になります。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando la aprobación. La app se desbloqueará sola en cuanto llegue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente d’approbation. L’app se déverrouillera d’elle-même dès qu’elle sera accordée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di approvazione. L’app si sblocca da sola quando arriva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando aprovação. O app é desbloqueado sozinho assim que ela chegar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидание одобрения. Когда оно придёт, приложение откроется само."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čeká se na schválení. Aplikace se odemkne sama, jakmile schválení dorazí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på godkendelse. Appen låses op af sig selv, når den kommer igennem."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναμονή έγκρισης. Η εφαρμογή θα ξεκλειδωθεί μόνη της μόλις εγκριθεί."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotetaan hyväksyntää. Appi avautuu itsestään, kun se tulee."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu persetujuan. App terbuka sendiri begitu disetujui."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på godkjenning. Appen låses opp av seg selv når den kommer gjennom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht op goedkeuring. De app ontgrendelt vanzelf zodra die binnen is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czekamy na zatwierdzenie. Gdy przyjdzie, aplikacja odblokuje się sama."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntar på godkännande. Appen låses upp av sig själv när det kommer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำลังรอการอนุมัติ แอปจะปลดล็อกเองเมื่อได้รับการอนุมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onay bekleniyor. Onay gelince uygulamanın kilidi kendiliğinden açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang chờ phê duyệt. Ứng dụng sẽ tự mở khóa khi được duyệt."
          }
        }
      }
    },
