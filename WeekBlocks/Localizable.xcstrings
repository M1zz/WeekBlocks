    "타이머 창 · 맨 위 알약 · 계획 칩에 남은 시간을 적는 방식입니다. 위젯은 시스템이 세므로 시:분:초로 보입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How time left appears in the timer window, the top pill and plan chips. The widget is counted by the system, so it shows h:mm:ss."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计时器窗口、顶部胶囊和计划标签显示剩余时间的方式。小组件由系统计时，因此总是显示为时:分:秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計時器視窗、頂端膠囊和計畫標籤顯示剩餘時間的方式。小工具由系統計時，因此一律顯示為時:分:秒。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So erscheint die Restzeit im Timer-Fenster, in der Pille oben und auf den Plan-Chips. Das Widget wird vom System gezählt und zeigt daher h:mm:ss."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーウインドウ · 上部のピル · 予定チップに残り時間を表示する形式です。ウィジェットはシステムが数えるため、時:分:秒で表示されます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se muestra el tiempo restante en la ventana del temporizador, la píldora superior y las etiquetas de los planes. El widget lo cuenta el sistema, así que muestra h:mm:ss."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format du temps restant dans la fenêtre du minuteur, la pilule du haut et les puces des plans. Le widget est décompté par le système et affiche donc h:mm:ss."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come appare il tempo rimanente nella finestra del timer, nella pillola in alto e nei chip dei piani. Il widget è conteggiato dal sistema, quindi mostra h:mm:ss."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o tempo restante aparece na janela do timer, na pílula do topo e nos chips de plano. O widget é contado pelo sistema, por isso mostra h:mm:ss."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как показывать оставшееся время в окне таймера, верхней капсуле и плашках планов. Виджет отсчитывает система, поэтому там формат ч:мм:сс."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak se zbývající čas zobrazuje v okně časovače, v horní pilulce a na štítcích plánů. Widget počítá systém, proto ukazuje h:mm:ss."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sådan vises den tilbageværende tid i timervinduet, pillen øverst og planmærkerne. Widgetten tælles af systemet, så den viser t:mm:ss."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς εμφανίζεται ο χρόνος που απομένει στο παράθυρο χρονομέτρου, στην κάψουλα στην κορυφή και στις ετικέτες πλάνων. Το widget το μετράει το σύστημα, οπότε δείχνει ω:λλ:δδ."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miten jäljellä oleva aika näkyy ajastinikkunassa, yläreunan pillerissä ja suunnitelmasiruissa. Widgetin laskee järjestelmä, joten se näyttää muodon t:mm:ss."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara sisa waktu ditampilkan di jendela timer, kapsul atas, dan chip rencana. Widget dihitung oleh sistem, jadi menampilkan j:mm:dd."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slik vises tiden som er igjen i tidtakervinduet, pillen øverst og planmerkene. Widgeten telles av systemet, så den viser t:mm:ss."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe de resterende tijd wordt getoond in het timervenster, de pil bovenaan en de planlabels. De widget wordt door het systeem geteld en toont daarom u:mm:ss."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak pokazywać pozostały czas w oknie timera, górnej pigułce i plakietkach planów. Widżet odlicza system, więc pokazuje h:mm:ss."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur tiden som är kvar visas i timerfönstret, pillret högst upp och planbrickorna. Widgeten räknas av systemet, så den visar h:mm:ss."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปแบบการแสดงเวลาที่เหลือในหน้าต่างตัวจับเวลา แคปซูลด้านบน และชิปแผน วิดเจ็ตนับโดยระบบ จึงแสดงเป็น ช:นน:วว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalan sürenin zamanlayıcı penceresinde, üstteki hapta ve plan çiplerinde nasıl görüneceği. Widget’ı sistem saydığı için sa:dk:sn biçiminde gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách hiển thị thời gian còn lại trong cửa sổ bộ hẹn giờ, viên thuốc phía trên và nhãn kế hoạch. Tiện ích do hệ thống đếm nên hiển thị dạng giờ:phút:giây."
          }
        }
      }
    },
