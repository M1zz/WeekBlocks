      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracked by the week, with no fixed day or hour. It still counts fully against your free time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只按周追踪，不指定具体的星期和时间。仍会完整计入空闲时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
