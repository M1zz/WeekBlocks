    "먼저 찍을 것" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark these first"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先标记这些"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先標記這些"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst abhaken"
