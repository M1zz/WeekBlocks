    "회당과 주 합계는 한 값의 두 얼굴입니다 — 한쪽을 고치면 다른 쪽이 따라 바뀝니다(회당 × 횟수 × 7일). 편한 쪽으로 넣으세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per-session and weekly total are two sides of one value — change one and the other follows (per session × sessions × 7 days). Enter whichever is easier."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“每次”与“每周合计”是同一个数值的两面 — 改其中一个，另一个就会跟着变（每次 × 次数 × 7 天）。用你方便的那个输入即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「每次」與「每週合計」是同一個數值的兩面 — 改其中一個，另一個就會跟著變（每次 × 次數 × 7 天）。用你方便的那個輸入即可。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Einheit und Wochensumme sind zwei Seiten desselben Werts – änderst du das eine, folgt das andere (pro Einheit × Anzahl × 7 Tage). Gib ein, was dir leichter fällt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回あたりと週の合計は同じ値の表と裏です — 片方を変えると、もう片方も連動します（1回あたり × 回数 × 7日）。入力しやすいほうで入れてください。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por sesión y total semanal son dos caras del mismo valor: si cambias uno, el otro se ajusta (por sesión × sesiones × 7 días). Introduce el que te resulte más fácil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La durée par séance et le total de la semaine sont les deux faces d’une même valeur : modifiez l’une, l’autre suit (par séance × séances × 7 jours). Saisissez celle qui vous arrange."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durata per sessione e totale settimanale sono due facce dello stesso valore: cambiane uno e l’altro si adegua (per sessione × sessioni × 7 giorni). Inserisci quello che ti è più comodo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por sessão e total semanal são dois lados do mesmo valor — mude um e o outro acompanha (por sessão × sessões × 7 dias). Preencha o que for mais fácil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«За раз» и итог за неделю — две стороны одного значения: измените одно, и второе пересчитается (за раз × раз в день × 7 дней). Вводите то, что удобнее."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délka jednoho opakování a týdenní součet jsou dvě strany jedné hodnoty – změníte-li jednu, druhá se přizpůsobí (jednou × počet × 7 dní). Zadejte, co je pro vás snazší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pr. gang og ugetotal er to sider af samme værdi — ændrer du den ene, følger den anden med (pr. gang × antal gange × 7 dage). Indtast den, der er nemmest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διάρκεια ανά φορά και το εβδομαδιαίο σύνολο είναι οι δύο όψεις της ίδιας τιμής — αν αλλάξεις τη μία, ακολουθεί η άλλη (ανά φορά × φορές × 7 ημέρες). Συμπλήρωσε όποια είναι πιο εύκολη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kertakohtainen ja viikon kokonaismäärä ovat saman arvon kaksi puolta – kun muutat toista, toinen seuraa (kerta × kerrat × 7 päivää). Syötä kumpi on helpompi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per sesi dan total mingguan adalah dua sisi dari satu nilai — ubah satu, yang lain ikut (per sesi × jumlah sesi × 7 hari). Masukkan yang lebih mudah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per gang og ukesum er to sider av samme verdi – endrer du den ene, følger den andre med (per gang × antall ganger × 7 dager). Skriv inn den som er enklest."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per sessie en weektotaal zijn twee kanten van één waarde — wijzig er een en de ander volgt (per sessie × sessies × 7 dagen). Vul in wat het makkelijkst is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Na raz” i suma tygodniowa to dwie strony jednej wartości — zmień jedną, a druga się dostosuje (na raz × razy × 7 dni). Wpisz tę, która jest wygodniejsza."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per pass och veckototal är två sidor av samma värde – ändra det ena så följer det andra med (per pass × pass × 7 dagar). Ange det som är enklast."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต่อครั้งและรวมรายสัปดาห์คือสองด้านของค่าเดียวกัน — เปลี่ยนค่าหนึ่งแล้วอีกค่าจะเปลี่ยนตาม (ต่อครั้ง × จำนวนครั้ง × 7 วัน) กรอกช่องที่สะดวกกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seferlik süre ile haftalık toplam aynı değerin iki yüzüdür; birini değiştirince diğeri de değişir (seferlik × sefer sayısı × 7 gün). Hangisi kolaysa onu girin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi lần và tổng tuần là hai mặt của cùng một giá trị — đổi bên này thì bên kia đổi theo (mỗi lần × số lần × 7 ngày). Nhập bên nào thấy dễ hơn."
          }
        }
      }
    },
    "회당과 주 합계는 한 값의 두 얼굴입니다 — 한쪽을 고치면 다른 쪽이 따라 바뀝니다(회당 × 횟수 × 7일). 편한 쪽으로 넣으세요.\n정확한 요일·시간 없이 주 단위로만 추적합니다. 자유 시간 계산에는 그대로 반영됩니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Each” and the weekly total are two faces of one number — change either and the other follows (each × times × 7 days). Enter whichever is easier.\nTracked by the week, with no fixed day or hour. It still counts fully against your free time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“每次”与“每周合计”是同一个数值的两面 — 改其中一个，另一个就会跟着变（每次 × 次数 × 7 天）。用你方便的那个输入即可。\n只按周追踪，不指定星期或时刻。仍会完整计入自由时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「每次」與「每週合計」是同一個數值的兩面 — 改其中一個，另一個就會跟著變（每次 × 次數 × 7 天）。用你方便的那個輸入即可。\n只以週為單位追蹤，不指定星期或時刻。仍會完整計入自由時間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pro Einheit“ und die Wochensumme sind zwei Seiten derselben Zahl – änderst du eines, folgt das andere (pro Einheit × Anzahl × 7 Tage). Gib ein, was dir leichter fällt.\nWird pro Woche erfasst, ohne festen Tag oder feste Uhrzeit. Es zählt trotzdem voll gegen deine freie Zeit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「1回あたり」と週の合計は同じ値の表と裏です — 片方を変えると、もう片方も連動します（1回あたり × 回数 × 7日）。入力しやすいほうで入れてください。\n決まった曜日・時刻なしで、週単位でだけ追跡します。空き時間の計算にはそのまま反映されます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Cada vez” y el total semanal son dos caras del mismo número: si cambias uno, el otro se ajusta (cada vez × veces × 7 días). Introduce el que te resulte más fácil.\nSe controla por semanas, sin día ni hora fijos. Aun así, cuenta por completo en tu tiempo libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Par séance » et le total de la semaine sont les deux faces d’un même nombre : modifiez l’un, l’autre suit (par séance × fois × 7 jours). Saisissez celui qui vous arrange.\nSuivi à la semaine, sans jour ni heure fixes. Le temps est tout de même entièrement déduit de votre temps libre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ciascuna” e il totale settimanale sono due facce dello stesso numero: cambiane uno e l’altro si adegua (ciascuna × volte × 7 giorni). Inserisci quello che ti è più comodo.\nSi tiene il conto per settimana, senza giorno né ora fissi. Viene comunque sottratta per intero dal tempo libero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Cada” e o total semanal são duas faces do mesmo número — mude um e o outro acompanha (cada × vezes × 7 dias). Preencha o que for mais fácil.\nAcompanhada por semana, sem dia ou hora fixos. Ainda conta integralmente no seu tempo livre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«За раз» и итог за неделю — две стороны одного значения: измените одно, и второе пересчитается (за раз × раз в день × 7 дней). Вводите то, что удобнее.\nУчитывается по неделям, без точного дня и часа. Из свободного времени вычитается полностью."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Jednou“ a týdenní součet jsou dvě strany jednoho čísla – změníte-li jedno, druhé se přizpůsobí (jednou × počet × 7 dní). Zadejte, co je pro vás snazší.\nSleduje se po týdnech, bez pevného dne či hodiny. Z volného času se přesto odečítá celé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hver gang” og ugetotalen er to sider af samme tal — ændrer du den ene, følger den anden med (hver gang × antal gange × 7 dage). Indtast den, der er nemmest.\nFølges pr. uge uden fast dag eller time. Den tæller stadig fuldt ud i din ledige tid."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διάρκεια «ανά φορά» και το εβδομαδιαίο σύνολο είναι οι δύο όψεις του ίδιου αριθμού — αν αλλάξεις τη μία, ακολουθεί η άλλη (ανά φορά × φορές × 7 ημέρες). Συμπλήρωσε όποια είναι πιο εύκολη.\nΠαρακολουθείται ανά εβδομάδα, χωρίς σταθερή ημέρα ή ώρα. Αφαιρείται κανονικά από τον ελεύθερο χρόνο σου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Kerta” ja viikon kokonaismäärä ovat saman luvun kaksi puolta – kun muutat toista, toinen seuraa (kerta × kerrat × 7 päivää). Syötä kumpi on helpompi.\nSeurataan viikoittain ilman kiinteää päivää tai tuntia. Se vähennetään silti kokonaan vapaasta ajasta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Per sesi” dan total mingguan adalah dua sisi dari satu angka — ubah salah satu, yang lain ikut (per sesi × kali × 7 hari). Masukkan yang lebih mudah.\nDilacak per minggu, tanpa hari atau jam tetap. Tetap dihitung penuh terhadap waktu luang Anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Hver gang» og ukesummen er to sider av samme tall – endrer du den ene, følger den andre med (hver gang × antall ganger × 7 dager). Skriv inn den som er enklest.\nFølges per uke uten fast dag eller klokkeslett. Den teller likevel fullt ut mot den ledige tiden din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Per keer’ en het weektotaal zijn twee kanten van één getal — wijzig er een en de ander volgt (per keer × aantal × 7 dagen). Vul in wat het makkelijkst is.\nBijgehouden per week, zonder vaste dag of uur. Telt nog steeds volledig mee in je vrije tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Na raz” i suma tygodniowa to dwie strony jednej wartości — zmień jedną, a druga się dostosuje (na raz × razy × 7 dni). Wpisz tę, która jest wygodniejsza.\nLiczone tygodniowo, bez stałego dnia i godziny. Nadal w całości odejmowane od wolnego czasu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Per gång” och veckototalen är två sidor av samma tal – ändra det ena så följer det andra med (per gång × gånger × 7 dagar). Ange det som är enklast.\nFöljs upp per vecka, utan fast dag eller timme. Den dras ändå fullt ut från din fria tid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ต่อครั้ง” และรวมรายสัปดาห์คือสองด้านของตัวเลขเดียวกัน — เปลี่ยนค่าหนึ่งแล้วอีกค่าจะเปลี่ยนตาม (ต่อครั้ง × จำนวนครั้ง × 7 วัน) กรอกช่องที่สะดวกกว่า\nติดตามเป็นรายสัปดาห์ โดยไม่กำหนดวันหรือชั่วโมง แต่ยังหักออกจากเวลาว่างเต็มจำนวน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Seferlik” süre ile haftalık toplam aynı sayının iki yüzüdür; birini değiştirince diğeri de değişir (seferlik × kez × 7 gün). Hangisi kolaysa onu girin.\nBelirli bir gün ya da saat olmadan haftalık olarak izlenir. Yine de boş zamanınızdan tamamen düşülür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mỗi lần” và tổng tuần là hai mặt của cùng một con số — đổi bên nào thì bên kia đổi theo (mỗi lần × số lần × 7 ngày). Nhập bên nào thấy dễ hơn.\nTheo dõi theo tuần, không cố định ngày hay giờ. Vẫn được tính đầy đủ vào thời gian trống."
          }
