    "그동안 찍어 둔 회고 %lld개로 잘 되는 요일과 시간대, 자주 미루는 일을 보여 드립니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše dosavadní ohlédnutí (%lld) ukazují, které dny a časy vám vyhovují a co pořád odkládáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine %lld gennemgange indtil nu viser, hvilke dage og tidspunkter der fungerer for dig, og hvad du bliver ved med at udskyde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine bisherigen %lld Rückblicke zeigen, welche Tage und Uhrzeiten für dich funktionieren und was du immer wieder aufschiebst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι %lld ανασκοπήσεις σου μέχρι τώρα δείχνουν ποιες ημέρες και ώρες σου ταιριάζουν και τι αναβάλλεις συνέχεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %lld reviews so far show which days and times work for you, and what you keep putting off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus %lld revisiones hasta ahora muestran qué días y horas te funcionan, y qué sueles aplazar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tähänastiset %lld katsaustasi näyttävät, mitkä päivät ja ajat sopivat sinulle ja mitä lykkäät jatkuvasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos %lld bilans montrent quels jours et quelles heures vous réussissent, et ce que vous remettez sans cesse à plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld tinjauan Anda sejauh ini menunjukkan hari dan jam yang cocok bagi Anda, dan apa yang terus Anda tunda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue %lld revisioni finora mostrano in quali giorni e orari rendi meglio e cosa continui a rimandare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これまでの%lld件の振り返りから、うまくいく曜日と時間帯、つい先延ばしにしていることをお見せします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %lld gjennomgangene dine så langt viser hvilke dager og tidspunkter som fungerer for deg, og hva du stadig utsetter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je %lld terugblikken tot nu toe laten zien welke dagen en tijden voor je werken, en wat je steeds uitstelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje podsumowania (%lld) pokazują, które dni i pory Ci służą i co ciągle odkładasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas %lld revisões até agora mostram quais dias e horários funcionam para você e o que você vive adiando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши итоги (%lld) показывают, какие дни и часы вам удаются и что вы постоянно откладываете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina %lld genomgångar hittills visar vilka dagar och tider som fungerar för dig, och vad du hela tiden skjuter upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การทบทวน %lld ครั้งที่ผ่านมาแสดงให้เห็นว่าวันและช่วงเวลาไหนเหมาะกับคุณ และอะไรที่คุณมักเลื่อนออกไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdiye kadarki %lld değerlendirmeniz hangi gün ve saatlerin size uyduğunu, neyi sürekli ertelediğinizi gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld lần nhìn lại của bạn cho thấy ngày và giờ nào hợp với bạn, và việc gì bạn hay trì hoãn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据你至今记下的 %lld 条复盘，告诉你哪些日子和时段最顺手，以及你常拖延的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據你至今記下的 %lld 則回顧，告訴你哪些日子和時段最順手，以及你常拖延的事。"
          }
        }
      }
    },
