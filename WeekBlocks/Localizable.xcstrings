    },
    "타이머로 잰 일이 쌓이면 일마다 실제로 얼마나 걸렸는지 여기에 보입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you time tasks, you’ll see here how long each one really takes."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用計時器測量的事情累積後，這裡會顯示每件事實際花了多久。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用计时器测量的事情积累后，这里会显示每件事实际用了多久。"
