            "state" : "translated",
            "value" : "แยกชิ้นย่อยกับช่วงเวลายาวแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parçalar ve odak süreleri ayrılmış"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mảnh và quãng đã được tách riêng"
