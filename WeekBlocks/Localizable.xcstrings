    "어디까지 했는지 다시 읽어 와야 시작됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Než začnete, musíte si přečíst, kde jste skončili."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal læse dig ind på, hvor du slap, før det går i gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst erst nachlesen, wo du aufgehört hast, bevor es losgeht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρέπει να ξαναδιαβάσεις πού είχες μείνει για να ξεκινήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have to read back where you left off before it starts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de empezar tienes que releer dónde lo dejaste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinun on luettava, mihin jäit, ennen kuin pääset alkuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut relire où vous en étiez avant de pouvoir commencer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda harus membaca ulang posisi terakhir sebelum bisa mulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di iniziare devi rileggere dove eri rimasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこまでやったか読み直してからでないと始められません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du må lese deg inn på hvor du slapp, før det kommer i gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je moet eerst teruglezen waar je was gebleven voordat het begint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw trzeba sobie przypomnieć, gdzie się skończyło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa reler onde parou antes de começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала нужно вспомнить, на чём остановились."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du måste läsa in var du slutade innan det kommer igång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณต้องอ่านทวนว่าทำค้างไว้ถึงไหนก่อนจึงจะเริ่มได้"
