    "한 주를 보여 주는 차례만 바뀝니다. 적어 둔 계획과 루틴은 그대로이고, 아이폰 앱과도 그대로 맞습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the order the week is shown in changes. Your plans and routines stay as they are and still match the iPhone app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会改变一周的显示顺序。已写下的计划和作息都不变，也仍与 iPhone App 同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會改變一週的顯示順序。已寫下的計畫和作息都不變，也仍與 iPhone App 同步。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Reihenfolge der Anzeige ändert sich. Deine Pläne und Routinen bleiben, wie sie sind, und passen weiterhin zur iPhone-App."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1週間を表示する順番だけが変わります。書いた予定やルーティンはそのままで、iPhoneアプリともそのまま一致します。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia el orden en que se muestra la semana. Tus planes y rutinas se quedan como están y siguen coincidiendo con la app del iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul l’ordre d’affichage de la semaine change. Vos plans et routines restent tels quels et correspondent toujours à l’app iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia solo l’ordine in cui viene mostrata la settimana. Piani e routine restano come sono e continuano a corrispondere all’app per iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só muda a ordem em que a semana é mostrada. Seus planos e rotinas continuam como estão e batem com o app do iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняется только порядок, в котором показана неделя. Планы и рутины остаются как есть и по-прежнему совпадают с приложением для iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mění se jen pořadí, v jakém se týden zobrazuje. Vaše plány a rutiny zůstanou, jak jsou, a stále odpovídají aplikaci pro iPhone."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun rækkefølgen, ugen vises i, ændres. Dine planer og rutiner forbliver som de er og passer stadig med iPhone-appen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλάζει μόνο η σειρά με την οποία εμφανίζεται η εβδομάδα. Τα πλάνα και οι ρουτίνες σου μένουν ως έχουν και ταιριάζουν ακόμη με την εφαρμογή του iPhone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain viikon näyttöjärjestys muuttuu. Suunnitelmasi ja rutiinisi pysyvät ennallaan ja vastaavat yhä iPhone-appia."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang berubah hanya urutan tampilan minggu. Rencana dan rutinitas Anda tetap sama dan tetap cocok dengan app iPhone."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare rekkefølgen uken vises i, endres. Planene og rutinene dine blir som de er og stemmer fortsatt med iPhone-appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de volgorde waarin de week wordt getoond verandert. Je plannen en routines blijven zoals ze zijn en komen nog steeds overeen met de iPhone-app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia się tylko kolejność wyświetlania tygodnia. Plany i rutyny zostają bez zmian i nadal zgadzają się z aplikacją na iPhonie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara ordningen veckan visas i ändras. Dina planer och rutiner är som de är och stämmer fortfarande med iPhone-appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนเฉพาะลำดับการแสดงสัปดาห์ แผนและกิจวัตรของคุณยังเหมือนเดิม และยังตรงกับแอป iPhone"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca haftanın gösterilme sırası değişir. Planlarınız ve rutinleriniz olduğu gibi kalır ve iPhone uygulamasıyla uyumlu olmaya devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ thứ tự hiển thị của tuần thay đổi. Kế hoạch và thói quen của bạn vẫn giữ nguyên và vẫn khớp với ứng dụng iPhone."
          }
        }
      }
    },
    "한 주를 짜는 순서(고정 루틴 → 할 일 → 요일에 올리기)를 처음부터 다시 봅니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walks through building a week again from the start: fixed routines → to-dos → placing them on days."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从头再看一次安排一周的步骤：固定作息 → 待办事项 → 排入星期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從頭再看一次安排一週的步驟：固定作息 → 待辦事項 → 排入星期。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt noch einmal von vorn, wie man eine Woche aufbaut: feste Routinen → Aufgaben → auf Tage verteilen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1週間を組む手順（固定ルーティン → やること → 曜日に配置）を最初からもう一度見ます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repasa desde el principio cómo construir una semana: rutinas fijas → tareas → colocarlas en los días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprend depuis le début la construction d’une semaine : routines fixes → tâches → placement sur les jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripercorre dall’inizio la costruzione di una settimana: routine fisse → attività → collocazione nei giorni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra de novo, desde o início, como montar uma semana: rotinas fixas → tarefas → colocá-las nos dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает заново, как строить неделю: постоянные рутины → задачи → расстановка по дням."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu od začátku provede sestavením týdne: pevné rutiny → úkoly → rozvržení do dnů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgår igen fra starten, hvordan du bygger en uge: faste rutiner → opgaver → placering på dage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε ξαναπερνά από την αρχή στο χτίσιμο μιας εβδομάδας: σταθερές ρουτίνες → εργασίες → τοποθέτηση σε ημέρες."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käy viikon rakentamisen uudelleen läpi alusta: kiinteät rutiinit → tehtävät → sijoittaminen päiville."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memandu lagi cara menyusun minggu dari awal: rutinitas tetap → tugas → menaruhnya di hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Går gjennom hvordan du bygger en uke, fra starten igjen: faste rutiner → oppgaver → plassering på dager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat opnieuw vanaf het begin zien hoe je een week bouwt: vaste routines → taken → ze op dagen zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje od nowa, jak budować tydzień: stałe rutyny → zadania → rozkładanie na dni."
