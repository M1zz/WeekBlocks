    "할 일 카드를 잡아 요일 칸에 떨어뜨리면 그 요일의 계획이 됩니다. 올려 둔 것도 다른 요일로 다시 끌 수 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chyťte kartu úkolu a pusťte ji na některý den – a stane se plánem toho dne. Později ji můžete přetáhnout i na jiný den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag fat i et opgavekort, og slip det på en dag, så bliver det dagens plan. Du kan også trække det til en anden dag bagefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm eine Aufgabenkarte und leg sie auf einen Tag – schon ist sie der Plan für diesen Tag. Du kannst sie später auch auf einen anderen Tag ziehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιάσε την κάρτα μιας εργασίας και άφησέ τη σε μια ημέρα· γίνεται πλάνο εκείνης της ημέρας. Μπορείς και μετά να τη σύρεις σε άλλη ημέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab a to-do card and drop it on a day, and it becomes that day's plan. You can drag it to another day afterwards too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coge una tarjeta de tarea y suéltala en un día para convertirla en el plan de ese día. Después también puedes arrastrarla a otro día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartu tehtäväkorttiin ja pudota se päivälle, niin siitä tulee sen päivän suunnitelma. Voit vetää sen myöhemmin myös toiselle päivälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une carte de tâche et déposez-la sur un jour : elle devient le plan de ce jour. Vous pouvez ensuite la faire glisser vers un autre jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambil kartu tugas dan taruh di suatu hari, maka jadi rencana hari itu. Setelahnya Anda juga bisa menyeretnya ke hari lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendi la scheda di un’attività e rilasciala su un giorno: diventa il piano di quel giorno. Puoi anche trascinarla su un altro giorno in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やることカードをつかんで曜日の欄にドロップすると、その曜日の予定になります。配置したものも、別の曜日へドラッグし直せます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta tak i et oppgavekort og slipp det på en dag, så blir det dagens plan. Du kan også dra det til en annen dag etterpå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pak een taakkaart en zet hem op een dag neer, dan wordt hij het plan van die dag. Daarna kun je hem ook naar een andere dag slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chwyć kartę zadania i upuść ją na dzień — stanie się planem na ten dzień. Później możesz przeciągnąć ją na inny dzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pegue um cartão de tarefa e solte num dia: ele vira o plano daquele dia. Depois você também pode arrastá-lo para outro dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмите карточку задачи и бросьте на день — она станет планом на этот день. Потом её можно перетащить и на другой день."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta tag i ett uppgiftskort och släpp det på en dag, så blir det dagens plan. Du kan också dra det till en annan dag efteråt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จับการ์ดสิ่งที่ต้องทำแล้ววางลงในวัน ก็จะกลายเป็นแผนของวันนั้น ภายหลังยังลากไปวันอื่นได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir görev kartını tutup bir güne bırakın; o günün planı olur. Sonradan başka bir güne de sürükleyebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nắm một thẻ việc cần làm và thả vào một ngày, nó sẽ thành kế hoạch của ngày đó. Sau đó bạn vẫn kéo được sang ngày khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抓住待办卡片放到某天，就会成为那天的计划。已排入的也能再拖到其他天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抓住待辦卡片放到某天，就會成為那天的計畫。已排入的也能再拖到其他天。"
          }
        }
      }
    },
    "할 일 카드를 잡아 요일 칸에 떨어뜨리면 그 요일의 계획이 됩니다. 올려 둔 뒤에도 다른 요일로 다시 끌 수 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chyťte kartu úkolu a pusťte ji na některý den – a stane se plánem toho dne. I po umístění ji můžete přetáhnout na jiný den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag fat i et opgavekort, og slip det på en dag, så bliver det dagens plan. Også når det er placeret, kan du trække det til en anden dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm eine Aufgabenkarte und leg sie auf einen Tag – schon ist sie der Plan für diesen Tag. Auch danach kannst du sie noch auf einen anderen Tag ziehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιάσε την κάρτα μιας εργασίας και άφησέ τη σε μια ημέρα· γίνεται πλάνο εκείνης της ημέρας. Ακόμη κι αφού τοποθετηθεί, μπορείς να τη σύρεις σε άλλη ημέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab a to-do card and drop it on a day, and it becomes that day's plan. Even once placed, you can drag it to another day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coge una tarjeta de tarea y suéltala en un día para convertirla en el plan de ese día. Incluso una vez colocada, puedes arrastrarla a otro día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartu tehtäväkorttiin ja pudota se päivälle, niin siitä tulee sen päivän suunnitelma. Sijoitettunakin voit vetää sen toiselle päivälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une carte de tâche et déposez-la sur un jour : elle devient le plan de ce jour. Même une fois placée, vous pouvez la faire glisser vers un autre jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambil kartu tugas dan taruh di suatu hari, maka jadi rencana hari itu. Meski sudah ditaruh, Anda bisa menyeretnya ke hari lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendi la scheda di un’attività e rilasciala su un giorno: diventa il piano di quel giorno. Anche dopo averla collocata, puoi trascinarla su un altro giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やることカードをつかんで曜日の欄にドロップすると、その曜日の予定になります。配置したあとでも、別の曜日へドラッグし直せます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta tak i et oppgavekort og slipp det på en dag, så blir det dagens plan. Selv når det er plassert, kan du dra det til en annen dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pak een taakkaart en zet hem op een dag neer, dan wordt hij het plan van die dag. Ook als hij er al staat, kun je hem naar een andere dag slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chwyć kartę zadania i upuść ją na dzień — stanie się planem na ten dzień. Nawet potem możesz przeciągnąć ją na inny dzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pegue um cartão de tarefa e solte num dia: ele vira o plano daquele dia. Mesmo depois de colocado, dá para arrastá-lo para outro dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмите карточку задачи и бросьте на день — она станет планом на этот день. Даже после этого её можно перетащить на другой день."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta tag i ett uppgiftskort och släpp det på en dag, så blir det dagens plan. Även när det är placerat kan du dra det till en annan dag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จับการ์ดสิ่งที่ต้องทำแล้ววางลงในวัน ก็จะกลายเป็นแผนของวันนั้น แม้วางแล้วก็ยังลากไปวันอื่นได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir görev kartını tutup bir güne bırakın; o günün planı olur. Yerleştirdikten sonra da başka bir güne sürükleyebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nắm một thẻ việc cần làm và thả vào một ngày, nó sẽ thành kế hoạch của ngày đó. Kể cả khi đã xếp, bạn vẫn kéo được sang ngày khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抓住待办卡片放到某天，就会成为那天的计划。即使排入后，也能再拖到其他天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抓住待辦卡片放到某天，就會成為那天的計畫。即使排入後，也能再拖到其他天。"
          }
        }
      }
    },
