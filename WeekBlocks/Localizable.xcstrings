    "회사일 같은 이미 확보된 시간 안의 일정입니다. 자유 시간을 추가로 쓰지 않고, 타임라인에서 루틴 위에 겹쳐 표시됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco, co se odehrává uvnitř už vyhrazeného času, třeba pracovní schůzka. Neubírá žádný další volný čas a na časové ose se kreslí přes rutinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noget, der sker inden for tid, du allerede har sikret, som et arbejdsmøde. Det bruger ingen ekstra ledig tid og tegnes oven på rutinen i tidslinjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas, das innerhalb bereits reservierter Zeit stattfindet, etwa ein Meeting während der Arbeit. Es kostet keine zusätzliche freie Zeit und wird in der Zeitachse über der Routine angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτι που γίνεται μέσα σε χρόνο που έχεις ήδη εξασφαλίσει, όπως μια σύσκεψη στη δουλειά. Δεν ξοδεύει επιπλέον ελεύθερο χρόνο και εμφανίζεται πάνω από τη ρουτίνα στη χρονογραμμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something that happens inside time you've already secured, like a work meeting. It doesn't spend any extra free time, and it's drawn on top of the routine in the timeline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que ocurre dentro de un tiempo que ya tienes reservado, como una reunión de trabajo. No gasta tiempo libre adicional y se dibuja encima de la rutina en la vista cronológica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotain, joka tapahtuu jo varaamasi ajan sisällä, kuten työpalaveri. Se ei vie lisää vapaata aikaa, ja se piirretään aikajanalla rutiinin päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose qui se déroule dans un temps déjà réservé, comme une réunion au travail. Cela ne consomme pas de temps libre en plus et s’affiche par-dessus la routine dans la vue chronologique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuatu yang terjadi di dalam waktu yang sudah Anda amankan, seperti rapat kantor. Tidak memakai waktu luang tambahan, dan digambar di atas rutinitas di linimasa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa che avviene dentro un tempo già occupato, come una riunione di lavoro. Non consuma altro tempo libero ed è disegnato sopra la routine nella timeline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会社の会議のように、すでに確保した時間の中で行う予定です。空き時間を追加で使わず、タイムラインではルーティンの上に重ねて表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe som skjer innenfor tid du allerede har sikret, som et arbeidsmøte. Det bruker ingen ekstra ledig tid og tegnes oppå rutinen i tidslinjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets wat plaatsvindt binnen tijd die al vastligt, zoals een werkoverleg. Kost geen extra vrije tijd en wordt in de tijdlijn boven op de routine getekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś, co dzieje się w czasie już zarezerwowanym, np. spotkanie w pracy. Nie zużywa dodatkowego wolnego czasu i jest rysowane na rutynie na osi czasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que acontece dentro de um tempo já garantido, como uma reunião de trabalho. Não gasta tempo livre extra e aparece por cima da rotina na linha do tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что происходит внутри уже выделенного времени, например встреча на работе. Не тратит дополнительное свободное время и рисуется поверх рутины на шкале времени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något som sker inom tid du redan har säkrat, som ett möte på jobbet. Det tar ingen extra fri tid och ritas ovanpå rutinen i tidslinjen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่เกิดขึ้นในเวลาที่คุณกันไว้แล้ว เช่น ประชุมงาน ไม่ใช้เวลาว่างเพิ่ม และแสดงทับบนกิจวัตรในไทม์ไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İş toplantısı gibi zaten ayrılmış bir zamanın içinde gerçekleşen şey. Fazladan boş zaman harcamaz ve zaman çizelgesinde rutinin üzerinde gösterilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc diễn ra bên trong khoảng thời gian bạn đã giữ sẵn, như một cuộc họp ở công ty. Không tốn thêm thời gian trống và được vẽ chồng lên thói quen trên dòng thời gian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发生在已占用时间内的安排，例如工作会议。不会额外占用自由时间，并会在时间轴中叠加在作息上方显示。"
          }
        },
        "zh-Hant" : {
