    "아직 오지 않은 날입니다. 끝낸 뒤에 돌아봅니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento den teprve přijde. Ohlédněte se, až skončí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne dag er ikke kommet endnu. Se tilbage, når den er omme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tag kommt erst noch. Blick zurück, wenn er vorbei ist."
