    "%@이(가) 수면 시간에 걸쳐 있어 그만큼 펼쳐 두었어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept part of sleep visible because %@ overlaps it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”与睡眠时段重叠，因此保留了该部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」與睡眠時段重疊，因此保留了該部分。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teil des Schlafs bleibt sichtbar, weil %@ sich damit überschneidet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が睡眠時間にかかっているため、その分を表示しています。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha dejado visible parte del sueño porque %@ se solapa con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie du sommeil reste affichée car %@ le chevauche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parte del sonno resta visibile perché %@ vi si sovrappone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte do sono ficou visível porque %@ se sobrepõe a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часть сна оставлена видимой, потому что на неё заходит «%@»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Část spánku zůstává viditelná, protože se s ní překrývá %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En del af søvnen er stadig synlig, fordi %@ overlapper den."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα μέρος του ύπνου μένει ορατό, επειδή το «%@» επικαλύπτεται μαζί του."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osa unesta jätettiin näkyviin, koska %@ menee sen päälle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebagian waktu tidur tetap ditampilkan karena %@ bertumpuk dengannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En del av søvnen vises fortsatt fordi %@ overlapper den."
          }
        },
        "nl" : {
          "stringUnit" : {
