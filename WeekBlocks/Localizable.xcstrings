        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uykunun bir kısmı görünür bırakıldı; çakışan: %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã giữ lại một phần giờ ngủ vì %@ chồng lên đó."
          }
        },
        "zh-Hans" : {
