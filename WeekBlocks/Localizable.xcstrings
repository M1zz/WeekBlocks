    "%@짜리라 조각 안에 들어갑니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At %@, it fits inside a fragment."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时长 %@，放得进碎片时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時長 %@，放得進碎片時間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ passt es in einen Splitter."
          }
        },
        "ja" : {
          "stringUnit" : {
