    "%@에 있던 것 중 %lld개가 지금 없습니다. 이 기기에서 지운 것이 아닙니다. 다른 기기에서 직접 지운 것이라면 그대로 두셔도 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky, které tu byly %1$@, teď chybí (%2$lld). Nebyly smazány na tomto zařízení. Pokud jste je sami smazali na jiném zařízení, můžete to tak nechat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld elementer, der var her %1$@, er væk nu. De blev ikke slettet på denne enhed. Hvis du selv slettede dem på en anden enhed, kan du lade det være."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld Einträge, die am %1$@ da waren, fehlen jetzt. Sie wurden nicht auf diesem Gerät gelöscht. Wenn du sie selbst auf einem anderen Gerät gelöscht hast, kannst du es so lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld στοιχεία που υπήρχαν στις %1$@ λείπουν τώρα. Δεν διαγράφηκαν σε αυτή τη συσκευή. Αν τα διαγράψατε εσείς σε άλλη συσκευή, μπορείτε να τα αφήσετε έτσι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld items that were here on %1$@ are gone now. They weren't deleted on this device. If you deleted them yourself on another device, you can leave things as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltan %2$lld elementos que estaban el %1$@. No se borraron en este dispositivo. Si los borraste tú en otro dispositivo, puedes dejarlo así."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld kohdetta, jotka olivat tallessa %1$@, puuttuu nyt. Niitä ei poistettu tällä laitteella. Jos poistit ne itse toisella laitteella, voit jättää asian näin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld éléments présents le %1$@ ont disparu. Ils n'ont pas été supprimés sur cet appareil. Si vous les avez supprimés vous-même sur un autre appareil, vous pouvez laisser ainsi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld item yang ada pada %1$@ sekarang hilang. Item itu tidak dihapus di perangkat ini. Jika Anda sendiri menghapusnya di perangkat lain, biarkan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mancano %2$lld elementi che c'erano il %1$@. Non sono stati eliminati su questo dispositivo. Se li hai eliminati tu su un altro dispositivo, puoi lasciare così."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@にあったもののうち%2$lld件が今はありません。このデバイスで削除したものではありません。別のデバイスでご自身が削除したものなら、そのままで構いません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld elementer som var her %1$@, er borte nå. De ble ikke slettet på denne enheten. Hvis du selv slettet dem på en annen enhet, kan du la det være."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld items die er op %1$@ waren, ontbreken nu. Ze zijn niet op dit apparaat verwijderd. Als je ze zelf op een ander apparaat hebt verwijderd, kun je het zo laten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje teraz wpisów, które były tu %1$@ (%2$lld). Nie usunięto ich na tym urządzeniu. Jeśli zostały usunięte przez Ciebie na innym urządzeniu, możesz to tak zostawić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumiram %2$lld itens que estavam aqui em %1$@. Eles não foram apagados neste dispositivo. Se você mesmo os apagou em outro dispositivo, pode deixar assim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропало записей, которые были здесь %1$@: %2$lld. Их удалили не на этом устройстве. Если вы сами удалили их на другом устройстве, можно ничего не делать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld objekt som fanns här %1$@ saknas nu. De raderades inte på den här enheten. Om du själv raderade dem på en annan enhet kan du låta det vara."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld รายการที่เคยมีเมื่อ %1$@ หายไปแล้ว ไม่ได้ลบจากอุปกรณ์นี้ หากคุณลบเองจากอุปกรณ์อื่น ก็ปล่อยไว้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tarihinde olan öğelerden %2$lld tanesi şu an yok. Bu cihazda silinmediler. Başka bir cihazda kendiniz sildiyseniz böyle bırakabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld mục từng có vào %1$@ nay đã không còn. Chúng không bị xóa trên thiết bị này. Nếu chính bạn đã xóa trên thiết bị khác thì cứ để nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 时的内容中有 %2$lld 项现在不见了。它们不是在这台设备上删除的。如果是你在其他设备上亲自删除的，可以保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 時的內容中有 %2$lld 項現在不見了。它們不是在這台裝置上刪除的。如果是你在其他裝置上親自刪除的，可以維持原樣。"
          }
        }
      }
    },
