            "value" : "Con %@ di durata, sta in un frammento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@なので、かけらに収まります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med %@ passer den i en tidslomme."
          }
        },
        "nl" : {
          "stringUnit" : {
