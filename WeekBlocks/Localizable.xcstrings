    "잠, 끼니처럼 빼놓을 수 없는 시간을 먼저 세우면 남는 자리가 실제로 쓸 수 있는 시간이 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte hodiny, které si vzít nedáte – spánek, jídla – a co zbude, je čas, který opravdu můžete využít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt de timer op, du ikke kan tage tilbage – søvn, måltider – så bliver resten tid, du faktisk kan bruge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg die Stunden fest, die du nicht hergeben kannst – Schlaf, Mahlzeiten –, und was übrig bleibt, ist Zeit, die du wirklich nutzen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όρισε τις ώρες που δεν μπορείς να πάρεις πίσω — ύπνο, γεύματα — και ό,τι μένει γίνεται χρόνος που πραγματικά μπορείς να χρησιμοποιήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up the hours you can't take back — sleep, meals — and what's left becomes time you can actually use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija las horas que no puedes recuperar (sueño, comidas) y lo que quede será tiempo que de verdad puedes usar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta tunnit, joita et saa takaisin – uni, ateriat – niin jäljelle jäävästä tulee aikaa, jota oikeasti voit käyttää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez d’abord les heures que vous ne pouvez pas céder (sommeil, repas), et ce qui reste devient du temps vraiment utilisable."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur jam yang tidak bisa diganggu gugat — tidur, makan — dan sisanya jadi waktu yang benar-benar bisa Anda pakai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta le ore che non puoi recuperare, come sonno e pasti, e quello che resta diventa tempo che puoi davvero usare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠や食事のような外せない時間を先に置くと、残った分が本当に使える時間になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg inn timene du ikke kan ta tilbake – søvn, måltider – så blir resten tid du faktisk kan bruke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg eerst de uren vast die je niet kunt missen — slaap, maaltijden — en wat overblijft wordt tijd die je echt kunt gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw godziny, których nie odzyskasz — sen, posiłki — a to, co zostanie, stanie się czasem, którym naprawdę dysponujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina as horas que não dá para abrir mão — sono, refeições — e o que sobra vira tempo que você pode usar de verdade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте часы, которые не отнять, — сон, еду, — и остаток станет временем, которым вы правда можете распорядиться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg upp timmarna du inte kan ta tillbaka – sömn, måltider – så blir det som är kvar tid du faktiskt kan använda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งเวลาที่เอาคืนไม่ได้อย่างการนอนและมื้ออาหารก่อน แล้วเวลาที่เหลือจะกลายเป็นเวลาที่ใช้ได้จริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku, öğünler gibi vazgeçemeyeceğiniz saatleri yerleştirin; geriye kalan, gerçekten kullanabileceğiniz zamandır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt trước những giờ không thể bớt — ngủ, ăn — và phần còn lại sẽ thành thời gian bạn thật sự dùng được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先排好睡眠、吃饭这些省不掉的时间，剩下的才是真正能用的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先排好睡眠、用餐這些省不掉的時間，剩下的才是真正能用的時間。"
          }
        }
      }
    },
    "잠·끼니·일처럼 뺄 수 없는 시간. 여기부터 세웁니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spánek, jídla, práce – hodiny, které si vzít nedáte. Začněte tady."
