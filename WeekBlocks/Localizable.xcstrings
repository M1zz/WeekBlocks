    "돌아왔을 때 무엇부터 하면 되나요? 한 줄이면 충분합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čím začnete, až se vrátíte? Stačí jeden řádek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad skal du gøre først, når du kommer tilbage? Én linje er nok."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Womit fängst du an, wenn du zurückkommst? Eine Zeile genügt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι πρέπει να κάνεις πρώτα όταν επιστρέψεις; Αρκεί μία γραμμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What should you do first when you come back? One line is enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué deberías hacer primero al volver? Basta con una línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä sinun pitäisi tehdä ensin, kun palaat? Yksi rivi riittää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par quoi commencer en revenant ? Une ligne suffit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang harus dilakukan pertama kali saat Anda kembali? Satu baris cukup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa dovresti fare per primo quando riprendi? Basta una riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戻ったとき、何から始めればいいですか？1行で十分です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva bør du gjøre først når du kommer tilbake? Én linje er nok."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat doe je als eerste als je terugkomt? Eén regel is genoeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od czego zacząć po powrocie? Wystarczy jedna linijka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que fazer primeiro quando você voltar? Uma linha basta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С чего начать, когда вернётесь? Хватит одной строки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad ska du göra först när du kommer tillbaka? En rad räcker."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อกลับมาควรเริ่มจากอะไร หนึ่งบรรทัดก็พอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri döndüğünüzde ilk ne yapmalısınız? Tek satır yeter."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi quay lại, bạn nên làm gì trước? Một dòng là đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回来时要先做什么？一行就够了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回來時要先做什麼？一行就夠了。"
          }
        }
      }
    },
