    "기존 루틴 시간 안에서 진행 (회의 등)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs inside an existing routine (a meeting, say)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已有作息时间内进行（例如会议）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在既有作息時間內進行（例如會議）"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet innerhalb einer bestehenden Routine statt (z. B. ein Meeting)"
          }
        },
        "ja" : {
