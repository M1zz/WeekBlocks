        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilket tidspunkt hver dag"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe laat elke dag"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O której codziennie"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken tid varje dag"
          }
        },
        "th" : {
          "stringUnit" : {
