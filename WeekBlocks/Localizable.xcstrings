    "잘 굴러간 주의 계획을 이번 주에 한 번에 깝니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přeneste týden, který se povedl, na tento týden jedním tahem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg en uge, der gik godt, ind i denne uge i ét hug."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übertrage eine Woche, die gut lief, mit einem Klick auf diese Woche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε μια εβδομάδα που πήγε καλά σε αυτή την εβδομάδα με μία κίνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lay a week that went well onto this week in one go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca de una vez en esta semana una semana que fue bien."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta hyvin mennyt viikko tälle viikolle yhdellä kertaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reportez d’un coup sur cette semaine une semaine qui a bien fonctionné."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terapkan sekaligus minggu yang berjalan baik ke minggu ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riporta in un colpo solo su questa settimana una settimana andata bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うまくいった週の予定を、今週にまとめて並べます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg en uke som gikk bra, inn i denne uken på én gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een week die goed liep in één keer op deze week."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieś udany tydzień na ten jednym ruchem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque nesta semana, de uma vez, uma semana que deu certo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенесите удачную неделю на эту одним движением."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
