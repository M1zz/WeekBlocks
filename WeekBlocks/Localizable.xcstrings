    "지금은 하루 활동 시간(07:30~19:30)에 고르게 나눈 시각입니다. 고치면 모든 날의 기본이 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jsou rovnoměrně rozložená přes aktivní část dne (07:30–19:30). Když je změníte, stanou se výchozími pro každý den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De er fordelt jævnt over den aktive del af dagen (07.30–19.30). Ændrer du dem, bliver de standard for hver dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind gleichmäßig über den aktiven Tag (07:30–19:30) verteilt. Änderst du sie, werden sie zur Vorgabe für jeden Tag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές είναι μοιρασμένες ομοιόμορφα στις ενεργές ώρες της ημέρας (07:30–19:30). Αν τις αλλάξεις, γίνονται η προεπιλογή για κάθε μέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are spread evenly across the active day (07:30–19:30). Change them and they become the default for every day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Están repartidas por igual a lo largo del día activo (07:30–19:30). Si las cambias, pasan a ser las de todos los días."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä on jaettu tasaisesti aktiiviselle päivälle (7.30–19.30). Kun muutat niitä, niistä tulee oletus jokaiselle päivälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces horaires sont répartis uniformément sur la journée active (07:30–19:30). Modifiez-les et ils deviendront ceux de chaque jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini dibagi rata sepanjang waktu aktif harian (07.30–19.30). Ubah, dan jadi bawaan untuk setiap hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono distribuiti in modo uniforme sulla giornata attiva (07:30–19:30). Modificali e diventeranno il valore predefinito per ogni giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今は1日の活動時間（07:30〜19:30）に均等に分けた時刻です。変更すると毎日のデフォルトになります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse er fordelt jevnt over den aktive delen av dagen (07.30–19.30). Endrer du dem, blir de standard for hver dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze tijden zijn gelijk verdeeld over het actieve deel van de dag (07:30–19:30). Wijzig je ze, dan worden ze de standaard voor elke dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz są rozłożone równo w aktywnej części dnia (07:30–19:30). Zmień je, a staną się domyślne dla każdego dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes horários estão distribuídos por igual no período ativo do dia (07:30–19:30). Mude-os e eles viram o padrão de todos os dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас они равномерно распределены по активной части дня (07:30–19:30). Измените их — и они станут стандартом для всех дней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De är jämnt fördelade över den aktiva dagen (07:30–19:30). Ändrar du dem blir de standard för varje dag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลาเหล่านี้กระจายเท่ากันในช่วงที่ตื่นอยู่ (07:30–19:30) เปลี่ยนแล้วจะกลายเป็นค่าเริ่มต้นของทุกวัน"
