    "화면 아래 '할 일'에 한 줄씩 적습니다. 언제 할지는 아직 정하지 않아도 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pište je po řádcích do Úkolů dole na obrazovce. Kdy je uděláte, zatím rozhodovat nemusíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv dem én linje ad gangen i Opgaver nederst på skærmen. Du behøver ikke beslutte hvornår endnu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib sie Zeile für Zeile unten auf dem Bildschirm in die Aufgaben. Wann du sie erledigst, musst du noch nicht festlegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψ’ τες μία μία στις Εργασίες, στο κάτω μέρος της οθόνης. Δεν χρειάζεται να αποφασίσεις ακόμη πότε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write them one line at a time in To-dos, at the bottom of the screen. You don't have to decide when yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escríbelas de una en una en Tareas, en la parte inferior de la pantalla. Aún no hace falta decidir cuándo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita ne rivi kerrallaan Tehtäviin näytön alareunassa. Aikaa ei tarvitse vielä päättää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez-les une ligne à la fois dans Tâches, en bas de l’écran. Inutile de décider quand pour l’instant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis satu per baris di Tugas, di bagian bawah layar. Belum perlu menentukan kapan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivile una riga alla volta in Attività, in fondo alla schermata. Non serve ancora decidere quando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面下の「やること」に1行ずつ書きます。いつやるかはまだ決めなくて大丈夫です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv dem én linje om gangen i Oppgaver nederst på skjermen. Du trenger ikke bestemme når ennå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf ze regel voor regel op in Taken, onder in het scherm. Wanneer je ze doet, hoef je nog niet te bepalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj je po jednej linijce w „Zadaniach” na dole ekranu. Kiedy je zrobisz, nie musisz jeszcze decydować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva uma por linha em Tarefas, na parte de baixo da tela. Ainda não precisa decidir quando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте их по строке в «Задачи» внизу экрана. Когда делать, решать пока не нужно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv dem en rad i taget i Uppgifter längst ned på skärmen. Du behöver inte bestämma när än."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียนทีละบรรทัดในสิ่งที่ต้องทำที่ด้านล่างของหน้าจอ ยังไม่ต้องตัดสินใจว่าจะทำเมื่อไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranın altındaki Görevler’e her birini bir satır olarak yazın. Ne zaman yapacağınıza henüz karar vermeniz gerekmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi từng dòng một vào Việc cần làm ở cuối màn hình. Chưa cần quyết định khi nào làm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在屏幕下方的“待办事项”中一行写一件。还不用决定什么时候做。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在畫面下方的「待辦事項」中一行寫一件。還不用決定什麼時候做。"
          }
        }
      }
    },
