    "측정 가능한 문장으로 적어 주세요. \"열심히 한다\", \"잘 한다\"는 통과되지 않습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napište něco měřitelného. „Snažit se“ a „udělat to dobře“ neprojdou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv noget, du kan måle. “Arbejde hårdt” og “gøre det godt” går ikke igennem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib etwas Messbares. „Fleißig sein“ und „gut machen“ zählen nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψε κάτι που μετριέται. Το «δουλεύω σκληρά» και το «το κάνω καλά» δεν περνούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write something you can measure. “Work hard” and “do it well” don't pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe algo que se pueda medir. “Esforzarme” o “hacerlo bien” no valen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita jotain mitattavaa. ”Tee kovasti töitä” ja ”tee se hyvin” eivät kelpaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez quelque chose de mesurable. « Travailler dur » ou « bien faire » ne passent pas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis sesuatu yang bisa diukur. “Kerja keras” dan “lakukan dengan baik” tidak lolos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi qualcosa di misurabile. “Impegnarsi” e “farlo bene” non passano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測定できる文で書いてください。「がんばる」「うまくやる」は通りません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv noe du kan måle. «Jobbe hardt» og «gjøre det bra» godtas ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf iets op wat je kunt meten. ‘Hard werken’ en ‘het goed doen’ zijn niet genoeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz coś, co da się zmierzyć. „Pracować ciężko” i „zrobić dobrze” nie przejdą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva algo que dê para medir. “Me esforçar” e “fazer direito” não passam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите то, что можно измерить. «Работать усердно» и «сделать хорошо» не пройдут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv något som går att mäta. ”Jobba hårt” och ”göra det bra” godkänns inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียนสิ่งที่วัดผลได้ “ตั้งใจทำ” หรือ “ทำให้ดี” ไม่ผ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ölçülebilir bir şey yazın. “Çok çalışmak” ya da “iyi yapmak” geçmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy viết điều đo được. “Cố gắng hết sức” hay “làm thật tốt” đều không đạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请写成可以衡量的句子。“努力做”“做好”都不算数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請寫成可以衡量的句子。「努力做」「做好」都不算數。"
          }
        }
      }
    },
