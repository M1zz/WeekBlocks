    "iCloud에서 내려온 변경 뒤에 %lld개가 없어졌습니다. 다른 기기에서 직접 지운 것이라면 그대로 두셔도 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po změnách z iCloudu zmizely položky: %lld. Pokud jste je sami smazali na jiném zařízení, můžete to tak nechat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementer forsvandt efter ændringer fra iCloud. Hvis du selv slettede dem på en anden enhed, kan du lade det være."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Änderungen aus iCloud sind %lld Einträge verschwunden. Wenn du sie selbst auf einem anderen Gerät gelöscht hast, kannst du es so lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από αλλαγές από το iCloud χάθηκαν %lld στοιχεία. Αν τα διαγράψατε εσείς σε άλλη συσκευή, μπορείτε να τα αφήσετε έτσι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld items disappeared after changes came in from iCloud. If you deleted them yourself on another device, you can leave things as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras recibir cambios de iCloud desaparecieron %lld elementos. Si los borraste tú en otro dispositivo, puedes dejarlo así."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudista tulleiden muutosten jälkeen %lld kohdetta katosi. Jos poistit ne itse toisella laitteella, voit jättää asian näin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld éléments ont disparu après des modifications venues d'iCloud. Si vous les avez supprimés vous-même sur un autre appareil, vous pouvez laisser ainsi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld item hilang setelah ada perubahan dari iCloud. Jika Anda sendiri menghapusnya di perangkat lain, biarkan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo alcune modifiche arrivate da iCloud sono spariti %lld elementi. Se li hai eliminati tu su un altro dispositivo, puoi lasciare così."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudから届いた変更のあと、%lld件がなくなりました。別のデバイスでご自身が削除したものなら、そのままで構いません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementer forsvant etter endringer fra iCloud. Hvis du selv slettet dem på en annen enhet, kan du la det være."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na wijzigingen uit iCloud zijn %lld items verdwenen. Als je ze zelf op een ander apparaat hebt verwijderd, kun je het zo laten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zmianach z iCloud zniknęły wpisy: %lld. Jeśli zostały usunięte przez Ciebie na innym urządzeniu, możesz to tak zostawić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld itens sumiram depois de mudanças vindas do iCloud. Se você mesmo os apagou em outro dispositivo, pode deixar assim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После изменений из iCloud пропало записей: %lld. Если вы сами удалили их на другом устройстве, можно ничего не делать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld objekt försvann efter ändringar från iCloud. Om du själv raderade dem på en annan enhet kan du låta det vara."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังมีการเปลี่ยนแปลงจาก iCloud มี %lld รายการหายไป หากคุณลบเองจากอุปกรณ์อื่น ก็ปล่อยไว้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud'dan gelen değişikliklerden sonra %lld öğe kayboldu. Başka bir cihazda kendiniz sildiyseniz böyle bırakabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mục đã biến mất sau khi có thay đổi từ iCloud. Nếu chính bạn đã xóa trên thiết bị khác thì cứ để nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 iCloud 同步来的更改之后，有 %lld 项不见了。如果是你在其他设备上亲自删除的，可以保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 iCloud 同步來的變更之後，有 %lld 項不見了。如果是你在其他裝置上親自刪除的，可以維持原樣。"
          }
