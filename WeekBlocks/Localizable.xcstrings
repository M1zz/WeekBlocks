    "하루 24시간 자 위에서 좌우로 끌면 시각이, 위아래로 끌면 요일이 바뀝니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the 24-hour ruler, drag sideways to change the time and up or down to change the day."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 24 小时标尺上，左右拖动可更改时间，上下拖动可更改星期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 24 小時尺規上，左右拖移可改變時間，上下拖移可改變星期。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem 24-Stunden-Lineal seitlich ziehen, um die Uhrzeit zu ändern, nach oben oder unten für einen anderen Tag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日24時間の目盛りの上で、左右にドラッグすると時刻が、上下にドラッグすると曜日が変わります。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la regla de 24 horas, arrastra a los lados para cambiar la hora y arriba o abajo para cambiar el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur la règle de 24 heures, faites glisser horizontalement pour changer l’heure, et verticalement pour changer de jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla linea delle 24 ore, trascina in orizzontale per cambiare l’orario e in su o in giù per cambiare il giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na régua de 24 horas, arraste para os lados para mudar o horário e para cima ou para baixo para mudar o dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На 24-часовой шкале тяните вбок, чтобы сменить время, и вверх или вниз, чтобы сменить день."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na 24hodinovém pravítku změníte čas tažením do stran a den tažením nahoru nebo dolů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk til siden på 24-timers-linealen for at ændre tidspunktet og op eller ned for at ændre dagen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στον χάρακα των 24 ωρών, σύρε οριζόντια για να αλλάξεις την ώρα και πάνω ή κάτω για να αλλάξεις την ημέρα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda aikaa vetämällä sivuttain 24 tunnin viivaimella ja päivää vetämällä ylös tai alas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di penggaris 24 jam, seret ke samping untuk mengubah jam dan ke atas atau bawah untuk mengubah hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På 24-timerslinjalen drar du sidelengs for å endre tidspunktet og opp eller ned for å endre dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep op de liniaal van 24 uur opzij om de tijd te wijzigen en omhoog of omlaag om de dag te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na 24-godzinnej osi przeciągnij w bok, by zmienić godzinę, a w górę lub w dół, by zmienić dzień."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På 24-timmarslinjalen drar du i sidled för att ändra tiden och uppåt eller nedåt för att byta dag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บนไม้บรรทัด 24 ชั่วโมง ลากซ้ายขวาเพื่อเปลี่ยนเวลา และลากขึ้นลงเพื่อเปลี่ยนวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 saatlik cetvelde saati değiştirmek için yana, günü değiştirmek için yukarı ya da aşağı sürükleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên thước 24 giờ, kéo sang ngang để đổi giờ và kéo lên hoặc xuống để đổi ngày."
          }
        }
      }
    },
