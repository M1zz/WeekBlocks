    "이름에 '수면'이 들어간 고정 루틴이 없어 수면을 접지 못했어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spánek není skrytý, protože žádná pevná rutina nemá v názvu „spánek“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvnen skjules ikke, fordi ingen fast rutine har “søvn” i navnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlaf wird nicht ausgeblendet, weil keine feste Routine „Schlaf“ im Namen trägt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ύπνος δεν αποκρύπτεται, επειδή καμία σταθερή ρουτίνα δεν έχει τη λέξη «ύπνος» στο όνομά της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep isn't hidden because no fixed routine has “sleep” in its name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño no se oculta porque ninguna rutina fija lleva “sueño” en el nombre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unta ei piiloteta, koska minkään kiinteän rutiinin nimessä ei ole sanaa ”uni”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil n’est pas masqué, car aucune routine fixe ne contient « sommeil » dans son nom."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidur tidak disembunyikan karena tidak ada rutinitas tetap yang namanya memuat “tidur”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno non viene nascosto perché nessuna routine fissa ha “sonno” nel nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前に「睡眠」を含む固定ルーティンがないため、睡眠を折りたためませんでした。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvnen skjules ikke fordi ingen fast rutine har «søvn» i navnet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De slaap is niet verborgen omdat geen enkele vaste routine ‘slaap’ in de naam heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen nie jest ukryty, bo żadna stała rutyna nie ma w nazwie słowa „sen”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sono não foi ocultado porque nenhuma rotina fixa tem “sono” no nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон не скрыт: нет постоянной рутины со словом «сон» в названии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sömnen döljs inte eftersom ingen fast rutin har ”sömn” i namnet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้ซ่อนเวลานอน เพราะไม่มีกิจวัตรประจำที่มีคำว่า “นอน” ในชื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adında “uyku” geçen bir sabit rutin olmadığı için uyku gizlenmedi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ẩn giờ ngủ vì không có thói quen cố định nào có chữ “ngủ” trong tên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
