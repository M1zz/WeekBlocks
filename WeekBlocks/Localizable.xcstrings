            "value" : "Когда появится неделя с планом, её можно будет выбрать здесь."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakmile naplánujete nějaký týden, můžete ho vybrat zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har planlagt en uge, kan du vælge den her."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις προγραμματίσεις μια εβδομάδα, θα μπορείς να την επιλέξεις εδώ."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
