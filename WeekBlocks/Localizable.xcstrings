        }
      }
    },
    "끝이 정해져 있지 않아 안 닫힙니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pevný konec chybí, takže se to nikdy neuzavře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ingen fast slutning, så den lukker aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt kein festes Ende, also wird es nie fertig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει σαφές τέλος, οπότε δεν κλείνει ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no fixed end, so it never closes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tiene un final definido, así que nunca se cierra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvää loppua ei ole, joten se ei koskaan valmistu."
