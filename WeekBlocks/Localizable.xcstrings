      }
    },
    "그동안 찍어 둔 회고 %lld개로 잘 되는 요일과 시간대, 자주 미루는 일을 보여 드립니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %lld reviews so far show which days and times work for you, and what you keep putting off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据你至今记下的 %lld 条复盘，告诉你哪些日子和时段最顺手，以及你常拖延的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據你至今記下的 %lld 則回顧，告訴你哪些日子和時段最順手，以及你常拖延的事。"
          }
        }
      }
    },
    "글로 (1시간 0분)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In words (1h 0m)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字（1 小时 0 分）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字（1 小時 0 分）"
          }
        }
      }
    },
    "글쓰기·구현·설계처럼 맥락을 다시 불러와야 하는 일은 조각 크기로 잡아두면 시동만 걸다 끝납니다. 시간을 늘리거나, 그 앞에 '준비' 조각 단계를 따로 두세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writing, building, designing — anything where you have to load the context back in will spend the whole fragment just spinning up. Give them more time, or put a separate “get ready” fragment in front."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写作、开发、设计这类需要重新进入状态的工作，若排成碎片大小，整段时间都会花在热身上。请给它更多时间，或在前面另外放一个“准备”碎片步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫作、實作、設計這類需要重新載入脈絡的工作，若排成碎片大小，整段時間都會花在暖機上。請給它更多時間，或在前面另外放一個「準備」碎片步驟。"
          }
        }
      }
    },
    "금요일" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friday"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星期五"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星期五"
          }
        }
      }
    },
    "기념일·마감일처럼 그날의 일이지만 시간을 차지하지 않습니다. 남은 시간에서 빠지지 않고, 그날 맨 위에 따로 섭니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For things like birthdays or deadlines that belong to the day but don't take up time. They don't count against your free time and sit at the top of the day."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像纪念日、截止日这类属于当天、但不占时间的事。不会从剩余时间中扣除，会单独显示在当天最上方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像紀念日、截止日這類屬於當天、但不占時間的事。不會從剩餘時間中扣除，會單獨顯示在當天最上方。"
          }
        }
      }
    },
    "기본" : {
