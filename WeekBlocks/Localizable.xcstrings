        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdiye kadarki %lld değerlendirmeniz hangi gün ve saatlerin size uyduğunu, neyi sürekli ertelediğinizi gösterir."
