    "가로로 끌어 기간을 고르거나, 두 번 눌러 이날부터 장기 플랜 추가" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tažením do strany vyberte období, nebo dvojitým kliknutím přidejte dlouhodobý plán od tohoto dne"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk henover for at vælge en periode, eller dobbeltklik for at tilføje en langsigtet plan fra denne dag"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
