            "value" : "Các giờ này đang được chia đều trong khoảng thời gian hoạt động của ngày (07:30–19:30). Đổi chúng thì sẽ thành mặc định cho mọi ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
