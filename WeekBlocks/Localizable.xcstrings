    "‘%@’(%@)이 %@ 틈보다 커서 다음 일정과 겹칩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ (%2$@) je delší než mezera %3$@, takže se překrývá s tím, co následuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” (%2$@) er større end hullet på %3$@, så den overlapper det næste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ (%2$@) ist länger als die Lücke von %3$@ und überschneidet sich mit dem nächsten Termin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%1$@» (%2$@) είναι μεγαλύτερο από το κενό των %3$@, οπότε επικαλύπτει ό,τι ακολουθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” (%@) is bigger than the %@ gap, so it overlaps what comes next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” (%2$@) es más largo que el hueco de %3$@, así que se solapa con lo siguiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” (%@) on pidempi kuin %@ rako, joten se menee seuraavan päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » (%2$@) dépasse le créneau de %3$@ et empiète sur ce qui suit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” (%2$@) lebih panjang dari celah %3$@, jadi bertumpuk dengan jadwal berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” (%2$@) è più lungo dello spazio di %3$@, quindi si sovrappone a ciò che viene dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」（%2$@）が%3$@のすき間より長いため、次の予定と重なります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "‘%1$@’(%2$@)이 %3$@ 틈보다 커서 다음 일정과 겹칩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» (%2$@) er større enn luken på %3$@, så den overlapper det som kommer etter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ (%2$@) is groter dan het gat van %3$@ en overlapt dus met wat erna komt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” (%2$@) jest dłuższe niż luka %3$@, więc nachodzi na to, co dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” (%2$@) é maior que o intervalo de %3$@ e se sobrepõe ao que vem depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» (%2$@) не помещается в промежуток %3$@ и наезжает на следующее дело."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%1$@” (%2$@) är längre än luckan på %3$@, så den överlappar det som kommer efter."
