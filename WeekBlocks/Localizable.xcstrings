    "모든 날의 기본 시각입니다. 시간표에서 그날만 옮긴 것은 그날만 따로 섭니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto jsou výchozí časy pro každý den. Co jste na časové ose posunuli v jednotlivém dni, zůstane pro ten den beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er standardtiderne for hver dag. Det, du har flyttet på en enkelt dag i tidslinjen, bliver som det er på den dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind die Standardzeiten für jeden Tag. Was du an einem einzelnen Tag in der Zeitachse verschoben hast, bleibt für diesen Tag so."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές είναι οι προεπιλογές για κάθε μέρα. Ό,τι μετακίνησες για μία μόνο ημέρα στη χρονογραμμή μένει όπως είναι για εκείνη την ημέρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are the defaults for every day. Anything you moved on a single day in the timeline stays as it is for that day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son los valores por omisión para todos los días. Lo que hayas movido un día concreto en la vista cronológica se mantiene así ese día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä ovat oletukset jokaiselle päivälle. Aikajanalla yksittäisenä päivänä siirtämäsi kohteet pysyvät sellaisinaan sinä päivänä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce sont les horaires par défaut de chaque jour. Ce que vous avez déplacé un jour précis dans la vue chronologique reste tel quel ce jour-là."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini jam bawaan untuk setiap hari. Yang Anda pindahkan di linimasa untuk satu hari tetap seperti itu pada hari tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi sono gli orari predefiniti per ogni giorno. Ciò che hai spostato in un singolo giorno nella timeline resta com’è per quel giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日のデフォルトの時刻です。タイムラインでその日だけ動かしたものは、その日だけそのまま残ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er standardtidene for hver dag. Det du har flyttet på én enkelt dag i tidslinjen, blir værende som det er den dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zijn de standaardtijden voor elke dag. Wat je op één dag in de tijdlijn hebt verplaatst, blijft voor die dag zoals het is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To domyślne godziny dla każdego dnia. To, co przesunięto na osi czasu w konkretnym dniu, zostaje tam bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes são os horários padrão de todos os dias. O que você moveu num dia específico na linha do tempo continua como está naquele dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это время по умолчанию для всех дней. То, что вы сдвинули на шкале времени в конкретный день, в этот день останется как есть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här är standardtiderna för varje dag. Det du flyttat på en enskild dag i tidslinjen förblir som det är den dagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่คือค่าเริ่มต้นของทุกวัน รายการที่คุณย้ายเฉพาะวันใดวันหนึ่งในไทม์ไลน์จะยังคงอยู่อย่างนั้นสำหรับวันนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar her günün varsayılan saatleridir. Zaman çizelgesinde tek bir günde taşıdıklarınız o gün için olduğu gibi kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là mặc định cho mọi ngày. Những gì bạn đã dời riêng một ngày trên dòng thời gian vẫn giữ nguyên cho ngày đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是每天的默认时间。在时间表上只移动某一天的，会保持那天的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是每天的預設時間。在時間表上只移動某一天的，會維持那天的設定。"
          }
