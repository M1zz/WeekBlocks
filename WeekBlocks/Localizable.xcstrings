    "회고 추세와 다른 주 계획 가져오기가 열려 있습니다. 같은 Apple 계정의 다른 맥에서도 열립니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trendy ohlédnutí a kopírování jiného týdne jsou odemčené – i na vašich dalších Macích se stejným Apple účtem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendenser i gennemgange og kopiering fra en anden uge er låst op. Det gælder også dine andre Mac-computere med samme Apple-konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückblick-Trends und das Kopieren anderer Wochen sind freigeschaltet – auch auf deinen anderen Macs mit demselben Apple Account."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τάσεις ανασκόπησης και η αντιγραφή άλλης εβδομάδας είναι ξεκλείδωτες. Ξεκλειδώνονται και στα άλλα σου Mac με τον ίδιο Λογαριασμό Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflection trends and copying another week are unlocked. They also unlock on your other Macs with the same Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tendencias de revisión y copiar otra semana están desbloqueadas. También se desbloquean en tus otros Mac con la misma cuenta de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohdintojen trendit ja toisen viikon kopiointi ovat käytössä. Ne avautuvat myös muilla Maceillasi samalla Apple-tilillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tendances des bilans et la copie d’autres semaines sont déverrouillées. Elles le sont aussi sur vos autres Mac associés au même compte Apple."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tren refleksi dan salin minggu lain kini terbuka. Juga terbuka di Mac lain dengan Akun Apple yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tendenze delle revisioni e la copia da un’altra settimana sono sbloccate. Si sbloccano anche sugli altri Mac con lo stesso Apple Account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "振り返りの推移と別の週の予定のコピーが利用できます。同じApple Accountの他のMacでも利用できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trender i gjennomganger og kopiering fra en annen uke er låst opp. Det gjelder også de andre Mac-maskinene dine med samme Apple-konto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trends in terugblikken en een andere week kopiëren zijn ontgrendeld. Ze zijn ook ontgrendeld op je andere Macs met hetzelfde Apple Account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trendy podsumowań i kopiowanie innego tygodnia są odblokowane. Odblokują się też na innych Twoich Macach z tym samym Apple Account."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendências das revisões e copiar outra semana estão desbloqueados. Também ficam desbloqueados nos seus outros Macs com a mesma Conta Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренды итогов и копирование другой недели открыты. Они также доступны на других ваших Mac с тем же Apple Account."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trender i genomgångarna och kopiering från en annan vecka är upplåsta. De låses också upp på dina andra Mac-datorer med samma Apple-konto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปลดล็อกแนวโน้มการทบทวนและการคัดลอกสัปดาห์อื่นแล้ว ใช้ได้บน Mac เครื่องอื่นที่ใช้บัญชี Apple เดียวกันด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değerlendirme eğilimleri ve başka haftaları kopyalama açık. Aynı Apple Hesabı’ndaki diğer Mac’lerinizde de açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xu hướng nhìn lại và chép tuần khác đã được mở khóa. Chúng cũng được mở khóa trên các máy Mac khác dùng cùng Tài khoản Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复盘趋势和复制其他周计划的功能已解锁。同一 Apple 账户的其他 Mac 也会解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回顧趨勢和複製其他週計畫的功能已解鎖。同一個 Apple 帳號的其他 Mac 也會解鎖。"
          }
        }
      }
    },
    "회고를 찍어 두면 잘 되는 요일과 시간대, 자주 미루는 일이 여기에 섭니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označujte svá ohlédnutí a tady uvidíte, které dny a časy vám vyhovují a co pořád odkládáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markér dine gennemgange, så viser dette, hvilke dage og tidspunkter der fungerer for dig, og hvad du bliver ved med at udskyde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere deine Rückblicke, dann zeigt sich hier, welche Tage und Uhrzeiten für dich funktionieren und was du immer wieder aufschiebst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σήμανε τις ανασκοπήσεις σου και εδώ θα φαίνεται ποιες ημέρες και ώρες σου ταιριάζουν και τι αναβάλλεις συνέχεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark your reviews and this shows which days and times work for you, and what you keep putting off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca tus revisiones y aquí verás qué días y horas te funcionan, y qué sueles aplazar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkitse katsauksesi, niin tämä näyttää, mitkä päivät ja ajat sopivat sinulle ja mitä lykkäät jatkuvasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites vos bilans et vous verrez ici quels jours et quelles heures vous réussissent, et ce que vous remettez sans cesse à plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tandai tinjauan Anda, dan di sini akan terlihat hari dan jam yang cocok bagi Anda, serta apa yang terus Anda tunda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna le tue revisioni e qui vedrai in quali giorni e orari rendi meglio e cosa continui a rimandare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "振り返りを記録していくと、うまくいく曜日と時間帯、つい先延ばしにすることがここに表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marker gjennomgangene dine, så viser dette hvilke dager og tidspunkter som fungerer for deg, og hva du stadig utsetter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeer je terugblikken en hier zie je welke dagen en tijden voor je werken, en wat je steeds uitstelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznaczaj podsumowania, a tu pojawi się, które dni i pory Ci służą i co ciągle odkładasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque suas revisões e aqui aparecerão os dias e horários que funcionam para você e o que você vive adiando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечайте итоги, и здесь появится, какие дни и часы вам удаются и что вы постоянно откладываете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markera dina genomgångar så visar det här vilka dagar och tider som fungerar för dig och vad du hela tiden skjuter upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำเครื่องหมายการทบทวนไว้ ส่วนนี้จะแสดงว่าวันและช่วงเวลาไหนเหมาะกับคุณ และอะไรที่คุณมักเลื่อนออกไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değerlendirmelerinizi işaretleyin; hangi gün ve saatlerin size uyduğu ve neyi sürekli ertelediğiniz burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đánh dấu phần nhìn lại, nơi này sẽ cho thấy ngày và giờ nào hợp với bạn, và việc gì bạn hay trì hoãn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记复盘后，这里会显示哪些日子和时段最顺手，以及常拖延的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標記回顧後，這裡會顯示哪些日子和時段最順手，以及常拖延的事。"
          }
        }
      }
    },
    "회고를 찍은 블록 중에서 셉니다. 부분 달성은 반으로 칩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítáno ze zhodnocených bloků. Částečně hotové se počítá napůl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tælles blandt gennemgåede blokke. Delvist klaret tæller som en halv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezählt unter den bewerteten Blöcken. Teilweise erledigt zählt halb."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετράει μόνο στα μπλοκ με ανασκόπηση. Το «εν μέρει» μετράει μισό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counted among reviewed blocks. Partly done counts as half."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cuenta entre los bloques revisados. Hecho en parte cuenta como la mitad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasketaan arvioiduista lohkoista. Osittain tehty lasketaan puolikkaana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculé sur les blocs ayant un bilan. « Fait en partie » compte pour moitié."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihitung dari blok yang sudah ditinjau. Selesai sebagian dihitung setengah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcolato sui blocchi rivisti. Fatto in parte conta come metà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "振り返りを記録したブロックの中で数えます。一部完了は半分として数えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telles blant gjennomgåtte blokker. Delvis gjort teller som en halv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteld onder blokken met een terugblik. Deels gedaan telt voor de helft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczone spośród podsumowanych bloków. Częściowo zrobione liczy się za pół."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contado entre os blocos revisados. Parcial conta como metade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считается по блокам с итогами. Частичное выполнение — за половину."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räknas bland genomgångna block. Delvis klart räknas som hälften."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับจากบล็อกที่ทบทวนแล้ว เสร็จบางส่วนนับเป็นครึ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değerlendirilen bloklar arasında sayılır. Kısmen bitti yarım sayılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính trong số các khối đã nhìn lại. Xong một phần được tính là một nửa."
