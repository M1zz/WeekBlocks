    "계획을 세운 주가 생기면 여기에서 고를 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once you have planned a week, you can pick it here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有了已安排计划的周，就能在这里选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
