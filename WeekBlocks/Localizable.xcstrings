    "번번이 미루는 일은 크기가 너무 크거나 시간대가 안 맞는 경우가 많습니다. 단계로 쪼개거나 잘 되는 시간대로 옮겨 보세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Věci, které pořád přeskakujete, jsou často příliš velké nebo v nevhodnou denní dobu. Zkuste je rozdělit na kroky nebo přesunout do času, který vám vyhovuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ting, du bliver ved med at springe over, er ofte for store eller ligger på det forkerte tidspunkt af dagen. Prøv at dele dem op i trin eller flytte dem til et tidspunkt, der fungerer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du immer wieder überspringst, ist oft zu groß oder liegt zur falschen Tageszeit. Teile es in Schritte auf oder verschiebe es in eine Zeit, die besser passt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ό,τι αναβάλλεις συνέχεια είναι συχνά πολύ μεγάλο ή σε λάθος ώρα της ημέρας. Δοκίμασε να το χωρίσεις σε βήματα ή να το μετακινήσεις σε ώρα που σου ταιριάζει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Things you keep skipping are often too big or in the wrong time of day. Try splitting them into steps or moving them to a time that works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que siempre aplazas suele ser demasiado grande o estar en una hora del día que no te va. Prueba a dividirlo en pasos o a moverlo a una hora que te funcione."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatkuvasti ohitetut asiat ovat usein liian suuria tai väärään vuorokaudenaikaan. Kokeile pilkkoa ne vaiheisiin tai siirtää ne sopivampaan aikaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous repoussez sans cesse est souvent trop gros ou placé au mauvais moment de la journée. Essayez de le découper en étapes ou de le déplacer à un moment qui vous convient."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal yang terus dilewati sering kali terlalu besar atau berada di jam yang salah. Coba pecah jadi langkah atau pindahkan ke jam yang cocok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cose che continui a saltare spesso sono troppo grandi o nell’orario sbagliato. Prova a suddividerle in fasi o a spostarle in un orario che funziona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何度も先延ばしにしてしまうことは、大きすぎるか時間帯が合っていないことがよくあります。ステップに分けるか、うまくいく時間帯に移してみましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ting du stadig hopper over, er ofte for store eller ligger på feil tid av døgnet. Prøv å dele dem opp i trinn eller flytte dem til et tidspunkt som passer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je steeds overslaat, is vaak te groot of staat op het verkeerde moment van de dag. Splits het op in stappen of verplaats het naar een tijd die werkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rzeczy, które ciągle odkładasz, często są za duże albo stoją o złej porze. Podziel je na kroki albo przenieś na porę, która Ci służy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você vive pulando costuma ser grande demais ou estar no horário errado. Tente dividir em etapas ou mudar para um horário que funcione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дела, которые вы постоянно откладываете, часто слишком велики или стоят не в то время. Разбейте их на шаги или перенесите на удачное время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du hela tiden hoppar över är ofta för stort eller ligger på fel tid på dagen. Prova att dela upp det i steg eller flytta det till en tid som fungerar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่คุณข้ามบ่อยๆ มักใหญ่เกินไป หรืออยู่ผิดช่วงเวลาของวัน ลองแบ่งเป็นขั้นตอน หรือย้ายไปช่วงเวลาที่ทำได้ดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürekli atladığınız işler çoğu zaman çok büyüktür ya da günün yanlış saatindedir. Adımlara bölmeyi ya da size uyan bir saate taşımayı deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc bạn cứ bỏ qua thường là quá lớn hoặc đặt sai thời điểm trong ngày. Hãy thử chia thành các bước hoặc dời sang khung giờ hợp hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一再推迟的事，往往是太大或时段不对。试着拆分成步骤，或移到顺手的时段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一再延後的事，往往是太大或時段不對。試著拆分成步驟，或移到順手的時段。"
          }
        }
      }
    },
