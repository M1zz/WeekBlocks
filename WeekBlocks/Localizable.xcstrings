    "회차마다 시간과 내용이 다른 과정에 씁니다. 회차가 있으면 그 날들만 진하게 서고, 저장하면 회차마다 일간에 블록이 생깁니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro kurzy, kde má každá lekce jiný čas a obsah. S lekcemi se zvýrazní jen tyto dny a po uložení vznikne pro každou lekci blok v denním přehledu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til forløb, hvor hver session har sin egen tid og sit eget indhold. Med sessioner fremhæves kun de dage, og når du gemmer, får hver session en blok i dagsvisningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Kurse, bei denen jeder Termin eigene Dauer und Inhalte hat. Mit Terminen werden nur diese Tage hervorgehoben, und beim Sichern entsteht für jeden Termin ein Block in der Tagesansicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για προγράμματα όπου κάθε συνεδρία έχει δική της διάρκεια και περιεχόμενο. Με συνεδρίες τονίζονται μόνο αυτές οι ημέρες και με την αποθήκευση δημιουργείται μπλοκ για κάθε συνεδρία στην ημερήσια προβολή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For courses where each session has its own length and content. With sessions, only those days are highlighted, and saving adds a block for each session to the day view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cursos en los que cada sesión tiene su propia duración y contenido. Con sesiones solo se resaltan esos días y, al guardar, cada sesión crea un bloque en la vista diaria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursseille, joissa jokaisella kerralla on oma kesto ja sisältö. Kun kertoja on, vain ne päivät korostuvat, ja tallennettaessa jokaisesta kerrasta tulee lohko päivänäkymään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les cursus où chaque séance a sa propre durée et son contenu. Avec des séances, seuls ces jours sont mis en avant et, à l’enregistrement, chaque séance devient un bloc dans la vue du jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk kursus yang tiap sesinya punya durasi dan isi berbeda. Jika ada sesi, hanya hari-hari itu yang ditebalkan, dan saat disimpan tiap sesi menjadi blok di tampilan harian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per corsi in cui ogni sessione ha durata e contenuti propri. Con le sessioni vengono evidenziati solo quei giorni e, salvando, ogni sessione diventa un blocco nella vista giornaliera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回ごとに時間と内容が違う講座に使います。回があるとその日だけが濃く表示され、保存すると回ごとに日表示にブロックができます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For kurs der hver økt har egen varighet og eget innhold. Med økter fremheves bare de dagene, og når du lagrer, får hver økt en blokk i dagsvisningen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor cursussen waarbij elke sessie een eigen duur en inhoud heeft. Met sessies worden alleen die dagen uitgelicht en bij bewaren krijgt elke sessie een blok in de dagweergave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do kursów, w których każda sesja ma własny czas i treść. Przy sesjach wyróżnione są tylko te dni, a po zapisaniu każda sesja staje się blokiem w widoku dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cursos em que cada sessão tem duração e conteúdo próprios. Com sessões, só esses dias ficam destacados e, ao salvar, cada sessão vira um bloco na visão do dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для курсов, где у каждого занятия своя длительность и содержание. С занятиями выделяются только эти дни, а при сохранении каждое занятие становится блоком в дневном виде."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För kurser där varje tillfälle har egen längd och eget innehåll. Med tillfällen markeras bara de dagarna, och när du sparar får varje tillfälle ett block i dagsvyn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กับหลักสูตรที่แต่ละครั้งมีเวลาและเนื้อหาต่างกัน เมื่อมีครั้ง จะเน้นเฉพาะวันเหล่านั้น และเมื่อบันทึก แต่ละครั้งจะกลายเป็นบล็อกในมุมมองรายวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her oturumun süresi ve içeriği farklı olan kurslar için. Oturum varsa yalnızca o günler vurgulanır ve kaydedince her oturum günlük görünümde bir blok olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dành cho khoá học mà mỗi buổi có thời lượng và nội dung riêng. Khi có buổi, chỉ những ngày đó được tô đậm, và khi lưu, mỗi buổi thành một khối trong chế độ xem ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于每次课时长和内容都不同的课程。有课次时只突出这些日子，保存后每个课次都会在日视图中生成一个方块。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於每次課時長和內容都不同的課程。有課次時只突顯這些日子，儲存後每個課次都會在日檢視中產生一個方塊。"
          }
        }
      }
    },
