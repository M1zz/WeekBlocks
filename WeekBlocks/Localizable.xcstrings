          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah Anda merencanakan satu minggu, Anda bisa memilihnya di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har planlagt en uke, kan du velge den her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra je een week hebt gepland, kun je die hier kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy zaplanujesz jakiś tydzień, wybierzesz go tutaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du har planerat en vecka kan du välja den här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อมีสัปดาห์ที่วางแผนไว้แล้ว จะเลือกได้ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir haftayı planladığınızda onu buradan seçebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
