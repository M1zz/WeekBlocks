        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ha una fine definita, quindi non si chiude mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終わりが決まっていないので、閉じられません。"
