        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus melhores dias e horários, e o que você vive adiando. As últimas 2 semanas são grátis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши лучшие дни и часы и то, что вы постоянно откладываете. Последние 2 недели — бесплатно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
