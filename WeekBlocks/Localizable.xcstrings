    "충분히 구체적입니다. 끝난 뒤 잘 보냈는지 판단할 수 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dost konkrétní. Až to skončí, poznáte, jestli se to povedlo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkret nok. Når det er overstået, kan du se, om det gik godt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkret genug. Hinterher kannst du beurteilen, ob es gut lief."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρκετά συγκεκριμένο. Όταν τελειώσει, θα μπορείς να πεις αν πήγε καλά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concrete enough. When it's over you'll be able to tell whether it went well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suficientemente concreto. Cuando acabe, podrás saber si ha ido bien."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riittävän konkreettinen. Kun se on ohi, osaat sanoa, menikö se hyvin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assez précis. Une fois terminé, vous pourrez dire si cela s’est bien passé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah cukup jelas. Setelah selesai, Anda bisa menilai apakah berhasil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbastanza concreto. Alla fine potrai capire se è andata bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十分に具体的です。終わったあと、うまく過ごせたか判断できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkret nok. Når det er over, kan du se om det gikk bra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concreet genoeg. Als het voorbij is, kun je zeggen of het goed ging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystarczająco konkretne. Po wszystkim będziesz wiedzieć, czy poszło dobrze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concreto o bastante. Quando acabar, você saberá dizer se deu certo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достаточно конкретно. Когда всё закончится, вы сможете понять, удалось ли."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillräckligt konkret. När det är över kan du avgöra om det gick bra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชัดเจนพอแล้ว เมื่อจบคุณจะบอกได้ว่าไปได้ดีหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeterince somut. Bittiğinde iyi geçip geçmediğini söyleyebileceksiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đủ cụ thể. Khi xong, bạn sẽ biết được việc đó có ổn không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "够具体了。结束后就能判断进行得好不好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夠具體了。結束後就能判斷進行得好不好。"
          }
        }
      }
    },
