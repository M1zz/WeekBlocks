    "루틴입니다 — 했는지 묻지 않습니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A routine — it doesn’t ask whether you did it"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是作息 — 不会问你做了没"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是作息 — 不會問你做了沒"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Routine – hier wird nicht gefragt, ob du sie erledigt hast"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルーティンです — 完了したかは尋ねません"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una rutina: no pregunta si la has hecho"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une routine : la question « fait ou pas » ne se pose pas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È una routine: non ti chiede se l’hai fatta"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma rotina — não pergunta se você fez"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это рутина — отмечать не нужно"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutina – neptá se, zda jste ji splnili"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rutine — den spørger ikke, om du har gjort den"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρουτίνα — δεν ρωτά αν την έκανες"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutiini – siitä ei kysytä, teitkö sen"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutinitas — tidak ditanya apakah sudah dilakukan"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rutine – den spør ikke om du har gjort den"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een routine — vraagt niet of je het hebt gedaan"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To rutyna — nie trzeba odhaczać"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rutin – den frågar inte om du gjort den"
          }
        },
        "th" : {
