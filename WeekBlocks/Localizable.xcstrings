    "%@\n눌러서 상세 · 같은 요일 안에서 끌어 시각 옮기기 · 우클릭으로 타이머 시작·삭제" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nClick for details · drag within the same day to change the time · right-click to start the timer or delete it"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n点击查看详情 · 在同一天内拖动可调整时间 · 右键可启动计时器或删除"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
