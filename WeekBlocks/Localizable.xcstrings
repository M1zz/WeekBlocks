        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@, cabe en un fragmento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@, cela tient dans un fragment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ di durata, sta in un frammento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@, cabe num fragmento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длится %@ — поместится в кусочек."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S délkou %@ se vejde do střípku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med %@ passer den i en tidslomme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με διάρκεια %@, χωράει σε ένα κομμάτι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesto %@ – mahtuu pätkään."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durasinya %@, jadi muat dalam satu kepingan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med %@ passer den i en tidslomme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met %@ past het in een fragment."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwa %@ — zmieści się w okruchu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med %@ ryms den i ett ministeg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เวลา %@ จึงใส่ในชิ้นย่อยได้"
