    "일정에 적힌 시각대로 저절로 셉니다. 날짜 줄 오른쪽과 타이머 창(⇧⌘R)에서 보입니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítá sám podle časů ve vašem rozvrhu. Uvidíte ho vpravo v řádku s datem a v okně časovače (⇧⌘R)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tæller af sig selv ud fra tidspunkterne i din plan. Du ser den til højre for datorækken og i timervinduet (⇧⌘R)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zählt von selbst, nach den Zeiten in deinem Zeitplan. Du siehst ihn rechts in der Datumszeile und im Timer-Fenster (⇧⌘R)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετράει μόνο του, με βάση τις ώρες του προγράμματός σου. Θα το δεις δεξιά στη γραμμή ημερομηνίας και στο παράθυρο χρονομέτρου (⇧⌘R)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It counts on its own, from the times in your schedule. You'll see it at the right of the date row and in the timer window (⇧⌘R)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta solo, según las horas de tu agenda. Lo verás a la derecha de la fila de fechas y en la ventana del temporizador (⇧⌘R)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se laskee itsestään aikataulusi ajoista. Näet sen päivämäärärivin oikeassa reunassa ja ajastinikkunassa (⇧⌘R)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il décompte tout seul, d’après les heures de votre planning. Vous le voyez à droite de la ligne des dates et dans la fenêtre du minuteur (⇧⌘R)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihitung sendiri dari jam di jadwal Anda. Terlihat di kanan baris tanggal dan di jendela timer (⇧⌘R)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta da solo, in base agli orari del programma. Lo vedi a destra della riga delle date e nella finestra del timer (⇧⌘R)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スケジュールに書かれた時刻どおりに自動で数えます。日付の行の右側とタイマーウインドウ（⇧⌘R）に表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den teller av seg selv ut fra tidspunktene i planen din. Du ser den til høyre for datoraden og i tidtakervinduet (⇧⌘R)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt vanzelf, op basis van de tijden in je planning. Je ziet het rechts van de datumregel en in het timervenster (⇧⌘R)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy sam, według godzin z planu. Zobaczysz to po prawej stronie wiersza z datą i w oknie timera (⇧⌘R)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta sozinho, pelos horários da sua agenda. Aparece à direita da linha de datas e na janela do timer (⇧⌘R)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считает сам по времени из расписания. Его видно справа от строки с датой и в окне таймера (⇧⌘R)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den räknar av sig själv utifrån tiderna i ditt schema. Du ser den till höger om datumraden och i timerfönstret (⇧⌘R)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับเองตามเวลาในตารางของคุณ จะเห็นได้ทางขวาของแถววันที่ และในหน้าต่างตัวจับเวลา (⇧⌘R)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programınızdaki saatlere göre kendiliğinden sayar. Tarih satırının sağında ve zamanlayıcı penceresinde (⇧⌘R) görürsünüz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự đếm theo giờ trong lịch của bạn. Bạn sẽ thấy nó ở bên phải hàng ngày tháng và trong cửa sổ bộ hẹn giờ (⇧⌘R)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会按照日程上的时间自动计时。可在日期行右侧和计时器窗口（⇧⌘R）中查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會依照行程上的時間自動計時。可在日期列右側與計時器視窗（⇧⌘R）中查看。"
          }
        }
      }
    },
    "입력하고 Enter ↵ 로 계속 추가" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pište a klávesou Enter ↵ přidávejte další"
          }
        },
        "da" : {
