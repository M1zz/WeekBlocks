        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас они равномерно распределены по активной части дня (07:30–19:30). Измените их — и они станут стандартом для всех дней."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jsou rovnoměrně rozložená přes aktivní část dne (07:30–19:30). Když je změníte, stanou se výchozími pro každý den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De er fordelt jævnt over den aktive del af dagen (07.30–19.30). Ændrer du dem, bliver de standard for hver dag."
