    "승인을 기다리는 중입니다. 승인되면 앱이 알아서 열립니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čeká se na schválení. Aplikace se odemkne sama, jakmile schválení dorazí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på godkendelse. Appen låses op af sig selv, når den kommer igennem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte auf Freigabe. Die App wird automatisch freigeschaltet, sobald sie erteilt ist."
          }
        },
        "el" : {
