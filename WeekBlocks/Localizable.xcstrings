    "잠·끼니·일처럼 뺄 수 없는 시간을 먼저 깔면, 남는 자리가 이번 주에 실제로 쓸 수 있는 시간이 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív rozložte hodiny, které si vzít nedáte – spánek, jídla, práci – a co zbude, je čas, který tento týden opravdu můžete využít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg de timer ind, du ikke kan tage tilbage – søvn, måltider, arbejde – så er resten den tid, du faktisk kan bruge i denne uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg zuerst die Stunden fest, die du nicht hergeben kannst – Schlaf, Mahlzeiten, Arbeit –, und was übrig bleibt, ist die Zeit, die du diese Woche wirklich nutzen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε πρώτα τις ώρες που δεν μπορείς να πάρεις πίσω — ύπνο, γεύματα, δουλειά — και ό,τι μένει είναι ο χρόνος που πραγματικά έχεις αυτή την εβδομάδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lay down the hours you can't take back — sleep, meals, work — and what's left is the time you can actually use this week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca las horas que no puedes recuperar (sueño, comidas, trabajo) y lo que quede es el tiempo que de verdad puedes usar esta semana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta ensin tunnit, joita et saa takaisin – uni, ateriat, työ – niin jäljelle jää aika, jonka oikeasti voit käyttää tällä viikolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez d’abord les heures que vous ne pouvez pas céder (sommeil, repas, travail), et ce qui reste est le temps vraiment utilisable cette semaine."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan jam yang tidak bisa diganggu gugat — tidur, makan, kerja — dan sisanya adalah waktu yang benar-benar bisa Anda pakai minggu ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissa le ore che non puoi recuperare, come sonno, pasti e lavoro, e quello che resta è il tempo che puoi davvero usare questa settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠・食事・仕事のような外せない時間を先に置くと、残った分が今週本当に使える時間になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg inn timene du ikke kan ta tilbake – søvn, måltider, arbeid – så er resten tiden du faktisk kan bruke denne uken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg eerst de uren vast die je niet kunt missen — slaap, maaltijden, werk — en wat overblijft is de tijd die je deze week echt kunt gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozłóż godziny, których nie odzyskasz — sen, posiłki, pracę — a to, co zostanie, będzie czasem, którym naprawdę dysponujesz w tym tygodniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina as horas que não dá para abrir mão — sono, refeições, trabalho — e o que sobra é o tempo que você pode usar de verdade nesta semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разложите часы, которые не отнять, — сон, еду, работу, — и остаток станет временем, которым вы правда можете распорядиться на этой неделе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg ut timmarna du inte kan ta tillbaka – sömn, måltider, arbete – så är det som är kvar den tid du faktiskt kan använda den här veckan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางเวลาที่เอาคืนไม่ได้ — การนอน มื้ออาหาร งาน — ลงไปก่อน แล้วเวลาที่เหลือคือเวลาที่คุณใช้ได้จริงในสัปดาห์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce uyku, öğünler, iş gibi vazgeçemeyeceğiniz saatleri yerleştirin; geriye kalan, bu hafta gerçekten kullanabileceğiniz zamandır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt trước những giờ không thể bớt — ngủ, ăn, làm việc — và phần còn lại là thời gian bạn thật sự dùng được trong tuần này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先排好睡眠、吃饭、工作这些省不掉的时间，剩下的才是本周真正能用的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先排好睡眠、用餐、工作這些省不掉的時間，剩下的才是本週真正能用的時間。"
          }
        }
      }
    },
