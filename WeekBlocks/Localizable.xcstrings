    },
    "한 주 총량 · 고정 루틴 · 남은 자유 시간" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total hours · fixed routines · free time left"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一周总时长 · 固定作息 · 剩余自由时间"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一週總時數 · 固定作息 · 剩餘自由時間"
          }
        }
      }
    },
    "한 주는 168시간입니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A week is 168 hours"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
