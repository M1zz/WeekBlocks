    "시작부터 마감까지 무지개에 이어진 줄로 섭니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od začátku do termínu se v duze zobrazí jako souvislá čára."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vises som en sammenhængende linje i regnbuen fra start til deadline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheint im Regenbogen als durchgehende Linie vom Start bis zur Frist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζεται στο ουράνιο τόξο ως συνεχής γραμμή από την αρχή ως την προθεσμία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows in the rainbow as one continuous line from start to deadline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece en el arcoíris como una línea continua desde el inicio hasta la fecha límite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näkyy sateenkaaressa yhtenäisenä viivana alusta määräaikaan."
          }
