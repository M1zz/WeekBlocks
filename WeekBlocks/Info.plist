<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 캘린더를 왜 보는지 (→ CalendarImport.swift, CalendarExport.swift).
	     ⚠️ 일정을 **읽으려면** macOS 14부터 전체 접근이어야 한다. 쓰기 전용 권한으로는
	        읽어 올 수가 없다. 쓰는 것은 사람이 켰을 때 앱이 만든 캘린더 하나뿐이므로,
	        사람이 보는 이 문구에 그 경계를 분명히 적는다. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>맥 캘린더의 일정을 주간 계획으로 가져옵니다. 원하면 계획을 앱이 만든 ‘무지개 공방’ 캘린더에 적으며, 다른 캘린더는 고치지 않습니다.</string>
	<!-- 스포트라이트·파인더가 파일명 대신 lproj의 CFBundleDisplayName을 이름으로 쓰게 한다.
	     ⚠️ 앱스토어 업데이트는 설치된 자리에 덮어써서 폴더 이름이 안 바뀐다. 이 키가 없으면
	        예전 'WeekBlocks.app'으로 받은 사람은 '무지개 공방'·'Rainbow Craft'로 영영 못 찾는다. -->
	<key>LSHasLocalizedDisplayName</key>
	<true/>
	<key>CKSharingSupported</key>
	<true/>
</dict>
</plist>
