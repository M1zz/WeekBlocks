// Version.xcconfig
//
// **버전과 빌드 번호의 단일 소스.** DeployBar 가 배포할 때 이 파일을 고친다 (→ deploy.env).
//
// 예전에는 이 두 값이 WeekBlocks.project.yml 의 settings.base 에 있었다. 그러면 올릴 때마다
// 프로젝트 파일(또는 생성된 project.pbxproj)을 고쳐야 했고, 실제로 둘이 갈라졌다 —
// Xcode·DeployBar 가 pbxproj 를 19까지 올리는 동안 project.yml 은 17에 머물러, 다음
// `xcodegen generate` 가 빌드 번호를 조용히 17로 되돌릴 참이었다.
// 이 앱은 타겟이 둘(앱·공유 확장)이라 한 군데만 고치면 번들끼리 버전이 어긋나 업로드가 거절된다.
// 여기 한 파일만 고치면 둘이 함께 따라온다.
//
// ⚠️ **project.yml 의 settings.base 에 같은 키를 다시 넣지 말 것.** 프로젝트 빌드 설정은
//    xcconfig 보다 우선해서, 넣는 순간 이 파일이 조용히 무시된다.
//
// ⚠️ CURRENT_PROJECT_VERSION 은 **앱 하나 전체에서 하나뿐인 눈금이다. 올리기만 한다.**
//    마케팅 버전을 올렸다고 1부터 다시 세지 못한다 — 스토어는 마케팅 버전과 상관없이
//    '이 앱에 올라온 가장 큰 빌드 번호'만 본다. 같은 자리에서 두 번 거절당했다:
//      1.1.0(1)  → "must contain a higher version than [9]"
//      1.1.2(1)  → "must contain a higher version than [11]"  (2026-09-08)
//      1.1.6(21) → "must contain a higher version than [21]" (2026-09-24) — 21을 한 번 올려 둔 채 다시 올렸다

// 사람이 읽는 버전 (App Store 에 보이는 번호)
MARKETING_VERSION = 1.1.6

// 빌드 번호 — 업로드마다 올린다 (1.1.6(21) 업로드됨)
CURRENT_PROJECT_VERSION = 22
